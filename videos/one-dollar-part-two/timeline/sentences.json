[
 {
  "i": 0,
  "start": 0.4,
  "end": 2.447,
  "text": "Mia's thumb hovers over a green button."
 },
 {
  "i": 1,
  "start": 2.799,
  "end": 3.183,
  "text": "'Send.'"
 },
 {
  "i": 2,
  "start": 3.216,
  "end": 4.43,
  "text": "Eight thousand dollars."
 },
 {
  "i": 3,
  "start": 4.787,
  "end": 6.277,
  "text": "Every dollar she has left."
 },
 {
  "i": 4,
  "start": 6.624,
  "end": 8.151,
  "text": "A chat bubble pops up."
 },
 {
  "i": 5,
  "start": 8.494,
  "end": 9.663,
  "text": "Last chance, sweetie."
 },
 {
  "i": 6,
  "start": 10.022,
  "end": 11.164,
  "text": "Pay the release fee..."
 },
 {
  "i": 7,
  "start": 11.742,
  "end": 13.581,
  "text": "and your nine thousand is yours."
 },
 {
  "i": 8,
  "start": 13.932,
  "end": 16.461,
  "text": "Across town, your car is stuck at a red light."
 },
 {
  "i": 9,
  "start": 16.81,
  "end": 18.305,
  "text": "Your phone keeps ringing her."
 },
 {
  "i": 10,
  "start": 18.646,
  "end": 19.733,
  "text": "She isn't picking up."
 },
 {
  "i": 11,
  "start": 20.07,
  "end": 21.03,
  "text": "Ninety seconds."
 },
 {
  "i": 12,
  "start": 21.395,
  "end": 22.503,
  "text": "That's all you have."
 },
 {
  "i": 13,
  "start": 22.849,
  "end": 24.688,
  "text": "How did a girl with a glass jar..."
 },
 {
  "i": 14,
  "start": 25.266,
  "end": 26.063,
  "text": "end up here?"
 },
 {
  "i": 15,
  "start": 26.542,
  "end": 29.675,
  "text": "Three weeks earlier, a voice on the phone said your name."
 },
 {
  "i": 16,
  "start": 30.021,
  "end": 35.028,
  "text": "Last time, you turned one dollar a day into about one hundred thirty thousand."
 },
 {
  "i": 17,
  "start": 35.396,
  "end": 37.553,
  "text": "You saved your mom from a fake bank call."
 },
 {
  "i": 18,
  "start": 37.897,
  "end": 39.54,
  "text": "You blocked a man named Mr."
 },
 {
  "i": 19,
  "start": 39.569,
  "end": 39.902,
  "text": "Black."
 },
 {
  "i": 20,
  "start": 40.251,
  "end": 41.483,
  "text": "And he never forgot."
 },
 {
  "i": 21,
  "start": 41.84,
  "end": 42.382,
  "text": "Sam."
 },
 {
  "i": 22,
  "start": 42.749,
  "end": 44.75,
  "text": "You cost my team a lot of money."
 },
 {
  "i": 23,
  "start": 45.102,
  "end": 46.4,
  "text": "Then the line went dead."
 },
 {
  "i": 24,
  "start": 46.744,
  "end": 48.112,
  "text": "You're sixty-five now."
 },
 {
  "i": 25,
  "start": 48.458,
  "end": 49.925,
  "text": "Your mom is ninety-one."
 },
 {
  "i": 26,
  "start": 50.302,
  "end": 51.941,
  "text": "Max is still your best friend."
 },
 {
  "i": 27,
  "start": 52.294,
  "end": 53.912,
  "text": "And Max's granddaughter Mia..."
 },
 {
  "i": 28,
  "start": 54.492,
  "end": 55.629,
  "text": "just turned eighteen."
 },
 {
  "i": 29,
  "start": 55.99,
  "end": 58.708,
  "text": "On her birthday, Max hands her a glass jar."
 },
 {
  "i": 30,
  "start": 59.053,
  "end": 60.37,
  "text": "One dollar inside."
 },
 {
  "i": 31,
  "start": 60.734,
  "end": 62.108,
  "text": "Same rule as yours."
 },
 {
  "i": 32,
  "start": 62.465,
  "end": 63.217,
  "text": "One a day."
 },
 {
  "i": 33,
  "start": 63.564,
  "end": 64.329,
  "text": "Don't touch."
 },
 {
  "i": 34,
  "start": 64.683,
  "end": 66.062,
  "text": "Mia rolls her eyes."
 },
 {
  "i": 35,
  "start": 66.414,
  "end": 67.143,
  "text": "One dollar?"
 },
 {
  "i": 36,
  "start": 67.632,
  "end": 68.337,
  "text": "Grandpa."
 },
 {
  "i": 37,
  "start": 68.719,
  "end": 69.793,
  "text": "That buys nothing."
 },
 {
  "i": 38,
  "start": 70.153,
  "end": 71.366,
  "text": "You do the math for her."
 },
 {
  "i": 39,
  "start": 71.705,
  "end": 72.825,
  "text": "Start at eighteen."
 },
 {
  "i": 40,
  "start": 73.192,
  "end": 74.285,
  "text": "One dollar a day."
 },
 {
  "i": 41,
  "start": 74.629,
  "end": 75.868,
  "text": "Ten percent average."
 },
 {
  "i": 42,
  "start": 76.231,
  "end": 77.33,
  "text": "By sixty-five..."
 },
 {
  "i": 43,
  "start": 77.955,
  "end": 79.648,
  "text": "over three hundred thousand."
 },
 {
  "i": 44,
  "start": 80.014,
  "end": 80.523,
  "text": "Wait."
 },
 {
  "i": 45,
  "start": 80.887,
  "end": 82.274,
  "text": "Sam got one sixty."
 },
 {
  "i": 46,
  "start": 82.633,
  "end": 83.481,
  "text": "I get double?"
 },
 {
  "i": 47,
  "start": 83.969,
  "end": 84.726,
  "text": "You smile."
 },
 {
  "i": 48,
  "start": 85.086,
  "end": 86.594,
  "text": "Just seven extra years."
 },
 {
  "i": 49,
  "start": 86.949,
  "end": 88.736,
  "text": "Remember the rule of seventy-two?"
 },
 {
  "i": 50,
  "start": 89.239,
  "end": 90.15,
  "text": "Seven years..."
 },
 {
  "i": 51,
  "start": 90.745,
  "end": 91.918,
  "text": "is one more doubling."
 },
 {
  "i": 52,
  "start": 92.279,
  "end": 93.389,
  "text": "That's the whole trick."
 },
 {
  "i": 53,
  "start": 93.735,
  "end": 94.279,
  "text": "Time."
 },
 {
  "i": 54,
  "start": 94.646,
  "end": 96.0,
  "text": "But Mia has a problem."
 },
 {
  "i": 55,
  "start": 96.359,
  "end": 97.259,
  "text": "She's eighteen."
 },
 {
  "i": 56,
  "start": 97.626,
  "end": 99.936,
  "text": "And three hundred thousand at sixty-five..."
 },
 {
  "i": 57,
  "start": 100.543,
  "end": 101.679,
  "text": "feels like never."
 },
 {
  "i": 58,
  "start": 102.035,
  "end": 103.551,
  "text": "And the rule hasn't changed."
 },
 {
  "i": 59,
  "start": 103.907,
  "end": 105.407,
  "text": "Real money grows slowly."
 },
 {
  "i": 60,
  "start": 105.765,
  "end": 106.891,
  "text": "Painfully slowly."
 },
 {
  "i": 61,
  "start": 107.253,
  "end": 110.148,
  "text": "So what if someone promised you could skip the slow part?"
 },
 {
  "i": 62,
  "start": 110.621,
  "end": 111.351,
  "text": "Week one."
 },
 {
  "i": 63,
  "start": 111.701,
  "end": 113.027,
  "text": "Mia feeds the jar."
 },
 {
  "i": 64,
  "start": 113.375,
  "end": 114.824,
  "text": "Then she opens her phone."
 },
 {
  "i": 65,
  "start": 115.175,
  "end": 117.388,
  "text": "Everyone her age is posting gains."
 },
 {
  "i": 66,
  "start": 117.743,
  "end": 118.577,
  "text": "Screenshots."
 },
 {
  "i": 67,
  "start": 118.97,
  "end": 119.962,
  "text": "Green arrows."
 },
 {
  "i": 68,
  "start": 120.329,
  "end": 121.214,
  "text": "New cars."
 },
 {
  "i": 69,
  "start": 121.577,
  "end": 122.125,
  "text": "Fake?"
 },
 {
  "i": 70,
  "start": 122.623,
  "end": 123.211,
  "text": "Maybe."
 },
 {
  "i": 71,
  "start": 123.582,
  "end": 124.528,
  "text": "But at eighteen..."
 },
 {
  "i": 72,
  "start": 125.125,
  "end": 126.336,
  "text": "it doesn't feel fake."
 },
 {
  "i": 73,
  "start": 126.683,
  "end": 127.441,
  "text": "Week two."
 },
 {
  "i": 74,
  "start": 127.793,
  "end": 129.006,
  "text": "A message arrives."
 },
 {
  "i": 75,
  "start": 129.372,
  "end": 130.746,
  "text": "Oops, wrong number, sorry!"
 },
 {
  "i": 76,
  "start": 131.095,
  "end": 132.545,
  "text": "The profile says Jade."
 },
 {
  "i": 77,
  "start": 132.895,
  "end": 133.545,
  "text": "Friendly."
 },
 {
  "i": 78,
  "start": 133.921,
  "end": 134.441,
  "text": "Funny."
 },
 {
  "i": 79,
  "start": 134.806,
  "end": 135.959,
  "text": "Smart about money."
 },
 {
  "i": 80,
  "start": 136.314,
  "end": 137.556,
  "text": "They chat every day."
 },
 {
  "i": 81,
  "start": 137.9,
  "end": 139.63,
  "text": "Jade never asks for anything."
 },
 {
  "i": 82,
  "start": 139.995,
  "end": 140.758,
  "text": "Not yet."
 },
 {
  "i": 83,
  "start": 141.113,
  "end": 141.924,
  "text": "Week three."
 },
 {
  "i": 84,
  "start": 142.283,
  "end": 143.481,
  "text": "Jade shares a tip."
 },
 {
  "i": 85,
  "start": 143.826,
  "end": 144.764,
  "text": "A trading app."
 },
 {
  "i": 86,
  "start": 145.11,
  "end": 146.347,
  "text": "Three percent profit..."
 },
 {
  "i": 87,
  "start": 146.939,
  "end": 148.076,
  "text": "every single day."
 },
 {
  "i": 88,
  "start": 148.423,
  "end": 149.287,
  "text": "Mia shows you."
 },
 {
  "i": 89,
  "start": 149.63,
  "end": 150.789,
  "text": "You don't even blink."
 },
 {
  "i": 90,
  "start": 151.138,
  "end": 152.86,
  "text": "Three percent a day, for one year?"
 },
 {
  "i": 91,
  "start": 153.334,
  "end": 156.216,
  "text": "One dollar would turn into almost fifty thousand."
 },
 {
  "i": 92,
  "start": 156.58,
  "end": 157.615,
  "text": "In twelve months."
 },
 {
  "i": 93,
  "start": 157.972,
  "end": 159.253,
  "text": "If that really worked..."
 },
 {
  "i": 94,
  "start": 159.844,
  "end": 161.713,
  "text": "everyone on Earth would be rich."
 },
 {
  "i": 95,
  "start": 162.061,
  "end": 163.273,
  "text": "Is everyone rich?"
 },
 {
  "i": 96,
  "start": 163.756,
  "end": 164.64,
  "text": "Mia sighs."
 },
 {
  "i": 97,
  "start": 165.006,
  "end": 166.249,
  "text": "You're so old-school."
 },
 {
  "i": 98,
  "start": 166.623,
  "end": 167.905,
  "text": "Mia tries it anyway."
 },
 {
  "i": 99,
  "start": 168.263,
  "end": 169.505,
  "text": "Two hundred dollars."
 },
 {
  "i": 100,
  "start": 169.867,
  "end": 172.284,
  "text": "The next day, the app says two hundred six."
 },
 {
  "i": 101,
  "start": 172.626,
  "end": 173.923,
  "text": "She withdraws fifty."
 },
 {
  "i": 102,
  "start": 174.279,
  "end": 175.919,
  "text": "It actually lands in her bank."
 },
 {
  "i": 103,
  "start": 176.264,
  "end": 176.755,
  "text": "See?"
 },
 {
  "i": 104,
  "start": 177.247,
  "end": 178.009,
  "text": "It's real!"
 },
 {
  "i": 105,
  "start": 178.363,
  "end": 179.392,
  "text": "And that's the trick."
 },
 {
  "i": 106,
  "start": 179.738,
  "end": 181.762,
  "text": "The first withdrawal always works."
 },
 {
  "i": 107,
  "start": 182.115,
  "end": 183.101,
  "text": "It isn't profit."
 },
 {
  "i": 108,
  "start": 183.458,
  "end": 184.188,
  "text": "It's bait."
 },
 {
  "i": 109,
  "start": 184.54,
  "end": 185.239,
  "text": "Your money..."
 },
 {
  "i": 110,
  "start": 185.825,
  "end": 187.202,
  "text": "used to buy your trust."
 },
 {
  "i": 111,
  "start": 187.553,
  "end": 189.164,
  "text": "Scammers have a name for this."
 },
 {
  "i": 112,
  "start": 189.509,
  "end": 190.409,
  "text": "Pig butchering."
 },
 {
  "i": 113,
  "start": 190.784,
  "end": 191.443,
  "text": "First..."
 },
 {
  "i": 114,
  "start": 192.05,
  "end": 193.106,
  "text": "they fatten you up."
 },
 {
  "i": 115,
  "start": 193.443,
  "end": 194.332,
  "text": "With friendship."
 },
 {
  "i": 116,
  "start": 194.703,
  "end": 195.797,
  "text": "With small wins."
 },
 {
  "i": 117,
  "start": 196.149,
  "end": 196.704,
  "text": "Then..."
 },
 {
  "i": 118,
  "start": 197.302,
  "end": 198.089,
  "text": "Week four."
 },
 {
  "i": 119,
  "start": 198.445,
  "end": 200.041,
  "text": "Mia puts in two thousand."
 },
 {
  "i": 120,
  "start": 200.408,
  "end": 201.536,
  "text": "The screen climbs."
 },
 {
  "i": 121,
  "start": 201.894,
  "end": 202.819,
  "text": "Five thousand."
 },
 {
  "i": 122,
  "start": 203.189,
  "end": 203.776,
  "text": "Seven."
 },
 {
  "i": 123,
  "start": 204.147,
  "end": 204.686,
  "text": "Nine."
 },
 {
  "i": 124,
  "start": 205.053,
  "end": 206.422,
  "text": "Her jar on the shelf?"
 },
 {
  "i": 125,
  "start": 206.905,
  "end": 208.091,
  "text": "Thirty-one dollars."
 },
 {
  "i": 126,
  "start": 208.456,
  "end": 209.786,
  "text": "One is boring and real."
 },
 {
  "i": 127,
  "start": 210.132,
  "end": 211.244,
  "text": "One is exciting..."
 },
 {
  "i": 128,
  "start": 211.849,
  "end": 212.559,
  "text": "and fake."
 },
 {
  "i": 129,
  "start": 212.914,
  "end": 213.896,
  "text": "Max finds out."
 },
 {
  "i": 130,
  "start": 214.243,
  "end": 214.772,
  "text": "Mia!"
 },
 {
  "i": 131,
  "start": 215.138,
  "end": 216.328,
  "text": "That's your car money!"
 },
 {
  "i": 132,
  "start": 216.677,
  "end": 218.119,
  "text": "Grandpa, look at the number!"
 },
 {
  "i": 133,
  "start": 218.47,
  "end": 219.655,
  "text": "You say it quietly."
 },
 {
  "i": 134,
  "start": 220.016,
  "end": 221.836,
  "text": "A number on a screen isn't money."
 },
 {
  "i": 135,
  "start": 222.185,
  "end": 223.903,
  "text": "Money is what you can take out."
 },
 {
  "i": 136,
  "start": 224.244,
  "end": 224.933,
  "text": "The catch?"
 },
 {
  "i": 137,
  "start": 225.418,
  "end": 226.588,
  "text": "She can't take it out."
 },
 {
  "i": 138,
  "start": 226.928,
  "end": 227.891,
  "text": "A new message."
 },
 {
  "i": 139,
  "start": 228.256,
  "end": 229.252,
  "text": "'Account flagged."
 },
 {
  "i": 140,
  "start": 229.613,
  "end": 233.871,
  "text": "Pay an eight thousand dollar security deposit to release funds.'"
 },
 {
  "i": 141,
  "start": 233.912,
  "end": 236.674,
  "text": "Real firms don't hold your money hostage."
 },
 {
  "i": 142,
  "start": 237.04,
  "end": 237.788,
  "text": "They just..."
 },
 {
  "i": 143,
  "start": 238.376,
  "end": 239.224,
  "text": "give it back."
 },
 {
  "i": 144,
  "start": 239.573,
  "end": 241.449,
  "text": "And there's a cost to knowing all this."
 },
 {
  "i": 145,
  "start": 241.791,
  "end": 243.723,
  "text": "You can see the trap from a mile away."
 },
 {
  "i": 146,
  "start": 244.066,
  "end": 245.347,
  "text": "But seeing isn't enough."
 },
 {
  "i": 147,
  "start": 245.7,
  "end": 247.286,
  "text": "Every time you warn Mia..."
 },
 {
  "i": 148,
  "start": 247.868,
  "end": 249.219,
  "text": "she pulls further away."
 },
 {
  "i": 149,
  "start": 249.566,
  "end": 252.677,
  "text": "You sound like every boring adult she's ever ignored."
 },
 {
  "i": 150,
  "start": 253.037,
  "end": 254.332,
  "text": "Scammers count on that."
 },
 {
  "i": 151,
  "start": 254.678,
  "end": 256.738,
  "text": "Their best weapon isn't the fake app."
 },
 {
  "i": 152,
  "start": 257.08,
  "end": 257.799,
  "text": "It's shame."
 },
 {
  "i": 153,
  "start": 258.153,
  "end": 259.526,
  "text": "People who feel foolish..."
 },
 {
  "i": 154,
  "start": 260.119,
  "end": 260.954,
  "text": "stay quiet."
 },
 {
  "i": 155,
  "start": 261.314,
  "end": 262.42,
  "text": "And quiet people..."
 },
 {
  "i": 156,
  "start": 263.015,
  "end": 263.784,
  "text": "send more."
 },
 {
  "i": 157,
  "start": 264.139,
  "end": 265.66,
  "text": "You can't force her to listen."
 },
 {
  "i": 158,
  "start": 266.01,
  "end": 267.398,
  "text": "You can only make sure..."
 },
 {
  "i": 159,
  "start": 267.981,
  "end": 269.95,
  "text": "she's never too embarrassed to call you."
 },
 {
  "i": 160,
  "start": 270.29,
  "end": 271.921,
  "text": "And that's where your mom comes in."
 },
 {
  "i": 161,
  "start": 272.256,
  "end": 275.548,
  "text": "After her fake bank call, she made a new family rule."
 },
 {
  "i": 162,
  "start": 275.897,
  "end": 276.797,
  "text": "A code word."
 },
 {
  "i": 163,
  "start": 277.15,
  "end": 279.172,
  "text": "Something a stranger could never guess."
 },
 {
  "i": 164,
  "start": 279.521,
  "end": 280.094,
  "text": "Hers?"
 },
 {
  "i": 165,
  "start": 280.594,
  "end": 281.331,
  "text": "Pancakes."
 },
 {
  "i": 166,
  "start": 281.715,
  "end": 285.227,
  "text": "Because every Sunday, for sixty years, she's made pancakes."
 },
 {
  "i": 167,
  "start": 285.592,
  "end": 286.818,
  "text": "Even at ninety-one."
 },
 {
  "i": 168,
  "start": 287.196,
  "end": 288.425,
  "text": "Her hands shake now."
 },
 {
  "i": 169,
  "start": 288.769,
  "end": 290.58,
  "text": "Still the best pancakes in the city."
 },
 {
  "i": 170,
  "start": 290.924,
  "end": 292.593,
  "text": "Mia comes every Sunday too."
 },
 {
  "i": 171,
  "start": 292.938,
  "end": 296.091,
  "text": "And every Sunday, your mom asks her the old question."
 },
 {
  "i": 172,
  "start": 296.455,
  "end": 297.765,
  "text": "Still feeding the jar?"
 },
 {
  "i": 173,
  "start": 298.238,
  "end": 299.577,
  "text": "Still feeding the jar."
 },
 {
  "i": 174,
  "start": 299.921,
  "end": 300.96,
  "text": "Your mom winks."
 },
 {
  "i": 175,
  "start": 301.316,
  "end": 302.112,
  "text": "And the word?"
 },
 {
  "i": 176,
  "start": 302.589,
  "end": 303.51,
  "text": "Mia groans."
 },
 {
  "i": 177,
  "start": 303.88,
  "end": 305.051,
  "text": "Pancakes, Grandma."
 },
 {
  "i": 178,
  "start": 305.417,
  "end": 307.458,
  "text": "Then, Sunday night, your phone rings."
 },
 {
  "i": 179,
  "start": 307.808,
  "end": 308.512,
  "text": "It's Mia."
 },
 {
  "i": 180,
  "start": 308.861,
  "end": 309.472,
  "text": "Crying."
 },
 {
  "i": 181,
  "start": 309.846,
  "end": 310.852,
  "text": "Grandpa Sam..."
 },
 {
  "i": 182,
  "start": 311.441,
  "end": 312.319,
  "text": "I'm in trouble."
 },
 {
  "i": 183,
  "start": 312.678,
  "end": 313.562,
  "text": "I need money."
 },
 {
  "i": 184,
  "start": 313.917,
  "end": 314.67,
  "text": "Right now."
 },
 {
  "i": 185,
  "start": 315.019,
  "end": 316.347,
  "text": "Please don't tell anyone."
 },
 {
  "i": 186,
  "start": 316.7,
  "end": 317.81,
  "text": "Your heart drops."
 },
 {
  "i": 187,
  "start": 318.165,
  "end": 319.598,
  "text": "Then something feels off."
 },
 {
  "i": 188,
  "start": 319.942,
  "end": 321.898,
  "text": "Mia never calls you Grandpa Sam."
 },
 {
  "i": 189,
  "start": 322.242,
  "end": 323.554,
  "text": "You ask one question."
 },
 {
  "i": 190,
  "start": 323.919,
  "end": 324.844,
  "text": "What's the word?"
 },
 {
  "i": 191,
  "start": 325.32,
  "end": 325.992,
  "text": "Silence."
 },
 {
  "i": 192,
  "start": 326.371,
  "end": 327.141,
  "text": "What word?"
 },
 {
  "i": 193,
  "start": 327.626,
  "end": 328.791,
  "text": "Just send it, please!"
 },
 {
  "i": 194,
  "start": 329.145,
  "end": 330.363,
  "text": "The line goes dead."
 },
 {
  "i": 195,
  "start": 330.712,
  "end": 331.648,
  "text": "It wasn't Mia."
 },
 {
  "i": 196,
  "start": 331.993,
  "end": 333.6,
  "text": "It was a copy of her voice."
 },
 {
  "i": 197,
  "start": 333.95,
  "end": 335.089,
  "text": "Built by a machine..."
 },
 {
  "i": 198,
  "start": 335.683,
  "end": 337.375,
  "text": "from a few seconds of her videos."
 },
 {
  "i": 199,
  "start": 337.726,
  "end": 338.844,
  "text": "Which means Mr."
 },
 {
  "i": 200,
  "start": 338.878,
  "end": 340.847,
  "text": "Black knows exactly who she is."
 },
 {
  "i": 201,
  "start": 341.188,
  "end": 342.456,
  "text": "You call the real Mia."
 },
 {
  "i": 202,
  "start": 342.798,
  "end": 343.587,
  "text": "No answer."
 },
 {
  "i": 203,
  "start": 343.953,
  "end": 344.957,
  "text": "You call Max."
 },
 {
  "i": 204,
  "start": 345.306,
  "end": 346.813,
  "text": "She's in her room, he says."
 },
 {
  "i": 205,
  "start": 347.158,
  "end": 349.541,
  "text": "Said she's paying something to unlock her money."
 },
 {
  "i": 206,
  "start": 349.888,
  "end": 351.099,
  "text": "You grab your keys."
 },
 {
  "i": 207,
  "start": 351.448,
  "end": 352.686,
  "text": "Eight thousand dollars."
 },
 {
  "i": 208,
  "start": 353.043,
  "end": 354.364,
  "text": "Everything she has left."
 },
 {
  "i": 209,
  "start": 354.71,
  "end": 355.694,
  "text": "If she sends it..."
 },
 {
  "i": 210,
  "start": 356.268,
  "end": 357.34,
  "text": "it's not paused."
 },
 {
  "i": 211,
  "start": 357.7,
  "end": 358.414,
  "text": "It's gone."
 },
 {
  "i": 212,
  "start": 358.766,
  "end": 359.506,
  "text": "Red light."
 },
 {
  "i": 213,
  "start": 359.865,
  "end": 361.035,
  "text": "Your phone buzzes."
 },
 {
  "i": 214,
  "start": 361.394,
  "end": 362.095,
  "text": "A text."
 },
 {
  "i": 215,
  "start": 362.456,
  "end": 363.091,
  "text": "From Mr."
 },
 {
  "i": 216,
  "start": 363.121,
  "end": 363.47,
  "text": "Black."
 },
 {
  "i": 217,
  "start": 363.821,
  "end": 365.791,
  "text": "Send me twenty thousand, old man."
 },
 {
  "i": 218,
  "start": 366.135,
  "end": 367.531,
  "text": "And I'll leave the girl alone."
 },
 {
  "i": 219,
  "start": 367.876,
  "end": 368.867,
  "text": "You have the money."
 },
 {
  "i": 220,
  "start": 369.214,
  "end": 370.048,
  "text": "You could pay."
 },
 {
  "i": 221,
  "start": 370.39,
  "end": 371.807,
  "text": "Make it all stop tonight."
 },
 {
  "i": 222,
  "start": 372.165,
  "end": 373.457,
  "text": "Or you could walk in there..."
 },
 {
  "i": 223,
  "start": 374.036,
  "end": 376.159,
  "text": "and tell her the whole embarrassing truth."
 },
 {
  "i": 224,
  "start": 376.507,
  "end": 377.364,
  "text": "Pay him off..."
 },
 {
  "i": 225,
  "start": 377.946,
  "end": 379.153,
  "text": "or tell her the truth."
 },
 {
  "i": 226,
  "start": 379.501,
  "end": 380.308,
  "text": "You don't pay."
 },
 {
  "i": 227,
  "start": 380.65,
  "end": 381.597,
  "text": "You never pay."
 },
 {
  "i": 228,
  "start": 381.943,
  "end": 384.196,
  "text": "Paying a scammer just proves you'll pay again."
 },
 {
  "i": 229,
  "start": 384.543,
  "end": 386.191,
  "text": "You burst through Max's door."
 },
 {
  "i": 230,
  "start": 386.538,
  "end": 388.122,
  "text": "Mia's thumb is on the button."
 },
 {
  "i": 231,
  "start": 388.474,
  "end": 389.679,
  "text": "You don't grab the phone."
 },
 {
  "i": 232,
  "start": 390.025,
  "end": 390.964,
  "text": "You sit down."
 },
 {
  "i": 233,
  "start": 391.316,
  "end": 392.723,
  "text": "And you tell her everything."
 },
 {
  "i": 234,
  "start": 393.088,
  "end": 393.799,
  "text": "Your mom."
 },
 {
  "i": 235,
  "start": 394.149,
  "end": 395.078,
  "text": "The fake bank."
 },
 {
  "i": 236,
  "start": 395.428,
  "end": 397.564,
  "text": "How she cried, I'm so stupid, Sam."
 },
 {
  "i": 237,
  "start": 397.909,
  "end": 399.206,
  "text": "Mia's eyes fill up."
 },
 {
  "i": 238,
  "start": 399.548,
  "end": 400.609,
  "text": "I'm so stupid."
 },
 {
  "i": 239,
  "start": 400.973,
  "end": 402.026,
  "text": "You're not stupid."
 },
 {
  "i": 240,
  "start": 402.381,
  "end": 403.652,
  "text": "They do this for a living."
 },
 {
  "i": 241,
  "start": 404.0,
  "end": 405.542,
  "text": "Then you show her one test."
 },
 {
  "i": 242,
  "start": 405.888,
  "end": 408.18,
  "text": "Real investment firms are registered."
 },
 {
  "i": 243,
  "start": 408.557,
  "end": 409.874,
  "text": "You can check in minutes."
 },
 {
  "i": 244,
  "start": 410.229,
  "end": 411.671,
  "text": "She searches the app's name."
 },
 {
  "i": 245,
  "start": 412.015,
  "end": 412.616,
  "text": "Nothing."
 },
 {
  "i": 246,
  "start": 412.988,
  "end": 414.784,
  "text": "She asks Jade for a video call."
 },
 {
  "i": 247,
  "start": 415.13,
  "end": 416.325,
  "text": "Jade goes silent."
 },
 {
  "i": 248,
  "start": 416.688,
  "end": 417.301,
  "text": "Forever."
 },
 {
  "i": 249,
  "start": 417.674,
  "end": 419.1,
  "text": "Mia puts the phone down."
 },
 {
  "i": 250,
  "start": 419.447,
  "end": 420.839,
  "text": "The eight thousand stays."
 },
 {
  "i": 251,
  "start": 421.19,
  "end": 422.261,
  "text": "The two thousand..."
 },
 {
  "i": 252,
  "start": 422.861,
  "end": 423.558,
  "text": "is gone."
 },
 {
  "i": 253,
  "start": 423.916,
  "end": 424.987,
  "text": "That part hurts."
 },
 {
  "i": 254,
  "start": 425.342,
  "end": 426.122,
  "text": "And it should."
 },
 {
  "i": 255,
  "start": 426.474,
  "end": 427.701,
  "text": "You report everything."
 },
 {
  "i": 256,
  "start": 428.072,
  "end": 428.714,
  "text": "The app."
 },
 {
  "i": 257,
  "start": 429.064,
  "end": 429.824,
  "text": "The chats."
 },
 {
  "i": 258,
  "start": 430.183,
  "end": 431.23,
  "text": "The cloned call."
 },
 {
  "i": 259,
  "start": 431.58,
  "end": 433.359,
  "text": "Months later, it's on the news."
 },
 {
  "i": 260,
  "start": 433.706,
  "end": 435.084,
  "text": "A scam ring shut down."
 },
 {
  "i": 261,
  "start": 435.432,
  "end": 437.394,
  "text": "Your report was one of the pieces."
 },
 {
  "i": 262,
  "start": 437.748,
  "end": 438.12,
  "text": "Mr."
 },
 {
  "i": 263,
  "start": 438.153,
  "end": 439.237,
  "text": "Black's real name?"
 },
 {
  "i": 264,
  "start": 439.716,
  "end": 440.708,
  "text": "Something boring."
 },
 {
  "i": 265,
  "start": 441.065,
  "end": 442.053,
  "text": "They always are."
 },
 {
  "i": 266,
  "start": 442.397,
  "end": 444.076,
  "text": "Then you open your own account."
 },
 {
  "i": 267,
  "start": 444.433,
  "end": 445.184,
  "text": "One a day."
 },
 {
  "i": 268,
  "start": 445.531,
  "end": 446.296,
  "text": "Don't touch."
 },
 {
  "i": 269,
  "start": 446.65,
  "end": 448.305,
  "text": "Unless it's for someone you love."
 },
 {
  "i": 270,
  "start": 448.648,
  "end": 450.838,
  "text": "You set up one automatic transfer."
 },
 {
  "i": 271,
  "start": 451.206,
  "end": 452.338,
  "text": "One dollar a day..."
 },
 {
  "i": 272,
  "start": 452.919,
  "end": 454.173,
  "text": "into Mia's account."
 },
 {
  "i": 273,
  "start": 454.538,
  "end": 455.552,
  "text": "Matching hers."
 },
 {
  "i": 274,
  "start": 455.907,
  "end": 456.52,
  "text": "Forever."
 },
 {
  "i": 275,
  "start": 456.893,
  "end": 459.626,
  "text": "Two dollars a day, from eighteen to sixty-five?"
 },
 {
  "i": 276,
  "start": 460.128,
  "end": 461.745,
  "text": "Over six hundred thousand."
 },
 {
  "i": 277,
  "start": 462.112,
  "end": 463.382,
  "text": "Mia hugs you hard."
 },
 {
  "i": 278,
  "start": 463.734,
  "end": 464.597,
  "text": "No shortcut?"
 },
 {
  "i": 279,
  "start": 465.1,
  "end": 465.942,
  "text": "No shortcut."
 },
 {
  "i": 280,
  "start": 466.314,
  "end": 467.098,
  "text": "Just time."
 },
 {
  "i": 281,
  "start": 467.454,
  "end": 469.796,
  "text": "That Sunday, your mom flips a pancake."
 },
 {
  "i": 282,
  "start": 470.158,
  "end": 471.467,
  "text": "Still feeding the jar?"
 },
 {
  "i": 283,
  "start": 471.941,
  "end": 472.825,
  "text": "Mia grins."
 },
 {
  "i": 284,
  "start": 473.191,
  "end": 474.038,
  "text": "Both of them."
 },
 {
  "i": 285,
  "start": 474.386,
  "end": 474.954,
  "text": "So..."
 },
 {
  "i": 286,
  "start": 475.554,
  "end": 476.742,
  "text": "is any of this real?"
 },
 {
  "i": 287,
  "start": 477.218,
  "end": 478.158,
  "text": "Sadly, yes."
 },
 {
  "i": 288,
  "start": 478.511,
  "end": 484.712,
  "text": "In 2024, Americans reported losing more than twelve and a half billion dollars to fraud."
 },
 {
  "i": 289,
  "start": 485.066,
  "end": 486.15,
  "text": "The biggest slice?"
 },
 {
  "i": 290,
  "start": 486.632,
  "end": 487.799,
  "text": "Investment scams."
 },
 {
  "i": 291,
  "start": 488.158,
  "end": 489.598,
  "text": "Five point seven billion."
 },
 {
  "i": 292,
  "start": 489.957,
  "end": 492.268,
  "text": "And that only counts the people who reported it."
 },
 {
  "i": 293,
  "start": 492.604,
  "end": 496.417,
  "text": "Pig butchering is a real name for these slow, friendly scams."
 },
 {
  "i": 294,
  "start": 496.77,
  "end": 498.34,
  "text": "Voice cloning is real too."
 },
 {
  "i": 295,
  "start": 498.684,
  "end": 503.316,
  "text": "That's why the FBI tells families to agree on a secret word or phrase."
 },
 {
  "i": 296,
  "start": 503.676,
  "end": 506.191,
  "text": "And fake returns are older than the internet."
 },
 {
  "i": 297,
  "start": 506.553,
  "end": 512.557,
  "text": "In 1920, Charles Ponzi promised investors fifty percent in forty-five days."
 },
 {
  "i": 298,
  "start": 512.911,
  "end": 514.297,
  "text": "It collapsed within months."
 },
 {
  "i": 299,
  "start": 514.649,
  "end": 517.666,
  "text": "Real markets have averaged around ten percent a year."
 },
 {
  "i": 300,
  "start": 518.013,
  "end": 519.392,
  "text": "Not three percent a day."
 },
 {
  "i": 301,
  "start": 519.734,
  "end": 521.602,
  "text": "So if the real secret is time..."
 },
 {
  "i": 302,
  "start": 522.186,
  "end": 524.215,
  "text": "why do we keep falling for shortcuts?"
 },
 {
  "i": 303,
  "start": 524.709,
  "end": 525.616,
  "text": "What do you think?"
 },
 {
  "i": 304,
  "start": 526.092,
  "end": 527.378,
  "text": "Tell us in the comments."
 },
 {
  "i": 305,
  "start": 527.736,
  "end": 529.554,
  "text": "Not your family's code word, though."
 },
 {
  "i": 306,
  "start": 529.905,
  "end": 530.662,
  "text": "Never that."
 },
 {
  "i": 307,
  "start": 531.013,
  "end": 533.324,
  "text": "Tell us which money What If we should do next."
 },
 {
  "i": 308,
  "start": 533.667,
  "end": 535.733,
  "text": "And if Mia's two-dollar jar got you..."
 },
 {
  "i": 309,
  "start": 536.312,
  "end": 538.713,
  "text": "hit like, and subscribe for more What Ifs."
 }
]