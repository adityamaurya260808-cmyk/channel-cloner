[
 {
  "i": 0,
  "start": 0.18,
  "end": 1.28,
  "text": "Three minds."
 },
 {
  "i": 1,
  "start": 1.52,
  "end": 2.9,
  "text": "One frozen second."
 },
 {
  "i": 2,
  "start": 3.15,
  "end": 4.19,
  "text": "And no way out."
 },
 {
  "i": 3,
  "start": 4.53,
  "end": 6.49,
  "text": "You’ve been trapped inside one second..."
 },
 {
  "i": 4,
  "start": 6.81,
  "end": 8.18,
  "text": "for nine hundred years."
 },
 {
  "i": 5,
  "start": 8.59,
  "end": 10.42,
  "text": "Nova’s voice is getting quieter."
 },
 {
  "i": 6,
  "start": 10.78,
  "end": 12.32,
  "text": "The other voice is getting louder."
 },
 {
  "i": 7,
  "start": 12.76,
  "end": 13.38,
  "text": "Stay."
 },
 {
  "i": 8,
  "start": 13.67,
  "end": 14.35,
  "text": "Both of you."
 },
 {
  "i": 9,
  "start": 14.64,
  "end": 16.7,
  "text": "There’s nothing out there worth breathing for."
 },
 {
  "i": 10,
  "start": 17.07,
  "end": 18.18,
  "text": "You try to breathe out."
 },
 {
  "i": 11,
  "start": 18.48,
  "end": 19.16,
  "text": "You can’t."
 },
 {
  "i": 12,
  "start": 19.5,
  "end": 21.43,
  "text": "Something is holding the second shut."
 },
 {
  "i": 13,
  "start": 21.86,
  "end": 22.47,
  "text": "Something..."
 },
 {
  "i": 14,
  "start": 22.95,
  "end": 23.72,
  "text": "very old."
 },
 {
  "i": 15,
  "start": 24.14,
  "end": 27.38,
  "text": "Ten days earlier, you heard his name for the first time."
 },
 {
  "i": 16,
  "start": 27.85,
  "end": 28.51,
  "text": "You’re Leo."
 },
 {
  "i": 17,
  "start": 28.96,
  "end": 31.82,
  "text": "Hold your breath, and one second becomes a year."
 },
 {
  "i": 18,
  "start": 32.32,
  "end": 33.55,
  "text": "Your mind runs free."
 },
 {
  "i": 19,
  "start": 33.97,
  "end": 35.16,
  "text": "Your body can’t move."
 },
 {
  "i": 20,
  "start": 35.56,
  "end": 37.57,
  "text": "You saved your grandpa with that year."
 },
 {
  "i": 21,
  "start": 38.01,
  "end": 41.27,
  "text": "Then you saved Nova, the only other person who has it."
 },
 {
  "i": 22,
  "start": 41.74,
  "end": 44.04,
  "text": "And then a cold voice spoke inside the year."
 },
 {
  "i": 23,
  "start": 44.35,
  "end": 45.51,
  "text": "His name is Sol."
 },
 {
  "i": 24,
  "start": 46.07,
  "end": 48.69,
  "text": "So what happens when one second feels like a year..."
 },
 {
  "i": 25,
  "start": 49.05,
  "end": 50.95,
  "text": "and someone wants it to last forever?"
 },
 {
  "i": 26,
  "start": 51.27,
  "end": 52.32,
  "text": "Sol is polite."
 },
 {
  "i": 27,
  "start": 52.64,
  "end": 53.18,
  "text": "Calm."
 },
 {
  "i": 28,
  "start": 53.53,
  "end": 54.07,
  "text": "Ancient."
 },
 {
  "i": 29,
  "start": 54.47,
  "end": 55.8,
  "text": "How long have you been in here?"
 },
 {
  "i": 30,
  "start": 56.24,
  "end": 57.87,
  "text": "About three thousand years."
 },
 {
  "i": 31,
  "start": 58.22,
  "end": 59.09,
  "text": "Three thousand?"
 },
 {
  "i": 32,
  "start": 59.47,
  "end": 62.62,
  "text": "Nova lived two hundred and thought that was forever."
 },
 {
  "i": 33,
  "start": 63.16,
  "end": 66.89,
  "text": "For Sol, one second now lasts a thousand years."
 },
 {
  "i": 34,
  "start": 67.39,
  "end": 70.42,
  "text": "Out there, he’s just a very still old man."
 },
 {
  "i": 35,
  "start": 70.89,
  "end": 74.89,
  "text": "A whole human life lasts roughly two and a half billion heartbeats."
 },
 {
  "i": 36,
  "start": 75.44,
  "end": 77.66,
  "text": "Sol has lived three thousand years..."
 },
 {
  "i": 37,
  "start": 78.05,
  "end": 79.42,
  "text": "and heard just three."
 },
 {
  "i": 38,
  "start": 79.82,
  "end": 81.67,
  "text": "Plus: he knows everything."
 },
 {
  "i": 39,
  "start": 82.18,
  "end": 85.41,
  "text": "Every language he ever heard, he rebuilt in his head."
 },
 {
  "i": 40,
  "start": 85.86,
  "end": 87.0,
  "text": "Every maths problem."
 },
 {
  "i": 41,
  "start": 87.29,
  "end": 88.19,
  "text": "Every story."
 },
 {
  "i": 42,
  "start": 88.5,
  "end": 89.96,
  "text": "He beats Nova at chess..."
 },
 {
  "i": 43,
  "start": 90.26,
  "end": 91.35,
  "text": "in four moves."
 },
 {
  "i": 44,
  "start": 91.67,
  "end": 93.16,
  "text": "She doesn’t talk for a week."
 },
 {
  "i": 45,
  "start": 93.46,
  "end": 95.78,
  "text": "Minus: he knows something you don’t."
 },
 {
  "i": 46,
  "start": 96.13,
  "end": 97.81,
  "text": "Your power wasn’t growing, Leo."
 },
 {
  "i": 47,
  "start": 98.18,
  "end": 99.34,
  "text": "I was pulling you in."
 },
 {
  "i": 48,
  "start": 99.67,
  "end": 100.77,
  "text": "The slammed doors."
 },
 {
  "i": 49,
  "start": 101.19,
  "end": 102.13,
  "text": "The car horns."
 },
 {
  "i": 50,
  "start": 102.47,
  "end": 104.33,
  "text": "The years that came without asking."
 },
 {
  "i": 51,
  "start": 104.74,
  "end": 105.77,
  "text": "That was me."
 },
 {
  "i": 52,
  "start": 106.09,
  "end": 106.63,
  "text": "Why?"
 },
 {
  "i": 53,
  "start": 106.93,
  "end": 108.64,
  "text": "Because three thousand years..."
 },
 {
  "i": 54,
  "start": 109.2,
  "end": 110.98,
  "text": "is a very long time to be alone."
 },
 {
  "i": 55,
  "start": 111.43,
  "end": 112.03,
  "text": "The catch?"
 },
 {
  "i": 56,
  "start": 112.33,
  "end": 114.66,
  "text": "Sol only sees one frozen picture."
 },
 {
  "i": 57,
  "start": 115.0,
  "end": 116.08,
  "text": "Always the same."
 },
 {
  "i": 58,
  "start": 116.39,
  "end": 117.61,
  "text": "He won’t say what it is."
 },
 {
  "i": 59,
  "start": 117.98,
  "end": 119.46,
  "text": "Nova has her own picture."
 },
 {
  "i": 60,
  "start": 119.98,
  "end": 121.08,
  "text": "The evening sky."
 },
 {
  "i": 61,
  "start": 121.53,
  "end": 125.25,
  "text": "On a clear night, your eyes can see only a few thousand stars."
 },
 {
  "i": 62,
  "start": 125.66,
  "end": 128.93,
  "text": "She’s counted four thousand, one hundred and twelve."
 },
 {
  "i": 63,
  "start": 129.25,
  "end": 130.41,
  "text": "Almost all of them."
 },
 {
  "i": 64,
  "start": 130.64,
  "end": 132.69,
  "text": "But where it gets really frightening..."
 },
 {
  "i": 65,
  "start": 133.02,
  "end": 134.82,
  "text": "is how often it happens now."
 },
 {
  "i": 66,
  "start": 135.26,
  "end": 136.47,
  "text": "Ten times a day."
 },
 {
  "i": 67,
  "start": 136.82,
  "end": 138.06,
  "text": "Ten years a day."
 },
 {
  "i": 68,
  "start": 138.48,
  "end": 140.78,
  "text": "Jake waves a hand in front of your face."
 },
 {
  "i": 69,
  "start": 141.19,
  "end": 141.64,
  "text": "Mate."
 },
 {
  "i": 70,
  "start": 142.15,
  "end": 143.4,
  "text": "Where do you keep going?"
 },
 {
  "i": 71,
  "start": 143.79,
  "end": 145.17,
  "text": "Somewhere very quiet."
 },
 {
  "i": 72,
  "start": 145.56,
  "end": 146.56,
  "text": "And there’s a cost."
 },
 {
  "i": 73,
  "start": 146.96,
  "end": 147.65,
  "text": "The price?"
 },
 {
  "i": 74,
  "start": 148.11,
  "end": 149.06,
  "text": "You’re fifteen."
 },
 {
  "i": 75,
  "start": 149.46,
  "end": 152.71,
  "text": "But inside, you’ve now lived over a hundred years."
 },
 {
  "i": 76,
  "start": 153.29,
  "end": 155.44,
  "text": "You start forgetting small real things."
 },
 {
  "i": 77,
  "start": 155.87,
  "end": 156.84,
  "text": "Your locker code."
 },
 {
  "i": 78,
  "start": 157.18,
  "end": 158.35,
  "text": "Your mom’s birthday."
 },
 {
  "i": 79,
  "start": 158.86,
  "end": 163.43,
  "text": "Memories that aren’t used fade, and you have a century of thinking crowding them out."
 },
 {
  "i": 80,
  "start": 163.92,
  "end": 165.12,
  "text": "Your mom notices."
 },
 {
  "i": 81,
  "start": 165.63,
  "end": 166.16,
  "text": "Leo..."
 },
 {
  "i": 82,
  "start": 166.48,
  "end": 167.57,
  "text": "is everything okay?"
 },
 {
  "i": 83,
  "start": 168.02,
  "end": 168.77,
  "text": "You smile."
 },
 {
  "i": 84,
  "start": 169.17,
  "end": 170.02,
  "text": "You say yes."
 },
 {
  "i": 85,
  "start": 170.27,
  "end": 171.3,
  "text": "But you’re scared."
 },
 {
  "i": 86,
  "start": 171.74,
  "end": 173.71,
  "text": "Because you know exactly what you’re becoming."
 },
 {
  "i": 87,
  "start": 174.26,
  "end": 175.29,
  "text": "Someone like Sol."
 },
 {
  "i": 88,
  "start": 175.68,
  "end": 177.49,
  "text": "What if you can’t remember who you were?"
 },
 {
  "i": 89,
  "start": 177.93,
  "end": 179.64,
  "text": "So you go where it all started."
 },
 {
  "i": 90,
  "start": 180.02,
  "end": 181.14,
  "text": "Grandpa’s checkup."
 },
 {
  "i": 91,
  "start": 181.49,
  "end": 182.24,
  "text": "The hospital."
 },
 {
  "i": 92,
  "start": 182.59,
  "end": 183.88,
  "text": "Same long corridor."
 },
 {
  "i": 93,
  "start": 184.19,
  "end": 185.37,
  "text": "Same green door."
 },
 {
  "i": 94,
  "start": 185.69,
  "end": 189.64,
  "text": "Same vending machine, with one blue can stuck halfway down."
 },
 {
  "i": 95,
  "start": 190.12,
  "end": 193.13,
  "text": "It was stuck the day they brought me in, Grandpa says."
 },
 {
  "i": 96,
  "start": 193.72,
  "end": 196.38,
  "text": "Maybe it’s waiting for someone to give it a little push."
 },
 {
  "i": 97,
  "start": 196.88,
  "end": 197.93,
  "text": "He gives it a tap."
 },
 {
  "i": 98,
  "start": 198.25,
  "end": 199.19,
  "text": "It doesn’t move."
 },
 {
  "i": 99,
  "start": 199.56,
  "end": 200.58,
  "text": "Stubborn thing."
 },
 {
  "i": 100,
  "start": 200.99,
  "end": 201.73,
  "text": "Like you."
 },
 {
  "i": 101,
  "start": 202.26,
  "end": 206.47,
  "text": "On the bench by the green door, an old man sits perfectly still."
 },
 {
  "i": 102,
  "start": 206.86,
  "end": 207.78,
  "text": "Eyes closed."
 },
 {
  "i": 103,
  "start": 208.15,
  "end": 209.06,
  "text": "Hands folded."
 },
 {
  "i": 104,
  "start": 209.5,
  "end": 211.36,
  "text": "Grandpa squeezes your shoulder."
 },
 {
  "i": 105,
  "start": 211.74,
  "end": 213.03,
  "text": "You look tired, Leo."
 },
 {
  "i": 106,
  "start": 213.39,
  "end": 214.33,
  "text": "Whatever it is..."
 },
 {
  "i": 107,
  "start": 214.85,
  "end": 215.97,
  "text": "a second is plenty."
 },
 {
  "i": 108,
  "start": 216.34,
  "end": 217.26,
  "text": "If you use it."
 },
 {
  "i": 109,
  "start": 217.64,
  "end": 219.07,
  "text": "Nova came with you today."
 },
 {
  "i": 110,
  "start": 219.44,
  "end": 222.63,
  "text": "And as a doctor walks down the corridor toward the green door..."
 },
 {
  "i": 111,
  "start": 222.99,
  "end": 223.72,
  "text": "it happens."
 },
 {
  "i": 112,
  "start": 224.1,
  "end": 225.29,
  "text": "Your breath catches."
 },
 {
  "i": 113,
  "start": 225.62,
  "end": 226.67,
  "text": "So does Nova’s."
 },
 {
  "i": 114,
  "start": 227.04,
  "end": 228.18,
  "text": "The year begins."
 },
 {
  "i": 115,
  "start": 228.55,
  "end": 229.71,
  "text": "Then it keeps going."
 },
 {
  "i": 116,
  "start": 230.13,
  "end": 231.31,
  "text": "A hundred years."
 },
 {
  "i": 117,
  "start": 231.7,
  "end": 232.55,
  "text": "Five hundred."
 },
 {
  "i": 118,
  "start": 232.96,
  "end": 233.81,
  "text": "Nine hundred."
 },
 {
  "i": 119,
  "start": 234.17,
  "end": 236.22,
  "text": "Sol’s grip holds the second shut."
 },
 {
  "i": 120,
  "start": 236.62,
  "end": 237.23,
  "text": "Stay."
 },
 {
  "i": 121,
  "start": 237.79,
  "end": 240.8,
  "text": "The doctor is five steps from the old man on the bench."
 },
 {
  "i": 122,
  "start": 241.3,
  "end": 244.06,
  "text": "At a normal walk, that’s about three seconds."
 },
 {
  "i": 123,
  "start": 244.62,
  "end": 245.63,
  "text": "In Sol’s time..."
 },
 {
  "i": 124,
  "start": 245.98,
  "end": 247.34,
  "text": "three thousand years."
 },
 {
  "i": 125,
  "start": 247.82,
  "end": 249.8,
  "text": "Nova’s voice is barely there now."
 },
 {
  "i": 126,
  "start": 250.35,
  "end": 250.84,
  "text": "Leo..."
 },
 {
  "i": 127,
  "start": 251.31,
  "end": 252.94,
  "text": "I can’t feel the edges anymore."
 },
 {
  "i": 128,
  "start": 253.44,
  "end": 254.97,
  "text": "Then Sol speaks again."
 },
 {
  "i": 129,
  "start": 255.42,
  "end": 256.81,
  "text": "You can still leave, Leo."
 },
 {
  "i": 130,
  "start": 257.34,
  "end": 258.27,
  "text": "You’re strong enough."
 },
 {
  "i": 131,
  "start": 258.72,
  "end": 259.5,
  "text": "Breathe out."
 },
 {
  "i": 132,
  "start": 260.03,
  "end": 260.7,
  "text": "Go home."
 },
 {
  "i": 133,
  "start": 261.0,
  "end": 262.1,
  "text": "But she stays with me."
 },
 {
  "i": 134,
  "start": 262.66,
  "end": 263.39,
  "text": "You feel it."
 },
 {
  "i": 135,
  "start": 263.8,
  "end": 265.68,
  "text": "One breath, and you’re free."
 },
 {
  "i": 136,
  "start": 266.14,
  "end": 266.73,
  "text": "Your mom."
 },
 {
  "i": 137,
  "start": 267.22,
  "end": 267.83,
  "text": "Grandpa."
 },
 {
  "i": 138,
  "start": 268.31,
  "end": 269.18,
  "text": "Real seconds."
 },
 {
  "i": 139,
  "start": 269.65,
  "end": 270.94,
  "text": "But Nova would be gone..."
 },
 {
  "i": 140,
  "start": 271.38,
  "end": 271.94,
  "text": "forever."
 },
 {
  "i": 141,
  "start": 272.48,
  "end": 274.46,
  "text": "Can you carry two people out of a second?"
 },
 {
  "i": 142,
  "start": 274.86,
  "end": 275.41,
  "text": "Three?"
 },
 {
  "i": 143,
  "start": 275.9,
  "end": 276.81,
  "text": "Save yourself..."
 },
 {
  "i": 144,
  "start": 277.14,
  "end": 278.3,
  "text": "or save all three."
 },
 {
  "i": 145,
  "start": 278.7,
  "end": 280.6,
  "text": "You think about the old man on the bench."
 },
 {
  "i": 146,
  "start": 281.04,
  "end": 281.6,
  "text": "Still."
 },
 {
  "i": 147,
  "start": 282.0,
  "end": 282.87,
  "text": "Eyes closed."
 },
 {
  "i": 148,
  "start": 283.42,
  "end": 285.39,
  "text": "Every time someone walks toward him..."
 },
 {
  "i": 149,
  "start": 285.71,
  "end": 286.69,
  "text": "he disappears."
 },
 {
  "i": 150,
  "start": 287.08,
  "end": 287.59,
  "text": "Sol."
 },
 {
  "i": 151,
  "start": 287.92,
  "end": 289.4,
  "text": "What do you see in your picture?"
 },
 {
  "i": 152,
  "start": 289.78,
  "end": 290.5,
  "text": "Silence."
 },
 {
  "i": 153,
  "start": 290.88,
  "end": 291.79,
  "text": "A green door."
 },
 {
  "i": 154,
  "start": 292.17,
  "end": 293.16,
  "text": "A vending machine."
 },
 {
  "i": 155,
  "start": 293.53,
  "end": 294.56,
  "text": "One blue can..."
 },
 {
  "i": 156,
  "start": 294.97,
  "end": 295.51,
  "text": "stuck."
 },
 {
  "i": 157,
  "start": 295.95,
  "end": 296.64,
  "text": "It’s you."
 },
 {
  "i": 158,
  "start": 297.01,
  "end": 298.36,
  "text": "You’re the man on the bench."
 },
 {
  "i": 159,
  "start": 298.71,
  "end": 300.36,
  "text": "What’s behind that door, Sol?"
 },
 {
  "i": 160,
  "start": 300.84,
  "end": 301.81,
  "text": "A long pause."
 },
 {
  "i": 161,
  "start": 302.23,
  "end": 302.98,
  "text": "My wife."
 },
 {
  "i": 162,
  "start": 303.38,
  "end": 305.62,
  "text": "The doctor is coming to tell me if she woke up."
 },
 {
  "i": 163,
  "start": 306.18,
  "end": 307.79,
  "text": "I couldn’t bear to hear the answer."
 },
 {
  "i": 164,
  "start": 308.06,
  "end": 309.58,
  "text": "So you’ve been hiding from it."
 },
 {
  "i": 165,
  "start": 309.81,
  "end": 311.38,
  "text": "For three thousand years."
 },
 {
  "i": 166,
  "start": 311.71,
  "end": 312.77,
  "text": "You don’t fight him."
 },
 {
  "i": 167,
  "start": 313.14,
  "end": 314.02,
  "text": "You don’t push."
 },
 {
  "i": 168,
  "start": 314.39,
  "end": 315.8,
  "text": "You just tell him the truth."
 },
 {
  "i": 169,
  "start": 316.14,
  "end": 317.19,
  "text": "We’ll hear it with you."
 },
 {
  "i": 170,
  "start": 317.46,
  "end": 319.18,
  "text": "Then you hum Grandpa’s song."
 },
 {
  "i": 171,
  "start": 319.55,
  "end": 320.08,
  "text": "Boom."
 },
 {
  "i": 172,
  "start": 320.46,
  "end": 321.07,
  "text": "Boom."
 },
 {
  "i": 173,
  "start": 321.42,
  "end": 322.01,
  "text": "Boom."
 },
 {
  "i": 174,
  "start": 322.44,
  "end": 323.96,
  "text": "A second is plenty, Sol..."
 },
 {
  "i": 175,
  "start": 324.3,
  "end": 325.15,
  "text": "if you use it."
 },
 {
  "i": 176,
  "start": 325.72,
  "end": 329.56,
  "text": "And Nova, barely there, whispers the only thing she has left."
 },
 {
  "i": 177,
  "start": 329.97,
  "end": 330.48,
  "text": "Three."
 },
 {
  "i": 178,
  "start": 330.73,
  "end": 331.22,
  "text": "Two."
 },
 {
  "i": 179,
  "start": 331.54,
  "end": 332.05,
  "text": "One."
 },
 {
  "i": 180,
  "start": 332.57,
  "end": 333.98,
  "text": "All three of you breathe out."
 },
 {
  "i": 181,
  "start": 334.35,
  "end": 335.51,
  "text": "The corridor moves."
 },
 {
  "i": 182,
  "start": 335.88,
  "end": 336.97,
  "text": "The doctor smiles."
 },
 {
  "i": 183,
  "start": 337.24,
  "end": 338.0,
  "text": "She’s awake."
 },
 {
  "i": 184,
  "start": 338.44,
  "end": 339.56,
  "text": "She’s asking for you."
 },
 {
  "i": 185,
  "start": 339.91,
  "end": 341.55,
  "text": "The old man opens his eyes..."
 },
 {
  "i": 186,
  "start": 341.87,
  "end": 342.67,
  "text": "and cries."
 },
 {
  "i": 187,
  "start": 343.1,
  "end": 345.45,
  "text": "Grandpa gives the vending machine one more tap."
 },
 {
  "i": 188,
  "start": 345.87,
  "end": 347.05,
  "text": "The blue can drops."
 },
 {
  "i": 189,
  "start": 347.39,
  "end": 347.85,
  "text": "Clunk."
 },
 {
  "i": 190,
  "start": 348.47,
  "end": 350.61,
  "text": "After that, the years get shorter."
 },
 {
  "i": 191,
  "start": 351.02,
  "end": 351.59,
  "text": "A month."
 },
 {
  "i": 192,
  "start": 351.97,
  "end": 352.57,
  "text": "A day."
 },
 {
  "i": 193,
  "start": 352.85,
  "end": 353.41,
  "text": "An hour."
 },
 {
  "i": 194,
  "start": 353.87,
  "end": 360.44,
  "text": "Then one Sunday, Grandpa’s song plays, Sol dances with his wife, Nova dances with Jake..."
 },
 {
  "i": 195,
  "start": 360.83,
  "end": 362.0,
  "text": "and you notice something."
 },
 {
  "i": 196,
  "start": 362.48,
  "end": 363.17,
  "text": "A second..."
 },
 {
  "i": 197,
  "start": 363.57,
  "end": 364.76,
  "text": "feels like a second."
 },
 {
  "i": 198,
  "start": 365.13,
  "end": 365.82,
  "text": "Just one."
 },
 {
  "i": 199,
  "start": 366.22,
  "end": 366.85,
  "text": "Ordinary."
 },
 {
  "i": 200,
  "start": 367.19,
  "end": 367.82,
  "text": "Perfect."
 },
 {
  "i": 201,
  "start": 368.25,
  "end": 369.75,
  "text": "You don’t need a year anymore."
 },
 {
  "i": 202,
  "start": 370.08,
  "end": 371.06,
  "text": "Grandpa winks."
 },
 {
  "i": 203,
  "start": 371.48,
  "end": 372.1,
  "text": "Told you."
 },
 {
  "i": 204,
  "start": 372.61,
  "end": 373.77,
  "text": "A second is plenty."
 },
 {
  "i": 205,
  "start": 374.05,
  "end": 374.99,
  "text": "It always was."
 },
 {
  "i": 206,
  "start": 375.26,
  "end": 376.39,
  "text": "Is any of this real?"
 },
 {
  "i": 207,
  "start": 376.71,
  "end": 378.56,
  "text": "No one can live a year in a second."
 },
 {
  "i": 208,
  "start": 378.97,
  "end": 381.09,
  "text": "But your brain really does bend time."
 },
 {
  "i": 209,
  "start": 381.53,
  "end": 383.19,
  "text": "Waiting makes minutes drag."
 },
 {
  "i": 210,
  "start": 383.55,
  "end": 385.17,
  "text": "Fun makes hours vanish."
 },
 {
  "i": 211,
  "start": 385.44,
  "end": 391.2,
  "text": "And new experiences often feel longer when you look back, because your brain stores more detail about them."
 },
 {
  "i": 212,
  "start": 391.61,
  "end": 393.89,
  "text": "So the best way to make your life feel longer..."
 },
 {
  "i": 213,
  "start": 394.43,
  "end": 396.82,
  "text": "might be filling your seconds with new things."
 },
 {
  "i": 214,
  "start": 397.23,
  "end": 399.06,
  "text": "So which second would you stretch?"
 },
 {
  "i": 215,
  "start": 399.59,
  "end": 400.4,
  "text": "What do you think?"
 },
 {
  "i": 216,
  "start": 400.88,
  "end": 404.71,
  "text": "Tell us in the comments, and tell us which superpower we should do next."
 },
 {
  "i": 217,
  "start": 405.13,
  "end": 407.92,
  "text": "Hit like, and subscribe for more What Ifs."
 }
]