[
 {
  "i": 0,
  "start": 0.19,
  "end": 1.37,
  "text": "You open your eyes."
 },
 {
  "i": 1,
  "start": 1.8,
  "end": 4.07,
  "text": "The ceiling has glow-in-the-dark stars on it."
 },
 {
  "i": 2,
  "start": 4.5,
  "end": 5.94,
  "text": "You haven’t seen those stars..."
 },
 {
  "i": 3,
  "start": 6.23,
  "end": 7.35,
  "text": "in twenty years."
 },
 {
  "i": 4,
  "start": 7.75,
  "end": 9.63,
  "text": "Your feet don’t reach the end of the bed."
 },
 {
  "i": 5,
  "start": 10.01,
  "end": 11.13,
  "text": "Your hands are small."
 },
 {
  "i": 6,
  "start": 11.55,
  "end": 13.56,
  "text": "Your voice cracks when you say hello."
 },
 {
  "i": 7,
  "start": 13.95,
  "end": 15.64,
  "text": "Then a voice shouts from the kitchen."
 },
 {
  "i": 8,
  "start": 15.95,
  "end": 16.53,
  "text": "Eli!"
 },
 {
  "i": 9,
  "start": 16.85,
  "end": 17.64,
  "text": "Pancakes!"
 },
 {
  "i": 10,
  "start": 17.99,
  "end": 19.58,
  "text": "You’re going to be late for school!"
 },
 {
  "i": 11,
  "start": 20.09,
  "end": 20.65,
  "text": "School?"
 },
 {
  "i": 12,
  "start": 21.05,
  "end": 22.59,
  "text": "Yesterday you were thirty-two."
 },
 {
  "i": 13,
  "start": 22.91,
  "end": 26.5,
  "text": "You had a mortgage, a bad back, and a job you didn’t love."
 },
 {
  "i": 14,
  "start": 26.89,
  "end": 27.46,
  "text": "Today..."
 },
 {
  "i": 15,
  "start": 27.82,
  "end": 28.57,
  "text": "you’re twelve."
 },
 {
  "i": 16,
  "start": 29.02,
  "end": 30.4,
  "text": "And you remember everything."
 },
 {
  "i": 17,
  "start": 30.77,
  "end": 32.05,
  "text": "Every exam answer."
 },
 {
  "i": 18,
  "start": 32.36,
  "end": 33.27,
  "text": "Every mistake."
 },
 {
  "i": 19,
  "start": 33.6,
  "end": 35.0,
  "text": "Every person you lost..."
 },
 {
  "i": 20,
  "start": 35.2,
  "end": 36.06,
  "text": "along the way."
 },
 {
  "i": 21,
  "start": 36.43,
  "end": 40.23,
  "text": "Most people remember almost nothing from before age three or four."
 },
 {
  "i": 22,
  "start": 40.76,
  "end": 46.63,
  "text": "And by thirty, the memories of being twelve are blurry, rebuilt every time you recall them."
 },
 {
  "i": 23,
  "start": 47.16,
  "end": 47.57,
  "text": "You?"
 },
 {
  "i": 24,
  "start": 47.99,
  "end": 50.15,
  "text": "You have twenty extra years of memories..."
 },
 {
  "i": 25,
  "start": 50.51,
  "end": 51.92,
  "text": "in a twelve-year-old head."
 },
 {
  "i": 26,
  "start": 52.43,
  "end": 53.31,
  "text": "But there’s a rule."
 },
 {
  "i": 27,
  "start": 53.76,
  "end": 55.37,
  "text": "You find it on the first morning."
 },
 {
  "i": 28,
  "start": 55.79,
  "end": 58.85,
  "text": "You warn Mom that the bathroom pipe will burst on Saturday."
 },
 {
  "i": 29,
  "start": 59.28,
  "end": 60.02,
  "text": "She checks it."
 },
 {
  "i": 30,
  "start": 60.43,
  "end": 61.16,
  "text": "It’s cracked."
 },
 {
  "i": 31,
  "start": 61.62,
  "end": 62.57,
  "text": "She fixes it."
 },
 {
  "i": 32,
  "start": 62.94,
  "end": 63.79,
  "text": "And that night..."
 },
 {
  "i": 33,
  "start": 64.05,
  "end": 66.56,
  "text": "you can’t remember the color of your first car."
 },
 {
  "i": 34,
  "start": 67.0,
  "end": 71.01,
  "text": "Every time you change something, the memory it replaced disappears."
 },
 {
  "i": 35,
  "start": 71.45,
  "end": 74.43,
  "text": "Change something small, lose something small."
 },
 {
  "i": 36,
  "start": 74.85,
  "end": 76.04,
  "text": "Change something big..."
 },
 {
  "i": 37,
  "start": 76.31,
  "end": 78.04,
  "text": "and your whole future could vanish."
 },
 {
  "i": 38,
  "start": 78.5,
  "end": 81.33,
  "text": "So what if you woke up at twelve with all your memories?"
 },
 {
  "i": 39,
  "start": 81.67,
  "end": 83.68,
  "text": "Plus: school becomes very easy."
 },
 {
  "i": 40,
  "start": 83.98,
  "end": 85.0,
  "text": "You’ve done algebra."
 },
 {
  "i": 41,
  "start": 85.28,
  "end": 86.28,
  "text": "You’ve done taxes."
 },
 {
  "i": 42,
  "start": 86.58,
  "end": 87.35,
  "text": "Your teacher, Ms."
 },
 {
  "i": 43,
  "start": 87.35,
  "end": 89.18,
  "text": "Reyes, hands back your test."
 },
 {
  "i": 44,
  "start": 89.54,
  "end": 90.65,
  "text": "One hundred percent?"
 },
 {
  "i": 45,
  "start": 91.09,
  "end": 91.59,
  "text": "Eli..."
 },
 {
  "i": 46,
  "start": 91.8,
  "end": 92.59,
  "text": "did you study?"
 },
 {
  "i": 47,
  "start": 92.89,
  "end": 94.45,
  "text": "For about twenty years, yes."
 },
 {
  "i": 48,
  "start": 94.84,
  "end": 97.04,
  "text": "Minus: you forgot long division."
 },
 {
  "i": 49,
  "start": 97.38,
  "end": 98.13,
  "text": "Completely."
 },
 {
  "i": 50,
  "start": 98.44,
  "end": 100.86,
  "text": "Turns out adults just use a calculator."
 },
 {
  "i": 51,
  "start": 101.32,
  "end": 101.75,
  "text": "Money?"
 },
 {
  "i": 52,
  "start": 102.27,
  "end": 103.68,
  "text": "Everyone thinks you’d be rich."
 },
 {
  "i": 53,
  "start": 103.68,
  "end": 105.95,
  "text": "But you never memorized lottery numbers."
 },
 {
  "i": 54,
  "start": 106.23,
  "end": 106.89,
  "text": "Who does that?"
 },
 {
  "i": 55,
  "start": 107.4,
  "end": 109.03,
  "text": "What you do remember is maths."
 },
 {
  "i": 56,
  "start": 109.39,
  "end": 113.76,
  "text": "Save money that grows seven percent a year, and it roughly doubles every ten years."
 },
 {
  "i": 57,
  "start": 114.06,
  "end": 114.96,
  "text": "Start at twelve..."
 },
 {
  "i": 58,
  "start": 115.29,
  "end": 117.07,
  "text": "and your coins have decades to grow."
 },
 {
  "i": 59,
  "start": 117.59,
  "end": 119.06,
  "text": "So you open a savings jar."
 },
 {
  "i": 60,
  "start": 119.41,
  "end": 121.21,
  "text": "Mom is very confused."
 },
 {
  "i": 61,
  "start": 121.7,
  "end": 122.43,
  "text": "Languages?"
 },
 {
  "i": 62,
  "start": 122.83,
  "end": 125.7,
  "text": "Kids pick up accents far more easily than adults do."
 },
 {
  "i": 63,
  "start": 126.11,
  "end": 128.95,
  "text": "Your adult self spent three years failing Spanish."
 },
 {
  "i": 64,
  "start": 129.37,
  "end": 131.84,
  "text": "Your twelve-year-old mouth gets it in three months."
 },
 {
  "i": 65,
  "start": 132.29,
  "end": 134.9,
  "text": "Plus: you finally understand your parents."
 },
 {
  "i": 66,
  "start": 135.32,
  "end": 137.39,
  "text": "You see Mom checking the bills at midnight."
 },
 {
  "i": 67,
  "start": 137.77,
  "end": 139.44,
  "text": "So you quietly do the dishes."
 },
 {
  "i": 68,
  "start": 139.88,
  "end": 140.54,
  "text": "Every night."
 },
 {
  "i": 69,
  "start": 140.99,
  "end": 142.11,
  "text": "Mom stares at you."
 },
 {
  "i": 70,
  "start": 142.52,
  "end": 145.13,
  "text": "Who are you, and what have you done with my son?"
 },
 {
  "i": 71,
  "start": 145.55,
  "end": 146.98,
  "text": "Then the hard parts start."
 },
 {
  "i": 72,
  "start": 147.28,
  "end": 148.68,
  "text": "Bedtime is nine o’clock."
 },
 {
  "i": 73,
  "start": 149.04,
  "end": 150.3,
  "text": "You argue like a lawyer."
 },
 {
  "i": 74,
  "start": 150.76,
  "end": 154.04,
  "text": "But a twelve-year-old body needs about nine to twelve hours of sleep."
 },
 {
  "i": 75,
  "start": 154.47,
  "end": 155.3,
  "text": "You fall asleep..."
 },
 {
  "i": 76,
  "start": 155.7,
  "end": 157.13,
  "text": "in the middle of your own argument."
 },
 {
  "i": 77,
  "start": 157.52,
  "end": 158.31,
  "text": "And your feelings?"
 },
 {
  "i": 78,
  "start": 158.76,
  "end": 159.67,
  "text": "Out of control."
 },
 {
  "i": 79,
  "start": 160.22,
  "end": 164.89,
  "text": "The part of the brain that handles self-control keeps developing until your mid-twenties."
 },
 {
  "i": 80,
  "start": 165.37,
  "end": 166.3,
  "text": "Yours is twelve."
 },
 {
  "i": 81,
  "start": 166.78,
  "end": 167.7,
  "text": "So you know better..."
 },
 {
  "i": 82,
  "start": 168.16,
  "end": 170.37,
  "text": "and you still cry when you lose a video game."
 },
 {
  "i": 83,
  "start": 170.78,
  "end": 172.6,
  "text": "Your best friend Omar squints at you."
 },
 {
  "i": 84,
  "start": 172.96,
  "end": 173.57,
  "text": "Dude."
 },
 {
  "i": 85,
  "start": 174.04,
  "end": 175.79,
  "text": "You’ve been weird all week."
 },
 {
  "i": 86,
  "start": 176.12,
  "end": 177.91,
  "text": "But where it gets really strange..."
 },
 {
  "i": 87,
  "start": 178.28,
  "end": 179.63,
  "text": "is knowing what’s coming."
 },
 {
  "i": 88,
  "start": 180.17,
  "end": 181.68,
  "text": "You know which teacher will leave."
 },
 {
  "i": 89,
  "start": 181.92,
  "end": 184.2,
  "text": "You know which song will be huge next summer."
 },
 {
  "i": 90,
  "start": 184.57,
  "end": 187.01,
  "text": "You know Mom will change jobs in two years..."
 },
 {
  "i": 91,
  "start": 187.37,
  "end": 188.25,
  "text": "and be happier."
 },
 {
  "i": 92,
  "start": 188.66,
  "end": 190.23,
  "text": "You stay quiet about that one."
 },
 {
  "i": 93,
  "start": 190.62,
  "end": 192.04,
  "text": "It’s better as a surprise."
 },
 {
  "i": 94,
  "start": 192.43,
  "end": 195.25,
  "text": "Each time you fix something, another memory slips."
 },
 {
  "i": 95,
  "start": 195.64,
  "end": 197.47,
  "text": "So you stop fixing the small stuff."
 },
 {
  "i": 96,
  "start": 197.84,
  "end": 198.74,
  "text": "And there’s a cost."
 },
 {
  "i": 97,
  "start": 199.26,
  "end": 199.92,
  "text": "The price?"
 },
 {
  "i": 98,
  "start": 200.35,
  "end": 202.61,
  "text": "You’re lonely in a way nobody can see."
 },
 {
  "i": 99,
  "start": 203.09,
  "end": 204.14,
  "text": "You can’t tell anyone."
 },
 {
  "i": 100,
  "start": 204.57,
  "end": 205.49,
  "text": "Who would believe you?"
 },
 {
  "i": 101,
  "start": 205.89,
  "end": 207.67,
  "text": "Your friends talk about cartoons."
 },
 {
  "i": 102,
  "start": 208.01,
  "end": 209.36,
  "text": "You want to talk about rent."
 },
 {
  "i": 103,
  "start": 209.73,
  "end": 211.17,
  "text": "Your mind is thirty-two."
 },
 {
  "i": 104,
  "start": 211.54,
  "end": 212.69,
  "text": "Your life is twelve."
 },
 {
  "i": 105,
  "start": 213.01,
  "end": 215.87,
  "text": "And every small change you make steals another memory."
 },
 {
  "i": 106,
  "start": 216.39,
  "end": 217.45,
  "text": "Your first apartment."
 },
 {
  "i": 107,
  "start": 217.81,
  "end": 219.18,
  "text": "Your college roommate’s name."
 },
 {
  "i": 108,
  "start": 219.55,
  "end": 221.86,
  "text": "The taste of your favorite food from the future."
 },
 {
  "i": 109,
  "start": 222.4,
  "end": 223.35,
  "text": "You start to wonder..."
 },
 {
  "i": 110,
  "start": 223.83,
  "end": 225.85,
  "text": "how much of your old self will be left?"
 },
 {
  "i": 111,
  "start": 226.35,
  "end": 228.22,
  "text": "And there’s one thing you came back to fix."
 },
 {
  "i": 112,
  "start": 228.74,
  "end": 230.88,
  "text": "One day you’ve never forgiven yourself for."
 },
 {
  "i": 113,
  "start": 231.44,
  "end": 233.13,
  "text": "You whisper it to yourself every night."
 },
 {
  "i": 114,
  "start": 233.51,
  "end": 234.81,
  "text": "You didn’t come back to win."
 },
 {
  "i": 115,
  "start": 235.27,
  "end": 236.51,
  "text": "You came back to fix it."
 },
 {
  "i": 116,
  "start": 236.92,
  "end": 239.46,
  "text": "Omar has been your best friend since you were six."
 },
 {
  "i": 117,
  "start": 239.86,
  "end": 241.02,
  "text": "He laughs too loud."
 },
 {
  "i": 118,
  "start": 241.44,
  "end": 243.51,
  "text": "He shares his lunch whether you want it or not."
 },
 {
  "i": 119,
  "start": 243.86,
  "end": 245.51,
  "text": "And you two have a secret signal."
 },
 {
  "i": 120,
  "start": 245.89,
  "end": 247.11,
  "text": "Two taps on the desk..."
 },
 {
  "i": 121,
  "start": 247.42,
  "end": 248.36,
  "text": "then a thumbs-up."
 },
 {
  "i": 122,
  "start": 248.72,
  "end": 250.6,
  "text": "It means: I’ve got your back."
 },
 {
  "i": 123,
  "start": 251.05,
  "end": 252.49,
  "text": "Omar notices everything."
 },
 {
  "i": 124,
  "start": 252.87,
  "end": 254.62,
  "text": "You talk like my uncle now."
 },
 {
  "i": 125,
  "start": 255.06,
  "end": 256.15,
  "text": "Is that a bad thing?"
 },
 {
  "i": 126,
  "start": 256.54,
  "end": 257.16,
  "text": "Kind of."
 },
 {
  "i": 127,
  "start": 257.74,
  "end": 258.94,
  "text": "He sells insurance."
 },
 {
  "i": 128,
  "start": 259.24,
  "end": 262.48,
  "text": "In your old life, you stopped using the signal at twelve."
 },
 {
  "i": 129,
  "start": 262.88,
  "end": 265.52,
  "text": "Because last week, someone pulled the school fire alarm."
 },
 {
  "i": 130,
  "start": 265.94,
  "end": 266.64,
  "text": "It was you."
 },
 {
  "i": 131,
  "start": 267.05,
  "end": 267.64,
  "text": "A dare."
 },
 {
  "i": 132,
  "start": 268.08,
  "end": 269.62,
  "text": "Omar was standing next to it."
 },
 {
  "i": 133,
  "start": 270.03,
  "end": 271.18,
  "text": "The teachers caught him."
 },
 {
  "i": 134,
  "start": 271.58,
  "end": 272.32,
  "text": "And you said..."
 },
 {
  "i": 135,
  "start": 272.71,
  "end": 273.27,
  "text": "nothing."
 },
 {
  "i": 136,
  "start": 273.73,
  "end": 275.48,
  "text": "On Friday, there’s a hearing."
 },
 {
  "i": 137,
  "start": 275.88,
  "end": 278.33,
  "text": "In your old life, Omar was expelled."
 },
 {
  "i": 138,
  "start": 278.93,
  "end": 280.41,
  "text": "His family moved away."
 },
 {
  "i": 139,
  "start": 280.6,
  "end": 281.78,
  "text": "You never spoke again."
 },
 {
  "i": 140,
  "start": 281.93,
  "end": 282.87,
  "text": "And there’s Dad."
 },
 {
  "i": 141,
  "start": 283.33,
  "end": 285.49,
  "text": "Dad works nights at the hospital laundry."
 },
 {
  "i": 142,
  "start": 285.8,
  "end": 287.72,
  "text": "Every Sunday he calls from his break."
 },
 {
  "i": 143,
  "start": 288.12,
  "end": 288.93,
  "text": "Hey, kiddo."
 },
 {
  "i": 144,
  "start": 289.24,
  "end": 290.01,
  "text": "Just calling."
 },
 {
  "i": 145,
  "start": 290.41,
  "end": 291.1,
  "text": "No reason."
 },
 {
  "i": 146,
  "start": 291.48,
  "end": 293.42,
  "text": "In your old life, you stopped picking up."
 },
 {
  "i": 147,
  "start": 293.76,
  "end": 295.62,
  "text": "Your phone filled with those messages."
 },
 {
  "i": 148,
  "start": 295.98,
  "end": 296.7,
  "text": "No reason."
 },
 {
  "i": 149,
  "start": 297.09,
  "end": 297.82,
  "text": "No reason."
 },
 {
  "i": 150,
  "start": 298.5,
  "end": 299.26,
  "text": "No reason."
 },
 {
  "i": 151,
  "start": 299.26,
  "end": 301.75,
  "text": "You never once called back."
 },
 {
  "i": 152,
  "start": 301.75,
  "end": 302.22,
  "text": "Friday comes."
 },
 {
  "i": 153,
  "start": 302.22,
  "end": 304.67,
  "text": "The principal’s office smells like old coffee and floor polish."
 },
 {
  "i": 154,
  "start": 305.04,
  "end": 306.93,
  "text": "Omar sits in the chair by the window."
 },
 {
  "i": 155,
  "start": 307.24,
  "end": 308.6,
  "text": "His mom holds his hand."
 },
 {
  "i": 156,
  "start": 308.89,
  "end": 309.84,
  "text": "His eyes are red."
 },
 {
  "i": 157,
  "start": 310.22,
  "end": 312.03,
  "text": "Principal Hart folds her hands."
 },
 {
  "i": 158,
  "start": 312.54,
  "end": 313.89,
  "text": "Someone pulled that alarm."
 },
 {
  "i": 159,
  "start": 314.11,
  "end": 316.42,
  "text": "Three hundred students went outside in the rain."
 },
 {
  "i": 160,
  "start": 316.88,
  "end": 317.98,
  "text": "If nobody speaks..."
 },
 {
  "i": 161,
  "start": 318.3,
  "end": 319.54,
  "text": "Omar is expelled."
 },
 {
  "i": 162,
  "start": 319.95,
  "end": 321.27,
  "text": "And then she smiles at you."
 },
 {
  "i": 163,
  "start": 322.15,
  "end": 323.85,
  "text": "Eli, on a happier note..."
 },
 {
  "i": 164,
  "start": 324.22,
  "end": 326.07,
  "text": "you’ve been picked for the city scholarship."
 },
 {
  "i": 165,
  "start": 326.44,
  "end": 327.56,
  "text": "Your stomach drops."
 },
 {
  "i": 166,
  "start": 327.97,
  "end": 329.16,
  "text": "You remember this moment."
 },
 {
  "i": 167,
  "start": 329.59,
  "end": 332.85,
  "text": "In your old life, that scholarship opened every door."
 },
 {
  "i": 168,
  "start": 333.29,
  "end": 334.14,
  "text": "The top school."
 },
 {
  "i": 169,
  "start": 334.51,
  "end": 335.7,
  "text": "The top university."
 },
 {
  "i": 170,
  "start": 336.1,
  "end": 336.9,
  "text": "The good job."
 },
 {
  "i": 171,
  "start": 337.29,
  "end": 338.41,
  "text": "The quiet apartment."
 },
 {
  "i": 172,
  "start": 339.03,
  "end": 340.53,
  "text": "The phone you never answered."
 },
 {
  "i": 173,
  "start": 340.84,
  "end": 343.23,
  "text": "If you confess, the scholarship is gone."
 },
 {
  "i": 174,
  "start": 343.73,
  "end": 344.75,
  "text": "Rules are rules."
 },
 {
  "i": 175,
  "start": 345.13,
  "end": 346.35,
  "text": "And a change this big..."
 },
 {
  "i": 176,
  "start": 346.67,
  "end": 348.84,
  "text": "could wipe out every memory you brought back."
 },
 {
  "i": 177,
  "start": 349.26,
  "end": 350.36,
  "text": "All twenty years."
 },
 {
  "i": 178,
  "start": 350.8,
  "end": 351.62,
  "text": "Every answer."
 },
 {
  "i": 179,
  "start": 352.06,
  "end": 353.04,
  "text": "Every advantage."
 },
 {
  "i": 180,
  "start": 353.43,
  "end": 354.18,
  "text": "You’d just be..."
 },
 {
  "i": 181,
  "start": 354.48,
  "end": 355.04,
  "text": "twelve."
 },
 {
  "i": 182,
  "start": 355.44,
  "end": 356.82,
  "text": "The clock on the wall ticks."
 },
 {
  "i": 183,
  "start": 357.27,
  "end": 359.93,
  "text": "Every second, the old future pulls you back."
 },
 {
  "i": 184,
  "start": 360.59,
  "end": 361.66,
  "text": "Omar looks at you."
 },
 {
  "i": 185,
  "start": 361.89,
  "end": 363.28,
  "text": "He taps the desk twice."
 },
 {
  "i": 186,
  "start": 363.49,
  "end": 364.33,
  "text": "Then he stops."
 },
 {
  "i": 187,
  "start": 364.64,
  "end": 365.95,
  "text": "He doesn’t finish the signal."
 },
 {
  "i": 188,
  "start": 366.25,
  "end": 367.41,
  "text": "He doesn’t think you’ll help."
 },
 {
  "i": 189,
  "start": 367.79,
  "end": 368.56,
  "text": "Why would he?"
 },
 {
  "i": 190,
  "start": 368.98,
  "end": 369.7,
  "text": "Last time..."
 },
 {
  "i": 191,
  "start": 370.0,
  "end": 370.62,
  "text": "you didn’t."
 },
 {
  "i": 192,
  "start": 370.97,
  "end": 372.09,
  "text": "Your perfect future..."
 },
 {
  "i": 193,
  "start": 372.43,
  "end": 373.55,
  "text": "or your best friend."
 },
 {
  "i": 194,
  "start": 373.9,
  "end": 375.62,
  "text": "You think about the quiet apartment."
 },
 {
  "i": 195,
  "start": 375.94,
  "end": 376.7,
  "text": "The messages."
 },
 {
  "i": 196,
  "start": 377.06,
  "end": 377.75,
  "text": "No reason."
 },
 {
  "i": 197,
  "start": 378.14,
  "end": 378.87,
  "text": "No reason."
 },
 {
  "i": 198,
  "start": 379.22,
  "end": 380.5,
  "text": "You didn’t come back to win."
 },
 {
  "i": 199,
  "start": 381.07,
  "end": 382.29,
  "text": "You came back to fix it."
 },
 {
  "i": 200,
  "start": 382.54,
  "end": 383.33,
  "text": "You stand up."
 },
 {
  "i": 201,
  "start": 383.58,
  "end": 384.35,
  "text": "It was me."
 },
 {
  "i": 202,
  "start": 384.7,
  "end": 385.34,
  "text": "Silence."
 },
 {
  "i": 203,
  "start": 385.67,
  "end": 386.7,
  "text": "I pulled the alarm."
 },
 {
  "i": 204,
  "start": 387.02,
  "end": 387.74,
  "text": "On a dare."
 },
 {
  "i": 205,
  "start": 388.13,
  "end": 389.68,
  "text": "Omar was just standing there."
 },
 {
  "i": 206,
  "start": 390.03,
  "end": 391.55,
  "text": "Omar’s mouth falls open."
 },
 {
  "i": 207,
  "start": 391.89,
  "end": 393.66,
  "text": "Principal Hart takes a long breath."
 },
 {
  "i": 208,
  "start": 394.0,
  "end": 394.52,
  "text": "Eli..."
 },
 {
  "i": 209,
  "start": 394.91,
  "end": 396.98,
  "text": "you understand what this means for the scholarship?"
 },
 {
  "i": 210,
  "start": 397.38,
  "end": 397.92,
  "text": "I do."
 },
 {
  "i": 211,
  "start": 398.24,
  "end": 399.51,
  "text": "Two weeks of detention."
 },
 {
  "i": 212,
  "start": 399.86,
  "end": 400.88,
  "text": "One letter home."
 },
 {
  "i": 213,
  "start": 401.2,
  "end": 402.06,
  "text": "No scholarship."
 },
 {
  "i": 214,
  "start": 402.44,
  "end": 403.38,
  "text": "Omar stays."
 },
 {
  "i": 215,
  "start": 403.93,
  "end": 406.0,
  "text": "In the hallway, he grabs your shoulder."
 },
 {
  "i": 216,
  "start": 406.42,
  "end": 406.86,
  "text": "Why?"
 },
 {
  "i": 217,
  "start": 407.26,
  "end": 408.3,
  "text": "You could’ve said nothing."
 },
 {
  "i": 218,
  "start": 408.69,
  "end": 410.49,
  "text": "I already did that once, you say."
 },
 {
  "i": 219,
  "start": 410.94,
  "end": 412.07,
  "text": "He doesn’t understand."
 },
 {
  "i": 220,
  "start": 412.45,
  "end": 413.45,
  "text": "He doesn’t need to."
 },
 {
  "i": 221,
  "start": 413.85,
  "end": 415.09,
  "text": "He taps the wall twice..."
 },
 {
  "i": 222,
  "start": 415.45,
  "end": 416.58,
  "text": "and gives you a thumbs-up."
 },
 {
  "i": 223,
  "start": 417.0,
  "end": 419.35,
  "text": "The next morning, the whole class has heard."
 },
 {
  "i": 224,
  "start": 419.79,
  "end": 421.21,
  "text": "Some kids think you’re crazy."
 },
 {
  "i": 225,
  "start": 421.63,
  "end": 422.75,
  "text": "Most think you’re brave."
 },
 {
  "i": 226,
  "start": 423.25,
  "end": 424.56,
  "text": "That night, it starts."
 },
 {
  "i": 227,
  "start": 425.19,
  "end": 426.78,
  "text": "Your memories begin to fade."
 },
 {
  "i": 228,
  "start": 426.97,
  "end": 427.9,
  "text": "Your old office."
 },
 {
  "i": 229,
  "start": 428.07,
  "end": 428.97,
  "text": "Your old street."
 },
 {
  "i": 230,
  "start": 429.28,
  "end": 431.29,
  "text": "The faces of people you haven’t met yet."
 },
 {
  "i": 231,
  "start": 431.55,
  "end": 434.15,
  "text": "You grab a notebook and write as fast as you can."
 },
 {
  "i": 232,
  "start": 434.5,
  "end": 435.24,
  "text": "‘Keep Omar."
 },
 {
  "i": 233,
  "start": 435.54,
  "end": 436.32,
  "text": "Answer Dad."
 },
 {
  "i": 234,
  "start": 436.51,
  "end": 437.35,
  "text": "Learn Spanish."
 },
 {
  "i": 235,
  "start": 437.63,
  "end": 438.65,
  "text": "Save the coins.’"
 },
 {
  "i": 236,
  "start": 439.1,
  "end": 439.81,
  "text": "By morning..."
 },
 {
  "i": 237,
  "start": 440.08,
  "end": 441.78,
  "text": "you can’t remember why you wrote it."
 },
 {
  "i": 238,
  "start": 442.1,
  "end": 443.05,
  "text": "You’re just twelve."
 },
 {
  "i": 239,
  "start": 443.29,
  "end": 443.81,
  "text": "Normal."
 },
 {
  "i": 240,
  "start": 444.09,
  "end": 445.48,
  "text": "Kind of behind in maths."
 },
 {
  "i": 241,
  "start": 445.81,
  "end": 447.73,
  "text": "Then on Sunday, the phone rings."
 },
 {
  "i": 242,
  "start": 448.05,
  "end": 448.8,
  "text": "Hey, kiddo."
 },
 {
  "i": 243,
  "start": 449.27,
  "end": 449.97,
  "text": "Just calling."
 },
 {
  "i": 244,
  "start": 450.3,
  "end": 451.0,
  "text": "No reason."
 },
 {
  "i": 245,
  "start": 451.39,
  "end": 453.0,
  "text": "You don’t know why your eyes sting."
 },
 {
  "i": 246,
  "start": 453.34,
  "end": 455.13,
  "text": "You just hold the phone a little tighter."
 },
 {
  "i": 247,
  "start": 455.48,
  "end": 456.04,
  "text": "Hey, Dad."
 },
 {
  "i": 248,
  "start": 456.36,
  "end": 457.33,
  "text": "Tell me everything."
 },
 {
  "i": 249,
  "start": 457.78,
  "end": 459.0,
  "text": "And somewhere deep down..."
 },
 {
  "i": 250,
  "start": 459.36,
  "end": 460.62,
  "text": "something feels fixed."
 },
 {
  "i": 251,
  "start": 461.0,
  "end": 462.08,
  "text": "Is any of this real?"
 },
 {
  "i": 252,
  "start": 462.43,
  "end": 464.36,
  "text": "Nobody can wake up in their younger body."
 },
 {
  "i": 253,
  "start": 464.7,
  "end": 466.03,
  "text": "But some parts are real."
 },
 {
  "i": 254,
  "start": 466.54,
  "end": 468.86,
  "text": "Your memories aren’t stored like videos."
 },
 {
  "i": 255,
  "start": 469.16,
  "end": 473.85,
  "text": "Every time you remember something, your brain rebuilds it, and it can change a little."
 },
 {
  "i": 256,
  "start": 474.22,
  "end": 479.25,
  "text": "The part of the brain behind self-control really does keep developing into your mid-twenties."
 },
 {
  "i": 257,
  "start": 479.68,
  "end": 486.72,
  "text": "And in 1995, psychologists Thomas Gilovich and Victoria Medvec published research on regret."
 },
 {
  "i": 258,
  "start": 487.33,
  "end": 491.22,
  "text": "Over the long run, people regret what they didn’t do more than what they did."
 },
 {
  "i": 259,
  "start": 491.54,
  "end": 492.61,
  "text": "Like staying quiet."
 },
 {
  "i": 260,
  "start": 492.97,
  "end": 494.18,
  "text": "Like not calling back."
 },
 {
  "i": 261,
  "start": 494.5,
  "end": 495.67,
  "text": "So if you could go back..."
 },
 {
  "i": 262,
  "start": 495.95,
  "end": 497.53,
  "text": "what’s the one thing you’d fix?"
 },
 {
  "i": 263,
  "start": 497.82,
  "end": 498.65,
  "text": "What do you think?"
 },
 {
  "i": 264,
  "start": 498.93,
  "end": 502.46,
  "text": "Tell us in the comments, and tell us which What If we should do next."
 },
 {
  "i": 265,
  "start": 502.79,
  "end": 505.42,
  "text": "Hit like, and subscribe for more What Ifs."
 }
]