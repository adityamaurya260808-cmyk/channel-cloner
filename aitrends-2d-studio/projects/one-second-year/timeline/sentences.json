[
 {
  "i": 0,
  "start": 0.2,
  "end": 1.48,
  "text": "Sunday afternoon."
 },
 {
  "i": 1,
  "start": 1.91,
  "end": 2.68,
  "text": "Music on."
 },
 {
  "i": 2,
  "start": 3.16,
  "end": 6.79,
  "text": "Your grandpa is dancing in the kitchen, the way he always does."
 },
 {
  "i": 3,
  "start": 7.26,
  "end": 9.19,
  "text": "Then his hand slips off the counter."
 },
 {
  "i": 4,
  "start": 9.63,
  "end": 10.67,
  "text": "His knees fold."
 },
 {
  "i": 5,
  "start": 11.13,
  "end": 12.19,
  "text": "And the whole world..."
 },
 {
  "i": 6,
  "start": 12.61,
  "end": 13.26,
  "text": "stops."
 },
 {
  "i": 7,
  "start": 13.76,
  "end": 15.31,
  "text": "His glasses hang in the air."
 },
 {
  "i": 8,
  "start": 15.78,
  "end": 17.45,
  "text": "A spoon floats above the floor."
 },
 {
  "i": 9,
  "start": 17.94,
  "end": 19.62,
  "text": "The music holds one long note."
 },
 {
  "i": 10,
  "start": 20.1,
  "end": 21.0,
  "text": "Nothing moves."
 },
 {
  "i": 11,
  "start": 21.36,
  "end": 22.22,
  "text": "Not even you."
 },
 {
  "i": 12,
  "start": 22.95,
  "end": 24.84,
  "text": "You’re standing inside a single second."
 },
 {
  "i": 13,
  "start": 25.24,
  "end": 27.0,
  "text": "And you’re about to live a whole year in it."
 },
 {
  "i": 14,
  "start": 27.37,
  "end": 30.41,
  "text": "Three weeks earlier, it happened for the very first time."
 },
 {
  "i": 15,
  "start": 30.93,
  "end": 32.09,
  "text": "Your name is Leo."
 },
 {
  "i": 16,
  "start": 32.44,
  "end": 33.25,
  "text": "You’re fifteen."
 },
 {
  "i": 17,
  "start": 33.81,
  "end": 36.8,
  "text": "A year holds about thirty-one and a half million seconds."
 },
 {
  "i": 18,
  "start": 37.39,
  "end": 39.24,
  "text": "Most people feel each one as..."
 },
 {
  "i": 19,
  "start": 39.59,
  "end": 40.49,
  "text": "just a second."
 },
 {
  "i": 20,
  "start": 41.01,
  "end": 41.44,
  "text": "You?"
 },
 {
  "i": 21,
  "start": 42.08,
  "end": 45.5,
  "text": "Hold your breath, and one second stretches into a full year."
 },
 {
  "i": 22,
  "start": 45.5,
  "end": 47.05,
  "text": "A year to think."
 },
 {
  "i": 23,
  "start": 47.43,
  "end": 48.12,
  "text": "To remember."
 },
 {
  "i": 24,
  "start": 48.45,
  "end": 49.14,
  "text": "To plan."
 },
 {
  "i": 25,
  "start": 49.54,
  "end": 50.42,
  "text": "But there’s a rule."
 },
 {
  "i": 26,
  "start": 50.85,
  "end": 52.25,
  "text": "Your mind runs free."
 },
 {
  "i": 27,
  "start": 52.64,
  "end": 53.84,
  "text": "Your body doesn’t move."
 },
 {
  "i": 28,
  "start": 54.33,
  "end": 55.07,
  "text": "Not a finger."
 },
 {
  "i": 29,
  "start": 55.47,
  "end": 56.55,
  "text": "Not even your eyes."
 },
 {
  "i": 30,
  "start": 57.03,
  "end": 58.3,
  "text": "You can think anything..."
 },
 {
  "i": 31,
  "start": 58.69,
  "end": 60.41,
  "text": "but you can’t do anything."
 },
 {
  "i": 32,
  "start": 60.85,
  "end": 62.22,
  "text": "Not until you breathe out."
 },
 {
  "i": 33,
  "start": 62.67,
  "end": 64.81,
  "text": "So what if one second felt like a year?"
 },
 {
  "i": 34,
  "start": 65.32,
  "end": 67.05,
  "text": "The first time is a maths test."
 },
 {
  "i": 35,
  "start": 67.48,
  "end": 68.42,
  "text": "Question seven."
 },
 {
  "i": 36,
  "start": 68.82,
  "end": 69.7,
  "text": "You hold your breath..."
 },
 {
  "i": 37,
  "start": 70.04,
  "end": 71.43,
  "text": "and you get a whole year with it."
 },
 {
  "i": 38,
  "start": 71.83,
  "end": 72.52,
  "text": "You solve it."
 },
 {
  "i": 39,
  "start": 73.01,
  "end": 74.66,
  "text": "Then you solve it three more ways."
 },
 {
  "i": 40,
  "start": 75.05,
  "end": 77.98,
  "text": "Then you get bored and invent a board game in your head."
 },
 {
  "i": 41,
  "start": 78.44,
  "end": 79.24,
  "text": "You breathe out."
 },
 {
  "i": 42,
  "start": 79.61,
  "end": 80.78,
  "text": "The clock hasn’t moved."
 },
 {
  "i": 43,
  "start": 81.24,
  "end": 83.38,
  "text": "Leo, you finished in four minutes?"
 },
 {
  "i": 44,
  "start": 83.77,
  "end": 84.29,
  "text": "I had..."
 },
 {
  "i": 45,
  "start": 85.1,
  "end": 86.09,
  "text": "plenty of time."
 },
 {
  "i": 46,
  "start": 86.32,
  "end": 87.68,
  "text": "Plus: chess club."
 },
 {
  "i": 47,
  "start": 88.07,
  "end": 89.9,
  "text": "Every move gets a year of thought."
 },
 {
  "i": 48,
  "start": 90.25,
  "end": 92.67,
  "text": "You beat the school champion in eleven moves."
 },
 {
  "i": 49,
  "start": 92.98,
  "end": 94.92,
  "text": "Your best friend Jake stares at you."
 },
 {
  "i": 50,
  "start": 95.25,
  "end": 96.52,
  "text": "How long were you thinking?"
 },
 {
  "i": 51,
  "start": 96.9,
  "end": 97.81,
  "text": "About a second."
 },
 {
  "i": 52,
  "start": 98.16,
  "end": 98.58,
  "text": "Mate."
 },
 {
  "i": 53,
  "start": 98.94,
  "end": 100.71,
  "text": "That was a very scary second."
 },
 {
  "i": 54,
  "start": 101.1,
  "end": 101.96,
  "text": "Then football."
 },
 {
  "i": 55,
  "start": 102.31,
  "end": 105.18,
  "text": "A hard penalty reaches the goal in about half a second."
 },
 {
  "i": 56,
  "start": 105.86,
  "end": 108.23,
  "text": "You hold your breath as the ball leaves the boot."
 },
 {
  "i": 57,
  "start": 108.53,
  "end": 109.44,
  "text": "You see the spin."
 },
 {
  "i": 58,
  "start": 109.79,
  "end": 110.43,
  "text": "The angle."
 },
 {
  "i": 59,
  "start": 110.72,
  "end": 111.77,
  "text": "The exact corner."
 },
 {
  "i": 60,
  "start": 112.14,
  "end": 113.6,
  "text": "But the rule still holds."
 },
 {
  "i": 61,
  "start": 114.02,
  "end": 116.44,
  "text": "You can’t dive any faster than any other keeper."
 },
 {
  "i": 62,
  "start": 116.84,
  "end": 118.29,
  "text": "You just dive the right way..."
 },
 {
  "i": 63,
  "start": 118.71,
  "end": 119.5,
  "text": "first time."
 },
 {
  "i": 64,
  "start": 119.91,
  "end": 120.65,
  "text": "Fingertips."
 },
 {
  "i": 65,
  "start": 120.98,
  "end": 121.53,
  "text": "Saved."
 },
 {
  "i": 66,
  "start": 121.94,
  "end": 123.92,
  "text": "Minus: your eyes can’t move."
 },
 {
  "i": 67,
  "start": 124.28,
  "end": 127.38,
  "text": "So for a whole year, you stare at one frozen picture."
 },
 {
  "i": 68,
  "start": 127.95,
  "end": 129.32,
  "text": "Sometimes it’s a sunset."
 },
 {
  "i": 69,
  "start": 129.61,
  "end": 130.73,
  "text": "Sometimes it’s Jake..."
 },
 {
  "i": 70,
  "start": 130.73,
  "end": 131.56,
  "text": "mid-sneeze."
 },
 {
  "i": 71,
  "start": 131.94,
  "end": 133.82,
  "text": "For three hundred and sixty-five days."
 },
 {
  "i": 72,
  "start": 134.18,
  "end": 136.13,
  "text": "Your heart beats roughly once a second."
 },
 {
  "i": 73,
  "start": 136.47,
  "end": 139.02,
  "text": "So inside the year, you hear one heartbeat."
 },
 {
  "i": 74,
  "start": 139.41,
  "end": 140.04,
  "text": "Just one."
 },
 {
  "i": 75,
  "start": 140.4,
  "end": 142.58,
  "text": "Like a door closing very, very slowly."
 },
 {
  "i": 76,
  "start": 142.9,
  "end": 144.52,
  "text": "But where it gets really crazy..."
 },
 {
  "i": 77,
  "start": 144.87,
  "end": 145.66,
  "text": "is a storm."
 },
 {
  "i": 78,
  "start": 146.08,
  "end": 148.46,
  "text": "A lightning flash is over in less than a second."
 },
 {
  "i": 79,
  "start": 148.93,
  "end": 151.08,
  "text": "You get to watch it crawl across the sky..."
 },
 {
  "i": 80,
  "start": 151.43,
  "end": 152.1,
  "text": "for months."
 },
 {
  "i": 81,
  "start": 152.54,
  "end": 153.46,
  "text": "And there’s a cost."
 },
 {
  "i": 82,
  "start": 153.91,
  "end": 156.45,
  "text": "Every time you use it, you live another year."
 },
 {
  "i": 83,
  "start": 156.79,
  "end": 157.32,
  "text": "Alone."
 },
 {
  "i": 84,
  "start": 157.71,
  "end": 158.54,
  "text": "No voices."
 },
 {
  "i": 85,
  "start": 158.88,
  "end": 159.6,
  "text": "No touch."
 },
 {
  "i": 86,
  "start": 159.97,
  "end": 162.33,
  "text": "Just your thoughts and one frozen picture."
 },
 {
  "i": 87,
  "start": 162.71,
  "end": 163.54,
  "text": "You’re fifteen."
 },
 {
  "i": 88,
  "start": 163.95,
  "end": 165.64,
  "text": "But you’ve used it forty times."
 },
 {
  "i": 89,
  "start": 166.01,
  "end": 166.73,
  "text": "Which means..."
 },
 {
  "i": 90,
  "start": 167.26,
  "end": 169.32,
  "text": "you’ve lived forty years nobody saw."
 },
 {
  "i": 91,
  "start": 169.68,
  "end": 170.25,
  "text": "The price?"
 },
 {
  "i": 92,
  "start": 170.43,
  "end": 173.39,
  "text": "Scientists know long isolation is hard on the human brain."
 },
 {
  "i": 93,
  "start": 173.94,
  "end": 180.0,
  "text": "People kept alone for long stretches often report anxiety, confusion, even seeing things that aren’t there."
 },
 {
  "i": 94,
  "start": 180.39,
  "end": 181.44,
  "text": "You start to feel it."
 },
 {
  "i": 95,
  "start": 181.83,
  "end": 182.82,
  "text": "Jake notices."
 },
 {
  "i": 96,
  "start": 183.22,
  "end": 183.73,
  "text": "Dude."
 },
 {
  "i": 97,
  "start": 184.14,
  "end": 185.32,
  "text": "You sigh like my dad."
 },
 {
  "i": 98,
  "start": 185.72,
  "end": 187.31,
  "text": "And one question keeps growing."
 },
 {
  "i": 99,
  "start": 187.9,
  "end": 188.82,
  "text": "What if one day..."
 },
 {
  "i": 100,
  "start": 189.2,
  "end": 191.07,
  "text": "you can’t make yourself breathe out?"
 },
 {
  "i": 101,
  "start": 191.49,
  "end": 193.08,
  "text": "Only one person knows."
 },
 {
  "i": 102,
  "start": 193.51,
  "end": 194.13,
  "text": "Grandpa."
 },
 {
  "i": 103,
  "start": 194.46,
  "end": 195.41,
  "text": "He doesn’t laugh."
 },
 {
  "i": 104,
  "start": 195.69,
  "end": 196.58,
  "text": "He just nods."
 },
 {
  "i": 105,
  "start": 196.97,
  "end": 198.17,
  "text": "A whole year alone?"
 },
 {
  "i": 106,
  "start": 198.46,
  "end": 200.03,
  "text": "Then don’t go in empty-handed."
 },
 {
  "i": 107,
  "start": 200.38,
  "end": 201.2,
  "text": "Take a song."
 },
 {
  "i": 108,
  "start": 201.53,
  "end": 202.16,
  "text": "His song."
 },
 {
  "i": 109,
  "start": 202.56,
  "end": 206.78,
  "text": "The same old disco record he dances to every Sunday, tapping the counter."
 },
 {
  "i": 110,
  "start": 207.13,
  "end": 208.61,
  "text": "He even taught you the steps."
 },
 {
  "i": 111,
  "start": 209.15,
  "end": 209.48,
  "text": "Boom."
 },
 {
  "i": 112,
  "start": 209.48,
  "end": 209.77,
  "text": "Boom."
 },
 {
  "i": 113,
  "start": 209.77,
  "end": 210.2,
  "text": "Boom."
 },
 {
  "i": 114,
  "start": 210.59,
  "end": 211.91,
  "text": "About a hundred beats a minute."
 },
 {
  "i": 115,
  "start": 212.37,
  "end": 216.37,
  "text": "You hum it inside every frozen year, so the silence isn’t silent."
 },
 {
  "i": 116,
  "start": 216.85,
  "end": 219.33,
  "text": "And whenever you worry, he says the same thing."
 },
 {
  "i": 117,
  "start": 219.79,
  "end": 221.19,
  "text": "A second is plenty, Leo..."
 },
 {
  "i": 118,
  "start": 221.58,
  "end": 222.38,
  "text": "if you use it."
 },
 {
  "i": 119,
  "start": 222.82,
  "end": 223.39,
  "text": "Sunday."
 },
 {
  "i": 120,
  "start": 223.77,
  "end": 224.39,
  "text": "The kitchen."
 },
 {
  "i": 121,
  "start": 224.82,
  "end": 225.43,
  "text": "The song."
 },
 {
  "i": 122,
  "start": 225.85,
  "end": 226.89,
  "text": "Grandpa falls."
 },
 {
  "i": 123,
  "start": 227.24,
  "end": 228.31,
  "text": "And you hold your breath."
 },
 {
  "i": 124,
  "start": 228.7,
  "end": 229.82,
  "text": "Now you’re in the year."
 },
 {
  "i": 125,
  "start": 230.57,
  "end": 233.28,
  "text": "A body takes about half a second to reach the floor."
 },
 {
  "i": 126,
  "start": 233.76,
  "end": 235.2,
  "text": "You watch every centimeter."
 },
 {
  "i": 127,
  "start": 235.56,
  "end": 237.11,
  "text": "What can a frozen boy do?"
 },
 {
  "i": 128,
  "start": 237.47,
  "end": 237.96,
  "text": "Nothing."
 },
 {
  "i": 129,
  "start": 238.4,
  "end": 238.99,
  "text": "Not yet."
 },
 {
  "i": 130,
  "start": 239.27,
  "end": 240.96,
  "text": "You remember a first-aid class."
 },
 {
  "i": 131,
  "start": 241.48,
  "end": 246.63,
  "text": "When a heart suddenly stops, the brain can start to be damaged after just a few minutes without oxygen."
 },
 {
  "i": 132,
  "start": 247.1,
  "end": 248.63,
  "text": "Every real second counts."
 },
 {
  "i": 133,
  "start": 248.96,
  "end": 250.15,
  "text": "And you have a whole year..."
 },
 {
  "i": 134,
  "start": 250.62,
  "end": 251.55,
  "text": "to think about that."
 },
 {
  "i": 135,
  "start": 251.87,
  "end": 253.42,
  "text": "Can you even remember the steps?"
 },
 {
  "i": 136,
  "start": 253.82,
  "end": 255.36,
  "text": "You go over that class again."
 },
 {
  "i": 137,
  "start": 255.72,
  "end": 256.39,
  "text": "And again."
 },
 {
  "i": 138,
  "start": 256.78,
  "end": 257.89,
  "text": "A thousand times."
 },
 {
  "i": 139,
  "start": 258.3,
  "end": 260.37,
  "text": "But in here, nothing gets worse."
 },
 {
  "i": 140,
  "start": 260.71,
  "end": 262.81,
  "text": "Grandpa’s still standing, sort of."
 },
 {
  "i": 141,
  "start": 263.17,
  "end": 264.0,
  "text": "Nothing ends."
 },
 {
  "i": 142,
  "start": 264.37,
  "end": 265.23,
  "text": "You could stay."
 },
 {
  "i": 143,
  "start": 265.54,
  "end": 266.08,
  "text": "A year."
 },
 {
  "i": 144,
  "start": 266.38,
  "end": 267.07,
  "text": "Ten years."
 },
 {
  "i": 145,
  "start": 267.41,
  "end": 267.99,
  "text": "Forever."
 },
 {
  "i": 146,
  "start": 268.44,
  "end": 270.3,
  "text": "In here, he’s still okay."
 },
 {
  "i": 147,
  "start": 270.68,
  "end": 271.29,
  "text": "Out there..."
 },
 {
  "i": 148,
  "start": 271.68,
  "end": 272.65,
  "text": "the clock starts."
 },
 {
  "i": 149,
  "start": 273.21,
  "end": 274.77,
  "text": "Stay in the frozen second..."
 },
 {
  "i": 150,
  "start": 275.13,
  "end": 276.73,
  "text": "or step out and fight for him."
 },
 {
  "i": 151,
  "start": 277.22,
  "end": 277.99,
  "text": "Then you hear it."
 },
 {
  "i": 152,
  "start": 278.52,
  "end": 279.51,
  "text": "One long note."
 },
 {
  "i": 153,
  "start": 279.95,
  "end": 280.67,
  "text": "His song."
 },
 {
  "i": 154,
  "start": 281.19,
  "end": 282.32,
  "text": "A second is plenty..."
 },
 {
  "i": 155,
  "start": 282.61,
  "end": 283.39,
  "text": "if you use it."
 },
 {
  "i": 156,
  "start": 283.82,
  "end": 284.8,
  "text": "You’ve had your year."
 },
 {
  "i": 157,
  "start": 285.13,
  "end": 286.24,
  "text": "Now use the second."
 },
 {
  "i": 158,
  "start": 286.66,
  "end": 287.46,
  "text": "You breathe out."
 },
 {
  "i": 159,
  "start": 287.79,
  "end": 289.02,
  "text": "The spoon hits the floor."
 },
 {
  "i": 160,
  "start": 289.37,
  "end": 289.88,
  "text": "Mom!"
 },
 {
  "i": 161,
  "start": 290.17,
  "end": 291.19,
  "text": "Call an ambulance!"
 },
 {
  "i": 162,
  "start": 291.68,
  "end": 292.27,
  "text": "You kneel."
 },
 {
  "i": 163,
  "start": 292.7,
  "end": 294.23,
  "text": "Hands in the center of his chest."
 },
 {
  "i": 164,
  "start": 294.61,
  "end": 295.37,
  "text": "Push hard."
 },
 {
  "i": 165,
  "start": 295.92,
  "end": 297.49,
  "text": "About five centimeters deep."
 },
 {
  "i": 166,
  "start": 297.87,
  "end": 300.34,
  "text": "About a hundred to a hundred and twenty times a minute."
 },
 {
  "i": 167,
  "start": 300.73,
  "end": 301.76,
  "text": "How fast is that?"
 },
 {
  "i": 168,
  "start": 302.15,
  "end": 303.06,
  "text": "You already know."
 },
 {
  "i": 169,
  "start": 303.42,
  "end": 303.87,
  "text": "Boom."
 },
 {
  "i": 170,
  "start": 304.19,
  "end": 304.59,
  "text": "Boom."
 },
 {
  "i": 171,
  "start": 304.93,
  "end": 305.36,
  "text": "Boom."
 },
 {
  "i": 172,
  "start": 305.7,
  "end": 307.02,
  "text": "His song is still playing."
 },
 {
  "i": 173,
  "start": 307.4,
  "end": 308.55,
  "text": "You push on every beat."
 },
 {
  "i": 174,
  "start": 308.86,
  "end": 309.85,
  "text": "Your arms burn."
 },
 {
  "i": 175,
  "start": 310.2,
  "end": 310.95,
  "text": "You don’t stop."
 },
 {
  "i": 176,
  "start": 311.35,
  "end": 313.37,
  "text": "Nine minutes later, sirens."
 },
 {
  "i": 177,
  "start": 313.71,
  "end": 315.94,
  "text": "The paramedics take over with a defibrillator."
 },
 {
  "i": 178,
  "start": 316.47,
  "end": 316.99,
  "text": "Then..."
 },
 {
  "i": 179,
  "start": 317.25,
  "end": 317.78,
  "text": "a beep."
 },
 {
  "i": 180,
  "start": 318.2,
  "end": 318.94,
  "text": "A heartbeat."
 },
 {
  "i": 181,
  "start": 319.41,
  "end": 320.82,
  "text": "Who kept that rhythm going?"
 },
 {
  "i": 182,
  "start": 321.15,
  "end": 321.64,
  "text": "Me."
 },
 {
  "i": 183,
  "start": 322.04,
  "end": 322.86,
  "text": "And his song."
 },
 {
  "i": 184,
  "start": 323.23,
  "end": 326.07,
  "text": "The next day, Grandpa smiles from a hospital bed."
 },
 {
  "i": 185,
  "start": 326.5,
  "end": 327.01,
  "text": "So."
 },
 {
  "i": 186,
  "start": 327.34,
  "end": 328.9,
  "text": "How long did that second feel?"
 },
 {
  "i": 187,
  "start": 329.29,
  "end": 329.84,
  "text": "A year."
 },
 {
  "i": 188,
  "start": 330.19,
  "end": 331.46,
  "text": "And the nine minutes after?"
 },
 {
  "i": 189,
  "start": 331.9,
  "end": 333.05,
  "text": "You squeeze his hand."
 },
 {
  "i": 190,
  "start": 333.43,
  "end": 334.54,
  "text": "Like nine minutes."
 },
 {
  "i": 191,
  "start": 334.84,
  "end": 335.77,
  "text": "Grandpa winks."
 },
 {
  "i": 192,
  "start": 336.17,
  "end": 336.7,
  "text": "Told you."
 },
 {
  "i": 193,
  "start": 337.04,
  "end": 338.1,
  "text": "A second is plenty."
 },
 {
  "i": 194,
  "start": 338.68,
  "end": 340.61,
  "text": "And for the first time in forty years..."
 },
 {
  "i": 195,
  "start": 341.01,
  "end": 341.92,
  "text": "you’re not alone."
 },
 {
  "i": 196,
  "start": 342.27,
  "end": 345.5,
  "text": "That night, you hold your breath, just to rest."
 },
 {
  "i": 197,
  "start": 345.82,
  "end": 348.05,
  "text": "And in the frozen picture, something..."
 },
 {
  "i": 198,
  "start": 348.45,
  "end": 349.07,
  "text": "moves."
 },
 {
  "i": 199,
  "start": 349.49,
  "end": 351.34,
  "text": "Someone else is in the year with you."
 },
 {
  "i": 200,
  "start": 351.69,
  "end": 352.83,
  "text": "Is any of this real?"
 },
 {
  "i": 201,
  "start": 353.18,
  "end": 356.51,
  "text": "People often say time slowed down during a scare."
 },
 {
  "i": 202,
  "start": 356.88,
  "end": 360.95,
  "text": "In 2007, neuroscientist David Eagleman tested it."
 },
 {
  "i": 203,
  "start": 361.37,
  "end": 367.2,
  "text": "Volunteers fell about thirty meters into a net while watching a display flash numbers too fast to read."
 },
 {
  "i": 204,
  "start": 367.68,
  "end": 369.84,
  "text": "If time really slowed, they could read them."
 },
 {
  "i": 205,
  "start": 370.2,
  "end": 370.82,
  "text": "They couldn’t."
 },
 {
  "i": 206,
  "start": 371.21,
  "end": 372.9,
  "text": "Their brains just recorded more."
 },
 {
  "i": 207,
  "start": 373.35,
  "end": 377.65,
  "text": "Frightening moments get stored in richer detail, so they feel longer afterward."
 },
 {
  "i": 208,
  "start": 378.07,
  "end": 379.28,
  "text": "And the CPR part?"
 },
 {
  "i": 209,
  "start": 379.63,
  "end": 380.41,
  "text": "That’s real."
 },
 {
  "i": 210,
  "start": 380.83,
  "end": 387.75,
  "text": "If someone collapses and isn’t breathing normally, call emergency services and push hard and fast in the center of the chest."
 },
 {
  "i": 211,
  "start": 388.14,
  "end": 390.52,
  "text": "So could a brain ever truly stretch a second?"
 },
 {
  "i": 212,
  "start": 390.91,
  "end": 391.67,
  "text": "What do you think?"
 },
 {
  "i": 213,
  "start": 392.04,
  "end": 395.7,
  "text": "Tell us in the comments, and tell us which superpower we should do next."
 },
 {
  "i": 214,
  "start": 396.1,
  "end": 398.32,
  "text": "Hit like, and subscribe for Part Two."
 }
]