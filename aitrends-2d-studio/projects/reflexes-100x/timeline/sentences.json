[
 {
  "i": 0,
  "start": 0.08,
  "end": 2.15,
  "text": "A wasp drifts toward your sandwich."
 },
 {
  "i": 1,
  "start": 2.92,
  "end": 3.79,
  "text": "You watch it come."
 },
 {
  "i": 2,
  "start": 4.58,
  "end": 5.15,
  "text": "Slowly."
 },
 {
  "i": 3,
  "start": 5.89,
  "end": 7.63,
  "text": "Like a feather sinking through honey."
 },
 {
  "i": 4,
  "start": 8.64,
  "end": 10.26,
  "text": "You have time to count its stripes..."
 },
 {
  "i": 5,
  "start": 11.2,
  "end": 12.19,
  "text": "and step aside."
 },
 {
  "i": 6,
  "start": 13.19,
  "end": 14.53,
  "text": "Your mom drops a glass."
 },
 {
  "i": 7,
  "start": 15.09,
  "end": 15.92,
  "text": "You see it tip."
 },
 {
  "i": 8,
  "start": 16.58,
  "end": 17.5,
  "text": "You see it fall."
 },
 {
  "i": 9,
  "start": 18.44,
  "end": 20.02,
  "text": "You remember where the dustpan is..."
 },
 {
  "i": 10,
  "start": 20.64,
  "end": 22.28,
  "text": "before it even reaches the floor."
 },
 {
  "i": 11,
  "start": 23.35,
  "end": 24.5,
  "text": "Your little brother blinks."
 },
 {
  "i": 12,
  "start": 25.28,
  "end": 27.34,
  "text": "To you, that blink takes ten seconds."
 },
 {
  "i": 13,
  "start": 28.4,
  "end": 30.32,
  "text": "Theo, why are you staring at me?"
 },
 {
  "i": 14,
  "start": 31.47,
  "end": 32.2,
  "text": "Because, Sam..."
 },
 {
  "i": 15,
  "start": 32.48,
  "end": 34.06,
  "text": "your eyelid is still closing."
 },
 {
  "i": 16,
  "start": 34.93,
  "end": 35.72,
  "text": "And your toast?"
 },
 {
  "i": 17,
  "start": 36.45,
  "end": 37.5,
  "text": "It still hasn’t popped."
 },
 {
  "i": 18,
  "start": 38.3,
  "end": 40.56,
  "text": "You’ve been waiting for it for what feels like an hour."
 },
 {
  "i": 19,
  "start": 41.88,
  "end": 42.96,
  "text": "Your name is Theo."
 },
 {
  "i": 20,
  "start": 43.64,
  "end": 44.51,
  "text": "You’re fourteen."
 },
 {
  "i": 21,
  "start": 45.25,
  "end": 49.39,
  "text": "A normal person reacts to something they see in about a quarter of a second."
 },
 {
  "i": 22,
  "start": 50.35,
  "end": 50.67,
  "text": "You?"
 },
 {
  "i": 23,
  "start": 51.75,
  "end": 53.08,
  "text": "Two and a half thousandths."
 },
 {
  "i": 24,
  "start": 53.63,
  "end": 54.93,
  "text": "A hundred times faster."
 },
 {
  "i": 25,
  "start": 55.96,
  "end": 61.23,
  "text": "Drop a ruler between most people’s fingers, and it falls about thirty centimeters before they grab it."
 },
 {
  "i": 26,
  "start": 62.2,
  "end": 63.14,
  "text": "Drop one for you..."
 },
 {
  "i": 27,
  "start": 63.52,
  "end": 66.68,
  "text": "and your brain notices after three hundredths of a millimeter."
 },
 {
  "i": 28,
  "start": 67.78,
  "end": 68.3,
  "text": "The catch?"
 },
 {
  "i": 29,
  "start": 69.17,
  "end": 71.16,
  "text": "Your brain got a hundred times faster."
 },
 {
  "i": 30,
  "start": 71.93,
  "end": 73.0,
  "text": "Your body did not."
 },
 {
  "i": 31,
  "start": 73.88,
  "end": 77.84,
  "text": "Your nerves still carry signals at about a hundred meters per second."
 },
 {
  "i": 32,
  "start": 78.67,
  "end": 81.34,
  "text": "Your legs still run like any fourteen-year-old’s."
 },
 {
  "i": 33,
  "start": 82.2,
  "end": 83.54,
  "text": "You see everything coming..."
 },
 {
  "i": 34,
  "start": 84.23,
  "end": 86.39,
  "text": "you just can’t move any faster to meet it."
 },
 {
  "i": 35,
  "start": 87.4,
  "end": 90.27,
  "text": "So what if your reflexes were a hundred times faster?"
 },
 {
  "i": 36,
  "start": 91.24,
  "end": 93.33,
  "text": "Plus: you never lose at catch."
 },
 {
  "i": 37,
  "start": 94.22,
  "end": 97.1,
  "text": "Your best friend Mia throws a ball at your face."
 },
 {
  "i": 38,
  "start": 97.97,
  "end": 99.1,
  "text": "You have time to yawn."
 },
 {
  "i": 39,
  "start": 99.5,
  "end": 100.35,
  "text": "Then you catch it."
 },
 {
  "i": 40,
  "start": 101.25,
  "end": 101.57,
  "text": "How..."
 },
 {
  "i": 41,
  "start": 102.1,
  "end": 103.47,
  "text": "how did you even see that?"
 },
 {
  "i": 42,
  "start": 104.47,
  "end": 105.73,
  "text": "I see everything, Mia."
 },
 {
  "i": 43,
  "start": 106.82,
  "end": 107.26,
  "text": "Okay."
 },
 {
  "i": 44,
  "start": 107.48,
  "end": 108.61,
  "text": "That’s actually creepy."
 },
 {
  "i": 45,
  "start": 109.58,
  "end": 110.35,
  "text": "Video games?"
 },
 {
  "i": 46,
  "start": 111.21,
  "end": 113.26,
  "text": "You read every enemy before it moves."
 },
 {
  "i": 47,
  "start": 114.14,
  "end": 115.41,
  "text": "Forty wins in a row."
 },
 {
  "i": 48,
  "start": 115.97,
  "end": 117.62,
  "text": "Then the game bans you for cheating."
 },
 {
  "i": 49,
  "start": 118.69,
  "end": 119.06,
  "text": "Dude."
 },
 {
  "i": 50,
  "start": 119.28,
  "end": 121.03,
  "text": "Even the computer thinks you’re cheating."
 },
 {
  "i": 51,
  "start": 122.06,
  "end": 122.59,
  "text": "Movies?"
 },
 {
  "i": 52,
  "start": 123.34,
  "end": 125.95,
  "text": "A film shows twenty-four pictures every second."
 },
 {
  "i": 53,
  "start": 126.65,
  "end": 128.01,
  "text": "Everyone else sees motion."
 },
 {
  "i": 54,
  "start": 128.73,
  "end": 129.23,
  "text": "You see..."
 },
 {
  "i": 55,
  "start": 129.82,
  "end": 130.62,
  "text": "a slideshow."
 },
 {
  "i": 56,
  "start": 131.41,
  "end": 131.73,
  "text": "Click."
 },
 {
  "i": 57,
  "start": 132.34,
  "end": 132.55,
  "text": "Click."
 },
 {
  "i": 58,
  "start": 133.46,
  "end": 133.82,
  "text": "Click."
 },
 {
  "i": 59,
  "start": 134.3,
  "end": 135.22,
  "text": "Great movie, right?"
 },
 {
  "i": 60,
  "start": 135.92,
  "end": 136.32,
  "text": "Very..."
 },
 {
  "i": 61,
  "start": 136.92,
  "end": 137.38,
  "text": "clicky."
 },
 {
  "i": 62,
  "start": 138.62,
  "end": 142.11,
  "text": "Minus: some old lights flicker a hundred times a second."
 },
 {
  "i": 63,
  "start": 142.88,
  "end": 143.84,
  "text": "Nobody notices."
 },
 {
  "i": 64,
  "start": 144.37,
  "end": 144.86,
  "text": "You do."
 },
 {
  "i": 65,
  "start": 145.72,
  "end": 148.08,
  "text": "Your school hallway strobes like a nightclub."
 },
 {
  "i": 66,
  "start": 149.0,
  "end": 149.85,
  "text": "Then there’s track."
 },
 {
  "i": 67,
  "start": 150.69,
  "end": 152.61,
  "text": "Coach Lee fires the starting gun."
 },
 {
  "i": 68,
  "start": 153.24,
  "end": 154.91,
  "text": "You’re gone before the smoke clears."
 },
 {
  "i": 69,
  "start": 155.92,
  "end": 156.9,
  "text": "And disqualified."
 },
 {
  "i": 70,
  "start": 157.66,
  "end": 162.86,
  "text": "Leave the blocks less than a tenth of a second after the gun, and the rules decide you must have guessed."
 },
 {
  "i": 71,
  "start": 163.81,
  "end": 166.75,
  "text": "The best sprinters react in about fifteen hundredths."
 },
 {
  "i": 72,
  "start": 167.52,
  "end": 168.74,
  "text": "Nobody beats a tenth."
 },
 {
  "i": 73,
  "start": 169.5,
  "end": 170.02,
  "text": "Nobody..."
 },
 {
  "i": 74,
  "start": 170.61,
  "end": 171.38,
  "text": "except you."
 },
 {
  "i": 75,
  "start": 172.38,
  "end": 174.67,
  "text": "So you learn the strangest skill in sport."
 },
 {
  "i": 76,
  "start": 175.48,
  "end": 175.97,
  "text": "Waiting."
 },
 {
  "i": 77,
  "start": 176.93,
  "end": 178.44,
  "text": "Coach Lee hands you a rule."
 },
 {
  "i": 78,
  "start": 179.35,
  "end": 180.09,
  "text": "Count, Theo."
 },
 {
  "i": 79,
  "start": 180.91,
  "end": 181.6,
  "text": "Count to what?"
 },
 {
  "i": 80,
  "start": 182.43,
  "end": 183.81,
  "text": "Count until you’re on time."
 },
 {
  "i": 81,
  "start": 184.56,
  "end": 185.65,
  "text": "Fast doesn’t matter."
 },
 {
  "i": 82,
  "start": 186.01,
  "end": 187.16,
  "text": "On time does."
 },
 {
  "i": 83,
  "start": 188.72,
  "end": 190.27,
  "text": "But where it gets really crazy..."
 },
 {
  "i": 84,
  "start": 190.79,
  "end": 191.45,
  "text": "is the road."
 },
 {
  "i": 85,
  "start": 192.42,
  "end": 197.01,
  "text": "A car at fifty kilometers per hour moves about fourteen meters every second."
 },
 {
  "i": 86,
  "start": 197.95,
  "end": 199.58,
  "text": "You see every one of those meters."
 },
 {
  "i": 87,
  "start": 200.19,
  "end": 202.11,
  "text": "You see drivers glance at phones."
 },
 {
  "i": 88,
  "start": 202.72,
  "end": 205.45,
  "text": "You see near-misses nobody else even notices."
 },
 {
  "i": 89,
  "start": 206.37,
  "end": 207.19,
  "text": "And there’s a cost."
 },
 {
  "i": 90,
  "start": 207.99,
  "end": 208.57,
  "text": "The price?"
 },
 {
  "i": 91,
  "start": 209.45,
  "end": 212.1,
  "text": "Every second feels like a minute and forty seconds."
 },
 {
  "i": 92,
  "start": 212.96,
  "end": 216.17,
  "text": "A ten-minute lesson feels like more than sixteen hours."
 },
 {
  "i": 93,
  "start": 217.2,
  "end": 218.34,
  "text": "Mia says good morning..."
 },
 {
  "i": 94,
  "start": 218.89,
  "end": 223.52,
  "text": "and you plan your answer, rewrite it twice, and get bored waiting for her to finish."
 },
 {
  "i": 95,
  "start": 224.65,
  "end": 227.59,
  "text": "Your mind lives a hundred days for every day you live."
 },
 {
  "i": 96,
  "start": 228.47,
  "end": 230.29,
  "text": "People start to feel like statues."
 },
 {
  "i": 97,
  "start": 230.94,
  "end": 231.53,
  "text": "Beautiful."
 },
 {
  "i": 98,
  "start": 232.02,
  "end": 232.65,
  "text": "And lonely."
 },
 {
  "i": 99,
  "start": 233.29,
  "end": 234.54,
  "text": "Usually both at once."
 },
 {
  "i": 100,
  "start": 235.45,
  "end": 236.89,
  "text": "Who talks to statues?"
 },
 {
  "i": 101,
  "start": 237.53,
  "end": 238.03,
  "text": "And who..."
 },
 {
  "i": 102,
  "start": 238.46,
  "end": 239.56,
  "text": "is going to wait for you?"
 },
 {
  "i": 103,
  "start": 240.65,
  "end": 241.35,
  "text": "Sam does."
 },
 {
  "i": 104,
  "start": 241.86,
  "end": 243.06,
  "text": "Your seven-year-old brother."
 },
 {
  "i": 105,
  "start": 243.83,
  "end": 245.83,
  "text": "The only person who doesn’t think you’re weird."
 },
 {
  "i": 106,
  "start": 246.81,
  "end": 249.39,
  "text": "He waits for you at the school gate every afternoon."
 },
 {
  "i": 107,
  "start": 250.15,
  "end": 252.08,
  "text": "He listens to your endless stories."
 },
 {
  "i": 108,
  "start": 252.87,
  "end": 253.91,
  "text": "He never once says..."
 },
 {
  "i": 109,
  "start": 254.31,
  "end": 254.93,
  "text": "hurry up."
 },
 {
  "i": 110,
  "start": 255.98,
  "end": 257.62,
  "text": "Years ago, you taught him a game."
 },
 {
  "i": 111,
  "start": 258.24,
  "end": 258.79,
  "text": "A whistle."
 },
 {
  "i": 112,
  "start": 259.34,
  "end": 259.97,
  "text": "Two notes."
 },
 {
  "i": 113,
  "start": 260.47,
  "end": 261.63,
  "text": "High, then low."
 },
 {
  "i": 114,
  "start": 262.34,
  "end": 263.82,
  "text": "It means: freeze."
 },
 {
  "i": 115,
  "start": 264.71,
  "end": 267.92,
  "text": "Whenever you whistle, he stops mid-step like a robot."
 },
 {
  "i": 116,
  "start": 268.89,
  "end": 270.0,
  "text": "Every single time."
 },
 {
  "i": 117,
  "start": 270.49,
  "end": 271.65,
  "text": "Even in the supermarket."
 },
 {
  "i": 118,
  "start": 272.53,
  "end": 273.03,
  "text": "Sam!"
 },
 {
  "i": 119,
  "start": 273.41,
  "end": 274.66,
  "text": "Not in the cereal aisle!"
 },
 {
  "i": 120,
  "start": 275.73,
  "end": 277.67,
  "text": "Robots don’t choose aisles, Theo."
 },
 {
  "i": 121,
  "start": 278.63,
  "end": 279.33,
  "text": "Sports day."
 },
 {
  "i": 122,
  "start": 279.75,
  "end": 280.94,
  "text": "The hundred-meter final."
 },
 {
  "i": 123,
  "start": 281.68,
  "end": 283.87,
  "text": "The track sits right beside the main road."
 },
 {
  "i": 124,
  "start": 284.65,
  "end": 286.15,
  "text": "Your whole family is watching."
 },
 {
  "i": 125,
  "start": 286.81,
  "end": 288.04,
  "text": "You crouch in the blocks."
 },
 {
  "i": 126,
  "start": 288.87,
  "end": 289.61,
  "text": "On your marks."
 },
 {
  "i": 127,
  "start": 290.06,
  "end": 290.47,
  "text": "Set."
 },
 {
  "i": 128,
  "start": 291.3,
  "end": 292.71,
  "text": "Your brain waits for the gun."
 },
 {
  "i": 129,
  "start": 293.33,
  "end": 293.83,
  "text": "And then..."
 },
 {
  "i": 130,
  "start": 294.32,
  "end": 294.9,
  "text": "you see it."
 },
 {
  "i": 131,
  "start": 295.77,
  "end": 298.04,
  "text": "A red ball bouncing through the open gate."
 },
 {
  "i": 132,
  "start": 298.72,
  "end": 300.25,
  "text": "And a small boy chasing it."
 },
 {
  "i": 133,
  "start": 300.92,
  "end": 301.44,
  "text": "Sam."
 },
 {
  "i": 134,
  "start": 302.25,
  "end": 303.99,
  "text": "Down the road comes a delivery truck."
 },
 {
  "i": 135,
  "start": 304.54,
  "end": 305.87,
  "text": "Fifty kilometers per hour."
 },
 {
  "i": 136,
  "start": 306.52,
  "end": 307.59,
  "text": "Forty meters away."
 },
 {
  "i": 137,
  "start": 308.15,
  "end": 309.26,
  "text": "Under three seconds."
 },
 {
  "i": 138,
  "start": 309.99,
  "end": 310.77,
  "text": "You do the math..."
 },
 {
  "i": 139,
  "start": 311.28,
  "end": 311.92,
  "text": "in a blink."
 },
 {
  "i": 140,
  "start": 312.64,
  "end": 314.29,
  "text": "You’re sixty meters from that gate."
 },
 {
  "i": 141,
  "start": 315.11,
  "end": 320.04,
  "text": "Even the fastest man in history needed over six seconds to cover sixty meters."
 },
 {
  "i": 142,
  "start": 320.8,
  "end": 321.68,
  "text": "You’d need eight."
 },
 {
  "i": 143,
  "start": 322.59,
  "end": 323.71,
  "text": "Your brain is fast."
 },
 {
  "i": 144,
  "start": 324.15,
  "end": 325.05,
  "text": "Your legs are not."
 },
 {
  "i": 145,
  "start": 325.89,
  "end": 326.78,
  "text": "You can’t reach him."
 },
 {
  "i": 146,
  "start": 327.36,
  "end": 328.65,
  "text": "And the gun hasn’t fired."
 },
 {
  "i": 147,
  "start": 329.53,
  "end": 330.27,
  "text": "Move now..."
 },
 {
  "i": 148,
  "start": 330.78,
  "end": 331.38,
  "text": "and you’re out."
 },
 {
  "i": 149,
  "start": 332.32,
  "end": 333.28,
  "text": "Months of training."
 },
 {
  "i": 150,
  "start": 333.66,
  "end": 334.08,
  "text": "Gone."
 },
 {
  "i": 151,
  "start": 334.87,
  "end": 335.38,
  "text": "The race..."
 },
 {
  "i": 152,
  "start": 336.01,
  "end": 336.73,
  "text": "or your brother."
 },
 {
  "i": 153,
  "start": 337.73,
  "end": 338.47,
  "text": "You stand up."
 },
 {
  "i": 154,
  "start": 338.86,
  "end": 339.67,
  "text": "Before the gun."
 },
 {
  "i": 155,
  "start": 340.48,
  "end": 341.79,
  "text": "The crowd groans."
 },
 {
  "i": 156,
  "start": 342.56,
  "end": 343.41,
  "text": "False start."
 },
 {
  "i": 157,
  "start": 344.2,
  "end": 345.06,
  "text": "But you don’t run."
 },
 {
  "i": 158,
  "start": 345.77,
  "end": 346.77,
  "text": "Running won’t work."
 },
 {
  "i": 159,
  "start": 347.46,
  "end": 348.57,
  "text": "Instead, you whistle."
 },
 {
  "i": 160,
  "start": 349.36,
  "end": 349.97,
  "text": "Two notes."
 },
 {
  "i": 161,
  "start": 350.45,
  "end": 351.79,
  "text": "High, then low."
 },
 {
  "i": 162,
  "start": 352.71,
  "end": 356.07,
  "text": "Sound travels at about three hundred and forty meters per second."
 },
 {
  "i": 163,
  "start": 356.85,
  "end": 359.39,
  "text": "It reaches Sam in less than a fifth of a second."
 },
 {
  "i": 164,
  "start": 360.31,
  "end": 361.7,
  "text": "You watch the sound arrive."
 },
 {
  "i": 165,
  "start": 362.32,
  "end": 363.33,
  "text": "You watch him hear it."
 },
 {
  "i": 166,
  "start": 364.02,
  "end": 364.65,
  "text": "And Sam..."
 },
 {
  "i": 167,
  "start": 364.93,
  "end": 365.57,
  "text": "freezes."
 },
 {
  "i": 168,
  "start": 366.49,
  "end": 367.49,
  "text": "One foot in the air."
 },
 {
  "i": 169,
  "start": 367.86,
  "end": 368.78,
  "text": "Right at the curb."
 },
 {
  "i": 170,
  "start": 369.6,
  "end": 370.99,
  "text": "The truck rushes past."
 },
 {
  "i": 171,
  "start": 371.43,
  "end": 373.15,
  "text": "The ball rolls under its wheels."
 },
 {
  "i": 172,
  "start": 373.77,
  "end": 374.1,
  "text": "Pop."
 },
 {
  "i": 173,
  "start": 374.71,
  "end": 375.34,
  "text": "Silence."
 },
 {
  "i": 174,
  "start": 376.23,
  "end": 377.63,
  "text": "Then Sam turns around..."
 },
 {
  "i": 175,
  "start": 378.16,
  "end": 378.85,
  "text": "and waves."
 },
 {
  "i": 176,
  "start": 379.74,
  "end": 381.06,
  "text": "The whole stadium saw it."
 },
 {
  "i": 177,
  "start": 381.92,
  "end": 383.14,
  "text": "Coach Lee walks over."
 },
 {
  "i": 178,
  "start": 383.84,
  "end": 385.39,
  "text": "You know you’re disqualified, right?"
 },
 {
  "i": 179,
  "start": 386.44,
  "end": 386.95,
  "text": "I know."
 },
 {
  "i": 180,
  "start": 387.41,
  "end": 388.56,
  "text": "Fast doesn’t matter."
 },
 {
  "i": 181,
  "start": 389.19,
  "end": 390.26,
  "text": "On time does."
 },
 {
  "i": 182,
  "start": 391.23,
  "end": 392.19,
  "text": "Mia is crying."
 },
 {
  "i": 183,
  "start": 392.75,
  "end": 393.74,
  "text": "Your mom is running."
 },
 {
  "i": 184,
  "start": 394.23,
  "end": 396.14,
  "text": "And Sam crashes into your arms."
 },
 {
  "i": 185,
  "start": 397.02,
  "end": 400.48,
  "text": "For once, you don’t mind that every second lasts so long."
 },
 {
  "i": 186,
  "start": 401.18,
  "end": 402.02,
  "text": "You want this one..."
 },
 {
  "i": 187,
  "start": 402.61,
  "end": 403.56,
  "text": "to last forever."
 },
 {
  "i": 188,
  "start": 404.76,
  "end": 407.26,
  "text": "That night, a letter slides under your door."
 },
 {
  "i": 189,
  "start": 408.04,
  "end": 408.64,
  "text": "No name."
 },
 {
  "i": 190,
  "start": 408.99,
  "end": 409.89,
  "text": "Just one line."
 },
 {
  "i": 191,
  "start": 410.8,
  "end": 412.43,
  "text": "‘We saw what you did on that road."
 },
 {
  "i": 192,
  "start": 412.96,
  "end": 414.1,
  "text": "We would like to test you.’"
 },
 {
  "i": 193,
  "start": 415.13,
  "end": 416.24,
  "text": "Is any of this real?"
 },
 {
  "i": 194,
  "start": 416.97,
  "end": 417.48,
  "text": "Partly."
 },
 {
  "i": 195,
  "start": 418.08,
  "end": 421.79,
  "text": "Human visual reaction really sits around a quarter of a second."
 },
 {
  "i": 196,
  "start": 422.64,
  "end": 427.14,
  "text": "Sprinting really does treat anything under a tenth of a second as a false start."
 },
 {
  "i": 197,
  "start": 427.99,
  "end": 430.44,
  "text": "And some animals really do see faster than us."
 },
 {
  "i": 198,
  "start": 431.19,
  "end": 437.84,
  "text": "Houseflies notice flicker that looks like smooth light to you, which helps explain why they’re so hard to swat."
 },
 {
  "i": 199,
  "start": 438.79,
  "end": 441.13,
  "text": "But a human brain a hundred times faster?"
 },
 {
  "i": 200,
  "start": 442.03,
  "end": 444.35,
  "text": "Your nerves are simply too slow to keep up."
 },
 {
  "i": 201,
  "start": 445.22,
  "end": 448.69,
  "text": "So could anything ever make human reflexes truly instant?"
 },
 {
  "i": 202,
  "start": 449.58,
  "end": 450.28,
  "text": "What do you think?"
 },
 {
  "i": 203,
  "start": 451.2,
  "end": 454.91,
  "text": "Tell us in the comments, and tell us which superpower we should do next."
 },
 {
  "i": 204,
  "start": 455.66,
  "end": 458.27,
  "text": "Hit like, and subscribe for more What Ifs."
 }
]