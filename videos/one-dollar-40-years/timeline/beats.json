[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.4,
  "speechEnd": 6.353,
  "text": "Your phone buzzes at three in the morning. It's your mom. Her voice is shaking. Sam...",
  "end": 6.804
 },
 {
  "i": 1,
  "start": 6.804,
  "speechStart": 6.954,
  "speechEnd": 8.738,
  "text": "they took it. All of it.",
  "end": 8.928
 },
 {
  "i": 2,
  "start": 8.928,
  "speechStart": 9.078,
  "speechEnd": 10.777,
  "text": "You open your investing app.",
  "end": 10.971
 },
 {
  "i": 3,
  "start": 10.971,
  "speechStart": 11.121,
  "speechEnd": 12.877,
  "text": "One number glows on the screen.",
  "end": 13.081
 },
 {
  "i": 4,
  "start": 13.081,
  "speechStart": 13.231,
  "speechEnd": 16.378,
  "text": "Thirty-three years of your life... in one number.",
  "end": 16.584
 },
 {
  "i": 5,
  "start": 16.584,
  "speechStart": 16.734,
  "speechEnd": 20.179,
  "text": "Your thumb hovers over one word. 'Withdraw.' Press it...",
  "end": 20.604
 },
 {
  "i": 6,
  "start": 20.604,
  "speechStart": 20.754,
  "speechEnd": 23.916,
  "text": "and that money stops growing forever. Don't press it...",
  "end": 24.339
 },
 {
  "i": 7,
  "start": 24.339,
  "speechStart": 24.489,
  "speechEnd": 29.081,
  "text": "and your mom loses her home. How did one dollar... lead to this?",
  "end": 29.412
 },
 {
  "i": 8,
  "start": 29.412,
  "speechStart": 29.562,
  "speechEnd": 31.011,
  "text": "Thirty-three years earlier...",
  "end": 31.455
 },
 {
  "i": 9,
  "start": 31.455,
  "speechStart": 31.605,
  "speechEnd": 36.067,
  "text": "it started with a glass jar. Your name is Sam. You're twenty-five.",
  "end": 36.291
 },
 {
  "i": 10,
  "start": 36.291,
  "speechStart": 36.441,
  "speechEnd": 41.125,
  "text": "And your mom just handed you a glass jar. Inside? One dollar.",
  "end": 41.335
 },
 {
  "i": 11,
  "start": 41.335,
  "speechStart": 41.485,
  "speechEnd": 42.894,
  "text": "One dollar a day, kid.",
  "end": 43.089
 },
 {
  "i": 12,
  "start": 43.089,
  "speechStart": 43.239,
  "speechEnd": 45.985,
  "text": "Into the stock market. Every single day.",
  "end": 46.182
 },
 {
  "i": 13,
  "start": 46.182,
  "speechStart": 46.332,
  "speechEnd": 52.76,
  "text": "Your best friend Max laughs. Dude. That's not investing. That's a tip jar. Fair.",
  "end": 52.976
 },
 {
  "i": 14,
  "start": 52.976,
  "speechStart": 53.126,
  "speechEnd": 54.791,
  "text": "A dollar is less than a coffee.",
  "end": 54.992
 },
 {
  "i": 15,
  "start": 54.992,
  "speechStart": 55.142,
  "speechEnd": 56.521,
  "text": "A whole year of dollars?",
  "end": 56.858
 },
 {
  "i": 16,
  "start": 56.858,
  "speechStart": 57.008,
  "speechEnd": 59.685,
  "text": "Three hundred sixty-five. Forty years?",
  "end": 60.023
 },
 {
  "i": 17,
  "start": 60.023,
  "speechStart": 60.173,
  "speechEnd": 62.908,
  "text": "Fourteen thousand six hundred. That's it.",
  "end": 63.1
 },
 {
  "i": 18,
  "start": 63.1,
  "speechStart": 63.25,
  "speechEnd": 66.558,
  "text": "That's everything you'll ever put in. But there's one rule.",
  "end": 66.754
 },
 {
  "i": 19,
  "start": 66.754,
  "speechStart": 66.904,
  "speechEnd": 69.243,
  "text": "The money only grows if you leave it alone.",
  "end": 69.442
 },
 {
  "i": 20,
  "start": 69.442,
  "speechStart": 69.592,
  "speechEnd": 73.594,
  "text": "Every dollar you pull out... stops growing. Forever.",
  "end": 73.817
 },
 {
  "i": 21,
  "start": 73.817,
  "speechStart": 73.967,
  "speechEnd": 77.162,
  "text": "You can buy almost anything back. Except time.",
  "end": 77.369
 },
 {
  "i": 22,
  "start": 77.369,
  "speechStart": 77.519,
  "speechEnd": 83.103,
  "text": "So what if you invested one dollar every day... for forty years? Year one.",
  "end": 83.301
 },
 {
  "i": 23,
  "start": 83.301,
  "speechStart": 83.451,
  "speechEnd": 84.601,
  "text": "You check the account.",
  "end": 84.806
 },
 {
  "i": 24,
  "start": 84.806,
  "speechStart": 84.956,
  "speechEnd": 86.706,
  "text": "About three hundred eighty dollars.",
  "end": 86.911
 },
 {
  "i": 25,
  "start": 86.911,
  "speechStart": 87.061,
  "speechEnd": 88.28,
  "text": "Your money earned you...",
  "end": 88.708
 },
 {
  "i": 26,
  "start": 88.708,
  "speechStart": 88.858,
  "speechEnd": 90.208,
  "text": "roughly fifteen bucks.",
  "end": 90.412
 },
 {
  "i": 27,
  "start": 90.412,
  "speechStart": 90.562,
  "speechEnd": 95.501,
  "text": "Max holds up a pizza. I earned this today. Also fair. Plus:",
  "end": 95.645
 },
 {
  "i": 28,
  "start": 95.645,
  "speechStart": 95.795,
  "speechEnd": 97.28,
  "text": "you don't have to pick stocks.",
  "end": 97.48
 },
 {
  "i": 29,
  "start": 97.48,
  "speechStart": 97.63,
  "speechEnd": 99.008,
  "text": "You buy an index fund.",
  "end": 99.206
 },
 {
  "i": 30,
  "start": 99.206,
  "speechStart": 99.356,
  "speechEnd": 100.604,
  "text": "One tiny slice...",
  "end": 101.053
 },
 {
  "i": 31,
  "start": 101.053,
  "speechStart": 101.203,
  "speechEnd": 105.372,
  "text": "of five hundred of America's biggest companies. All at once.",
  "end": 105.573
 },
 {
  "i": 32,
  "start": 105.573,
  "speechStart": 105.723,
  "speechEnd": 107.095,
  "text": "You set it to automatic.",
  "end": 107.31
 },
 {
  "i": 33,
  "start": 107.31,
  "speechStart": 107.46,
  "speechEnd": 111.139,
  "text": "And then you forget about it. Year three. Still boring.",
  "end": 111.35
 },
 {
  "i": 34,
  "start": 111.35,
  "speechStart": 111.5,
  "speechEnd": 113.953,
  "text": "This is where most people quit. Why?",
  "end": 114.294
 },
 {
  "i": 35,
  "start": 114.294,
  "speechStart": 114.444,
  "speechEnd": 116.538,
  "text": "Because the growth is too small to feel.",
  "end": 116.732
 },
 {
  "i": 36,
  "start": 116.732,
  "speechStart": 116.882,
  "speechEnd": 118.663,
  "text": "Your brain wants rewards now.",
  "end": 118.858
 },
 {
  "i": 37,
  "start": 118.858,
  "speechStart": 119.008,
  "speechEnd": 121.569,
  "text": "Not in four decades. Year five.",
  "end": 121.776
 },
 {
  "i": 38,
  "start": 121.776,
  "speechStart": 121.926,
  "speechEnd": 127.713,
  "text": "Max buys a new car. Shiny. Loud. You buy... one more dollar.",
  "end": 127.919
 },
 {
  "i": 39,
  "start": 127.919,
  "speechStart": 128.069,
  "speechEnd": 128.876,
  "text": "He grins.",
  "end": 129.091
 },
 {
  "i": 40,
  "start": 129.091,
  "speechStart": 129.241,
  "speechEnd": 133.546,
  "text": "You're gonna be rich at ninety, bro. Maybe. But you notice something.",
  "end": 133.756
 },
 {
  "i": 41,
  "start": 133.756,
  "speechStart": 133.906,
  "speechEnd": 135.598,
  "text": "Your account isn't just growing.",
  "end": 135.804
 },
 {
  "i": 42,
  "start": 135.804,
  "speechStart": 135.954,
  "speechEnd": 138.955,
  "text": "It's growing faster each year. Here's the secret.",
  "end": 139.158
 },
 {
  "i": 43,
  "start": 139.158,
  "speechStart": 139.308,
  "speechEnd": 144.321,
  "text": "Over the long run, the US stock market has averaged around ten percent a year.",
  "end": 144.52
 },
 {
  "i": 44,
  "start": 144.52,
  "speechStart": 144.67,
  "speechEnd": 147.293,
  "text": "And there's a shortcut called the rule of seventy-two.",
  "end": 147.51
 },
 {
  "i": 45,
  "start": 147.51,
  "speechStart": 147.66,
  "speechEnd": 149.716,
  "text": "Divide seventy-two by your return.",
  "end": 149.923
 },
 {
  "i": 46,
  "start": 149.923,
  "speechStart": 150.073,
  "speechEnd": 153.298,
  "text": "Seventy-two divided by ten? About seven.",
  "end": 153.507
 },
 {
  "i": 47,
  "start": 153.507,
  "speechStart": 153.657,
  "speechEnd": 160.354,
  "text": "That's roughly how many years it takes your money to double. Then double again. Then again. Year ten.",
  "end": 160.554
 },
 {
  "i": 48,
  "start": 160.554,
  "speechStart": 160.704,
  "speechEnd": 163.739,
  "text": "You've put in three thousand six hundred fifty dollars.",
  "end": 163.947
 },
 {
  "i": 49,
  "start": 163.947,
  "speechStart": 164.097,
  "speechEnd": 166.064,
  "text": "The account says almost six thousand.",
  "end": 166.274
 },
 {
  "i": 50,
  "start": 166.274,
  "speechStart": 166.424,
  "speechEnd": 171.81,
  "text": "The extra two thousand? You didn't earn it. Your money did. While you slept.",
  "end": 172.009
 },
 {
  "i": 51,
  "start": 172.009,
  "speechStart": 172.159,
  "speechEnd": 177.747,
  "text": "That's when Max finally starts. He's thirty-five. Same dollar. Same market.",
  "end": 177.959
 },
 {
  "i": 52,
  "start": 177.959,
  "speechStart": 178.109,
  "speechEnd": 179.222,
  "text": "Just ten years late.",
  "end": 179.417
 },
 {
  "i": 53,
  "start": 179.417,
  "speechStart": 179.567,
  "speechEnd": 182.439,
  "text": "Here's the brutal part. If he never stops...",
  "end": 182.878
 },
 {
  "i": 54,
  "start": 182.878,
  "speechStart": 183.028,
  "speechEnd": 186.457,
  "text": "he'll reach sixty-five with about sixty thousand. You?",
  "end": 186.798
 },
 {
  "i": 55,
  "start": 186.798,
  "speechStart": 186.948,
  "speechEnd": 190.205,
  "text": "About one hundred sixty thousand. Ten years late...",
  "end": 190.641
 },
 {
  "i": 56,
  "start": 190.641,
  "speechStart": 190.791,
  "speechEnd": 195.66,
  "text": "could cost him a hundred thousand dollars. Wait... just ten years?",
  "end": 195.996
 },
 {
  "i": 57,
  "start": 195.996,
  "speechStart": 196.146,
  "speechEnd": 197.655,
  "text": "Why does that hurt so much?",
  "end": 197.98
 },
 {
  "i": 58,
  "start": 197.98,
  "speechStart": 198.13,
  "speechEnd": 199.593,
  "text": "Because the biggest growth...",
  "end": 200.032
 },
 {
  "i": 59,
  "start": 200.032,
  "speechStart": 200.182,
  "speechEnd": 205.32,
  "text": "happens at the very end. Minus: year twelve. The market crashes.",
  "end": 205.533
 },
 {
  "i": 60,
  "start": 205.533,
  "speechStart": 205.683,
  "speechEnd": 208.15,
  "text": "Your account drops by a third in a few weeks.",
  "end": 208.348
 },
 {
  "i": 61,
  "start": 208.348,
  "speechStart": 208.498,
  "speechEnd": 212.927,
  "text": "Max calls you, panicking. Sell! Sell everything! You?",
  "end": 213.268
 },
 {
  "i": 62,
  "start": 213.268,
  "speechStart": 213.418,
  "speechEnd": 214.818,
  "text": "You keep feeding the jar.",
  "end": 215.01
 },
 {
  "i": 63,
  "start": 215.01,
  "speechStart": 215.16,
  "speechEnd": 216.633,
  "text": "Because when prices fall...",
  "end": 217.067
 },
 {
  "i": 64,
  "start": 217.067,
  "speechStart": 217.217,
  "speechEnd": 219.721,
  "text": "your dollar buys more. Months later...",
  "end": 220.162
 },
 {
  "i": 65,
  "start": 220.162,
  "speechStart": 220.312,
  "speechEnd": 222.009,
  "text": "the market starts climbing back.",
  "end": 222.204
 },
 {
  "i": 66,
  "start": 222.204,
  "speechStart": 222.354,
  "speechEnd": 223.712,
  "text": "Max sold near the bottom.",
  "end": 223.915
 },
 {
  "i": 67,
  "start": 223.915,
  "speechStart": 224.065,
  "speechEnd": 226.564,
  "text": "He missed the whole recovery. The catch?",
  "end": 226.899
 },
 {
  "i": 68,
  "start": 226.899,
  "speechStart": 227.049,
  "speechEnd": 228.306,
  "text": "Crashes bring sharks.",
  "end": 228.513
 },
 {
  "i": 69,
  "start": 228.513,
  "speechStart": 228.663,
  "speechEnd": 230.658,
  "text": "A stranger online named Mr.",
  "end": 230.544
 },
 {
  "i": 70,
  "start": 230.544,
  "speechStart": 230.694,
  "speechEnd": 232.788,
  "text": "Black slides into your messages.",
  "end": 233.008
 },
 {
  "i": 71,
  "start": 233.008,
  "speechStart": 233.158,
  "speechEnd": 238.443,
  "text": "Guaranteed twenty percent. Every month. Zero risk. You do the math.",
  "end": 238.638
 },
 {
  "i": 72,
  "start": 238.638,
  "speechStart": 238.788,
  "speechEnd": 244.663,
  "text": "Twenty percent a month turns one dollar into almost nine in a single year. Nobody does that.",
  "end": 244.861
 },
 {
  "i": 73,
  "start": 244.861,
  "speechStart": 245.011,
  "speechEnd": 248.551,
  "text": "Nobody honest. You block him. Real rule:",
  "end": 248.689
 },
 {
  "i": 74,
  "start": 248.689,
  "speechStart": 248.839,
  "speechEnd": 252.082,
  "text": "if someone guarantees huge returns with no risk...",
  "end": 252.522
 },
 {
  "i": 75,
  "start": 252.522,
  "speechStart": 252.672,
  "speechEnd": 255.446,
  "text": "it's almost always a scam. Year twenty.",
  "end": 255.66
 },
 {
  "i": 76,
  "start": 255.66,
  "speechStart": 255.81,
  "speechEnd": 257.411,
  "text": "Twenty-one thousand dollars.",
  "end": 257.622
 },
 {
  "i": 77,
  "start": 257.622,
  "speechStart": 257.772,
  "speechEnd": 264.164,
  "text": "You've only put in seven thousand three hundred. The rest? Pure growth. Year twenty-five.",
  "end": 264.396
 },
 {
  "i": 78,
  "start": 264.396,
  "speechStart": 264.546,
  "speechEnd": 266.048,
  "text": "About thirty-six thousand.",
  "end": 266.264
 },
 {
  "i": 79,
  "start": 266.264,
  "speechStart": 266.414,
  "speechEnd": 271.008,
  "text": "Now, in one good year, your money can earn around three thousand six hundred.",
  "end": 271.218
 },
 {
  "i": 80,
  "start": 271.218,
  "speechStart": 271.368,
  "speechEnd": 274.615,
  "text": "That's ten years of your dollars... in twelve months.",
  "end": 274.822
 },
 {
  "i": 81,
  "start": 274.822,
  "speechStart": 274.972,
  "speechEnd": 277.282,
  "text": "Max squints at your screen. Wait.",
  "end": 277.496
 },
 {
  "i": 82,
  "start": 277.496,
  "speechStart": 277.646,
  "speechEnd": 281.325,
  "text": "It's doing your job now? Yeah. It kind of is.",
  "end": 281.516
 },
 {
  "i": 83,
  "start": 281.516,
  "speechStart": 281.666,
  "speechEnd": 283.391,
  "text": "But where it gets really crazy...",
  "end": 283.826
 },
 {
  "i": 84,
  "start": 283.826,
  "speechStart": 283.976,
  "speechEnd": 286.505,
  "text": "is the end of the plan. Year thirty.",
  "end": 286.719
 },
 {
  "i": 85,
  "start": 286.719,
  "speechStart": 286.869,
  "speechEnd": 289.521,
  "text": "About sixty thousand. Year forty?",
  "end": 289.861
 },
 {
  "i": 86,
  "start": 289.861,
  "speechStart": 290.011,
  "speechEnd": 291.89,
  "text": "About one hundred sixty thousand.",
  "end": 292.103
 },
 {
  "i": 87,
  "start": 292.103,
  "speechStart": 292.253,
  "speechEnd": 294.122,
  "text": "The last ten years make more money...",
  "end": 294.556
 },
 {
  "i": 88,
  "start": 294.556,
  "speechStart": 294.706,
  "speechEnd": 300.918,
  "text": "than the first thirty combined. That's compounding. Slow. And slow. And slow.",
  "end": 301.124
 },
 {
  "i": 89,
  "start": 301.124,
  "speechStart": 301.274,
  "speechEnd": 303.421,
  "text": "And then... suddenly not.",
  "end": 303.618
 },
 {
  "i": 90,
  "start": 303.618,
  "speechStart": 303.768,
  "speechEnd": 306.338,
  "text": "And if it were ten dollars a day instead of one?",
  "end": 306.659
 },
 {
  "i": 91,
  "start": 306.659,
  "speechStart": 306.809,
  "speechEnd": 308.348,
  "text": "Over one point six million.",
  "end": 308.557
 },
 {
  "i": 92,
  "start": 308.557,
  "speechStart": 308.707,
  "speechEnd": 313.131,
  "text": "And there's a price nobody mentions. It's boring. For decades.",
  "end": 313.353
 },
 {
  "i": 93,
  "start": 313.353,
  "speechStart": 313.503,
  "speechEnd": 315.447,
  "text": "Friends buy a new phone every year.",
  "end": 315.642
 },
 {
  "i": 94,
  "start": 315.642,
  "speechStart": 315.792,
  "speechEnd": 318.212,
  "text": "You keep the old one... again.",
  "end": 318.434
 },
 {
  "i": 95,
  "start": 318.434,
  "speechStart": 318.584,
  "speechEnd": 319.883,
  "text": "People call you cheap.",
  "end": 320.085
 },
 {
  "i": 96,
  "start": 320.085,
  "speechStart": 320.235,
  "speechEnd": 322.028,
  "text": "And your brain fights you every day.",
  "end": 322.217
 },
 {
  "i": 97,
  "start": 322.217,
  "speechStart": 322.367,
  "speechEnd": 324.78,
  "text": "Humans are wired to grab rewards now.",
  "end": 324.976
 },
 {
  "i": 98,
  "start": 324.976,
  "speechStart": 325.126,
  "speechEnd": 326.698,
  "text": "A dollar today feels real.",
  "end": 326.896
 },
 {
  "i": 99,
  "start": 326.896,
  "speechStart": 327.046,
  "speechEnd": 329.686,
  "text": "A dollar in forty years feels like a rumor.",
  "end": 329.889
 },
 {
  "i": 100,
  "start": 329.889,
  "speechStart": 330.039,
  "speechEnd": 332.475,
  "text": "And there's another catch. Inflation.",
  "end": 332.715
 },
 {
  "i": 101,
  "start": 332.715,
  "speechStart": 332.865,
  "speechEnd": 338.3,
  "text": "US prices have risen around three percent a year on average over the long run.",
  "end": 338.498
 },
 {
  "i": 102,
  "start": 338.498,
  "speechStart": 338.648,
  "speechEnd": 341.81,
  "text": "At that pace, prices roughly triple in forty years.",
  "end": 342.013
 },
 {
  "i": 103,
  "start": 342.013,
  "speechStart": 342.163,
  "speechEnd": 345.623,
  "text": "So your one hundred sixty thousand? In today's money...",
  "end": 346.062
 },
 {
  "i": 104,
  "start": 346.062,
  "speechStart": 346.212,
  "speechEnd": 352.045,
  "text": "it buys closer to fifty thousand. Still big. Just... smaller than it looks.",
  "end": 352.244
 },
 {
  "i": 105,
  "start": 352.244,
  "speechStart": 352.394,
  "speechEnd": 354.972,
  "text": "Through all of it... there's your mom.",
  "end": 355.165
 },
 {
  "i": 106,
  "start": 355.165,
  "speechStart": 355.315,
  "speechEnd": 356.65,
  "text": "Every Sunday, you visit.",
  "end": 356.85
 },
 {
  "i": 107,
  "start": 356.85,
  "speechStart": 357.0,
  "speechEnd": 359.449,
  "text": "Every Sunday, she asks the same question.",
  "end": 359.663
 },
 {
  "i": 108,
  "start": 359.663,
  "speechStart": 359.813,
  "speechEnd": 361.123,
  "text": "Still feeding the jar?",
  "end": 361.447
 },
 {
  "i": 109,
  "start": 361.447,
  "speechStart": 361.597,
  "speechEnd": 362.935,
  "text": "Still feeding the jar.",
  "end": 363.129
 },
 {
  "i": 110,
  "start": 363.129,
  "speechStart": 363.279,
  "speechEnd": 365.713,
  "text": "The old glass jar sits on your shelf now.",
  "end": 365.906
 },
 {
  "i": 111,
  "start": 365.906,
  "speechStart": 366.056,
  "speechEnd": 369.407,
  "text": "Taped to it is her note. 'One a day. Don't touch.'",
  "end": 369.288
 },
 {
  "i": 112,
  "start": 369.288,
  "speechStart": 369.438,
  "speechEnd": 372.617,
  "text": "There's writing on the back too. You've never read it.",
  "end": 372.805
 },
 {
  "i": 113,
  "start": 372.805,
  "speechStart": 372.955,
  "speechEnd": 375.859,
  "text": "Her handwriting is terrible. And honestly...",
  "end": 376.318
 },
 {
  "i": 114,
  "start": 376.318,
  "speechStart": 376.468,
  "speechEnd": 378.185,
  "text": "you're scared it says something sad.",
  "end": 378.374
 },
 {
  "i": 115,
  "start": 378.374,
  "speechStart": 378.524,
  "speechEnd": 380.783,
  "text": "Your mom worked thirty years in a factory.",
  "end": 380.989
 },
 {
  "i": 116,
  "start": 380.989,
  "speechStart": 381.139,
  "speechEnd": 383.302,
  "text": "She never invested a single dollar.",
  "end": 383.51
 },
 {
  "i": 117,
  "start": 383.51,
  "speechStart": 383.66,
  "speechEnd": 385.488,
  "text": "That's why I'm telling you, she says.",
  "end": 385.681
 },
 {
  "i": 118,
  "start": 385.681,
  "speechStart": 385.831,
  "speechEnd": 387.245,
  "text": "So you don't end up like me.",
  "end": 387.431
 },
 {
  "i": 119,
  "start": 387.431,
  "speechStart": 387.581,
  "speechEnd": 389.761,
  "text": "Max still teases you. Dude.",
  "end": 389.982
 },
 {
  "i": 120,
  "start": 389.982,
  "speechStart": 390.132,
  "speechEnd": 396.273,
  "text": "You're the richest broke guy I know. Year thirty-three. Three in the morning. Your phone buzzes.",
  "end": 396.482
 },
 {
  "i": 121,
  "start": 396.482,
  "speechStart": 396.632,
  "speechEnd": 398.583,
  "text": "Sam... they took it.",
  "end": 398.772
 },
 {
  "i": 122,
  "start": 398.772,
  "speechStart": 398.922,
  "speechEnd": 400.155,
  "text": "A man called your mom.",
  "end": 400.346
 },
 {
  "i": 123,
  "start": 400.346,
  "speechStart": 400.496,
  "speechEnd": 402.153,
  "text": "He said he was from her bank.",
  "end": 402.349
 },
 {
  "i": 124,
  "start": 402.349,
  "speechStart": 402.499,
  "speechEnd": 404.028,
  "text": "He said her account was hacked.",
  "end": 404.228
 },
 {
  "i": 125,
  "start": 404.228,
  "speechStart": 404.378,
  "speechEnd": 407.926,
  "text": "He said to move everything into a 'safe account'. Right now.",
  "end": 408.125
 },
 {
  "i": 126,
  "start": 408.125,
  "speechStart": 408.275,
  "speechEnd": 410.794,
  "text": "Before the hackers did. So she did.",
  "end": 410.994
 },
 {
  "i": 127,
  "start": 410.994,
  "speechStart": 411.144,
  "speechEnd": 412.669,
  "text": "Fifteen thousand dollars.",
  "end": 412.882
 },
 {
  "i": 128,
  "start": 412.882,
  "speechStart": 413.032,
  "speechEnd": 414.376,
  "text": "Her whole life savings.",
  "end": 414.586
 },
 {
  "i": 129,
  "start": 414.586,
  "speechStart": 414.736,
  "speechEnd": 416.013,
  "text": "Gone in one phone call.",
  "end": 416.208
 },
 {
  "i": 130,
  "start": 416.208,
  "speechStart": 416.358,
  "speechEnd": 417.718,
  "text": "I'm so stupid, Sam.",
  "end": 417.916
 },
 {
  "i": 131,
  "start": 417.916,
  "speechStart": 418.066,
  "speechEnd": 419.383,
  "text": "You're not stupid, Mom.",
  "end": 419.576
 },
 {
  "i": 132,
  "start": 419.576,
  "speechStart": 419.726,
  "speechEnd": 420.997,
  "text": "They do this for a living.",
  "end": 421.195
 },
 {
  "i": 133,
  "start": 421.195,
  "speechStart": 421.345,
  "speechEnd": 423.959,
  "text": "Scammers make everything urgent on purpose...",
  "end": 424.408
 },
 {
  "i": 134,
  "start": 424.408,
  "speechStart": 424.558,
  "speechEnd": 425.929,
  "text": "so you don't stop to think.",
  "end": 426.126
 },
 {
  "i": 135,
  "start": 426.126,
  "speechStart": 426.276,
  "speechEnd": 430.655,
  "text": "And the payment on her little house is due in nine days. Miss it...",
  "end": 431.087
 },
 {
  "i": 136,
  "start": 431.087,
  "speechStart": 431.237,
  "speechEnd": 435.76,
  "text": "and she could lose the place she's lived in for forty years. You open the app.",
  "end": 435.954
 },
 {
  "i": 137,
  "start": 435.954,
  "speechStart": 436.104,
  "speechEnd": 437.678,
  "text": "Eighty-one thousand dollars.",
  "end": 437.889
 },
 {
  "i": 138,
  "start": 437.889,
  "speechStart": 438.039,
  "speechEnd": 439.701,
  "text": "The rule echoes in your head.",
  "end": 439.898
 },
 {
  "i": 139,
  "start": 439.898,
  "speechStart": 440.048,
  "speechEnd": 445.342,
  "text": "Every dollar you pull out... stops growing. Forever. You do the math.",
  "end": 445.537
 },
 {
  "i": 140,
  "start": 445.537,
  "speechStart": 445.687,
  "speechEnd": 447.282,
  "text": "Pull fifteen thousand now...",
  "end": 447.714
 },
 {
  "i": 141,
  "start": 447.714,
  "speechStart": 447.864,
  "speechEnd": 450.967,
  "text": "and in seven years, that money would have nearly doubled.",
  "end": 451.174
 },
 {
  "i": 142,
  "start": 451.174,
  "speechStart": 451.324,
  "speechEnd": 454.319,
  "text": "Almost thirty thousand dollars. Gone for good.",
  "end": 454.517
 },
 {
  "i": 143,
  "start": 454.517,
  "speechStart": 454.667,
  "speechEnd": 456.999,
  "text": "Max stares at the screen. Dude.",
  "end": 457.219
 },
 {
  "i": 144,
  "start": 457.219,
  "speechStart": 457.369,
  "speechEnd": 462.818,
  "text": "That's your retirement. You look at the jar. Thirty-three years. Never touched.",
  "end": 463.033
 },
 {
  "i": 145,
  "start": 463.033,
  "speechStart": 463.183,
  "speechEnd": 469.351,
  "text": "Not in the crash. Not for the phone. Not for the car. Not once. Your number...",
  "end": 469.792
 },
 {
  "i": 146,
  "start": 469.792,
  "speechStart": 469.942,
  "speechEnd": 470.806,
  "text": "or your mom.",
  "end": 471.002
 },
 {
  "i": 147,
  "start": 471.002,
  "speechStart": 471.152,
  "speechEnd": 472.41,
  "text": "You reach for the jar.",
  "end": 472.602
 },
 {
  "i": 148,
  "start": 472.602,
  "speechStart": 472.752,
  "speechEnd": 475.871,
  "text": "Your hand knocks the note loose. It flips over.",
  "end": 476.073
 },
 {
  "i": 149,
  "start": 476.073,
  "speechStart": 476.223,
  "speechEnd": 479.068,
  "text": "And for the first time... you read the back.",
  "end": 479.263
 },
 {
  "i": 150,
  "start": 479.263,
  "speechStart": 479.413,
  "speechEnd": 481.909,
  "text": "'Unless it's for someone you love.' You laugh.",
  "end": 482.109
 },
 {
  "i": 151,
  "start": 482.109,
  "speechStart": 482.259,
  "speechEnd": 483.468,
  "text": "Then you cry a little.",
  "end": 483.67
 },
 {
  "i": 152,
  "start": 483.67,
  "speechStart": 483.82,
  "speechEnd": 485.121,
  "text": "Then you press withdraw.",
  "end": 485.331
 },
 {
  "i": 153,
  "start": 485.331,
  "speechStart": 485.481,
  "speechEnd": 489.656,
  "text": "Fifteen thousand dollars. Out of your account. Into hers.",
  "end": 489.864
 },
 {
  "i": 154,
  "start": 489.864,
  "speechStart": 490.014,
  "speechEnd": 491.309,
  "text": "Your mom calls back.",
  "end": 491.509
 },
 {
  "i": 155,
  "start": 491.509,
  "speechStart": 491.659,
  "speechEnd": 493.46,
  "text": "Her voice isn't shaking anymore.",
  "end": 493.668
 },
 {
  "i": 156,
  "start": 493.668,
  "speechStart": 493.818,
  "speechEnd": 495.239,
  "text": "Then you do the second thing.",
  "end": 495.434
 },
 {
  "i": 157,
  "start": 495.434,
  "speechStart": 495.584,
  "speechEnd": 497.248,
  "text": "You still have the scammer's number.",
  "end": 497.446
 },
 {
  "i": 158,
  "start": 497.446,
  "speechStart": 497.596,
  "speechEnd": 499.048,
  "text": "You call her real bank.",
  "end": 499.246
 },
 {
  "i": 159,
  "start": 499.246,
  "speechStart": 499.396,
  "speechEnd": 500.885,
  "text": "You file a police report.",
  "end": 501.091
 },
 {
  "i": 160,
  "start": 501.091,
  "speechStart": 501.241,
  "speechEnd": 503.367,
  "text": "You warn every neighbor on her street.",
  "end": 503.57
 },
 {
  "i": 161,
  "start": 503.57,
  "speechStart": 503.72,
  "speechEnd": 508.215,
  "text": "Because real banks never ask you to move money to a 'safe account'. Ever.",
  "end": 508.426
 },
 {
  "i": 162,
  "start": 508.426,
  "speechStart": 508.576,
  "speechEnd": 512.319,
  "text": "Two weeks later, the same crew calls her neighbor. She hangs up.",
  "end": 512.51
 },
 {
  "i": 163,
  "start": 512.51,
  "speechStart": 512.66,
  "speechEnd": 515.274,
  "text": "Then she calls the police. Years pass.",
  "end": 515.481
 },
 {
  "i": 164,
  "start": 515.481,
  "speechStart": 515.631,
  "speechEnd": 518.443,
  "text": "At sixty-five, you check the app one last time.",
  "end": 518.641
 },
 {
  "i": 165,
  "start": 518.641,
  "speechStart": 518.791,
  "speechEnd": 520.563,
  "text": "Not one hundred sixty thousand.",
  "end": 520.777
 },
 {
  "i": 166,
  "start": 520.777,
  "speechStart": 520.927,
  "speechEnd": 525.103,
  "text": "About one hundred thirty. Less than the plan. More than enough.",
  "end": 525.307
 },
 {
  "i": 167,
  "start": 525.307,
  "speechStart": 525.457,
  "speechEnd": 527.044,
  "text": "Your mom is ninety now.",
  "end": 527.241
 },
 {
  "i": 168,
  "start": 527.241,
  "speechStart": 527.391,
  "speechEnd": 528.881,
  "text": "She raises a cup of tea.",
  "end": 529.074
 },
 {
  "i": 169,
  "start": 529.074,
  "speechStart": 529.224,
  "speechEnd": 532.712,
  "text": "One a day, she says. Don't touch. You smile.",
  "end": 532.921
 },
 {
  "i": 170,
  "start": 532.921,
  "speechStart": 533.071,
  "speechEnd": 534.725,
  "text": "Unless it's for someone you love.",
  "end": 534.919
 },
 {
  "i": 171,
  "start": 534.919,
  "speechStart": 535.069,
  "speechEnd": 540.299,
  "text": "Across the table, Max hands his granddaughter Mia a glass jar with one dollar inside.",
  "end": 540.506
 },
 {
  "i": 172,
  "start": 540.506,
  "speechStart": 540.656,
  "speechEnd": 542.305,
  "text": "And all those boring years...",
  "end": 542.743
 },
 {
  "i": 173,
  "start": 542.743,
  "speechStart": 542.893,
  "speechEnd": 548.322,
  "text": "finally feel worth it. So... is any of this real? Mostly, yes.",
  "end": 548.527
 },
 {
  "i": 174,
  "start": 548.527,
  "speechStart": 548.677,
  "speechEnd": 553.851,
  "text": "The S&P 500, a measure of five hundred big US companies,",
  "end": 553.762
 },
 {
  "i": 175,
  "start": 553.762,
  "speechStart": 553.912,
  "speechEnd": 560.154,
  "text": "has averaged roughly ten percent a year over the long run, with dividends reinvested.",
  "end": 560.389
 },
 {
  "i": 176,
  "start": 560.389,
  "speechStart": 560.539,
  "speechEnd": 562.527,
  "text": "But that's an average, not a promise.",
  "end": 562.733
 },
 {
  "i": 177,
  "start": 562.733,
  "speechStart": 562.883,
  "speechEnd": 567.343,
  "text": "In 2008, it fell about thirty-seven percent in a single year.",
  "end": 567.542
 },
 {
  "i": 178,
  "start": 567.542,
  "speechStart": 567.692,
  "speechEnd": 570.892,
  "text": "And past returns never guarantee future ones.",
  "end": 571.096
 },
 {
  "i": 179,
  "start": 571.096,
  "speechStart": 571.246,
  "speechEnd": 576.176,
  "text": "The first index fund for everyday investors launched in 1976,",
  "end": 576.131
 },
 {
  "i": 180,
  "start": 576.131,
  "speechStart": 576.281,
  "speechEnd": 579.288,
  "text": "started by John Bogle. Fees matter too.",
  "end": 579.486
 },
 {
  "i": 181,
  "start": 579.486,
  "speechStart": 579.636,
  "speechEnd": 582.482,
  "text": "Lose just one extra percent a year to fees...",
  "end": 582.92
 },
 {
  "i": 182,
  "start": 582.92,
  "speechStart": 583.07,
  "speechEnd": 588.073,
  "text": "and your one hundred sixty thousand shrinks to about one hundred twenty-three thousand.",
  "end": 588.287
 },
 {
  "i": 183,
  "start": 588.287,
  "speechStart": 588.437,
  "speechEnd": 591.481,
  "text": "This isn't financial advice. It's just math.",
  "end": 591.679
 },
 {
  "i": 184,
  "start": 591.679,
  "speechStart": 591.829,
  "speechEnd": 594.871,
  "text": "So if time is the most powerful force in investing...",
  "end": 595.325
 },
 {
  "i": 185,
  "start": 595.325,
  "speechStart": 595.475,
  "speechEnd": 597.935,
  "text": "what does waiting one more year really cost you?",
  "end": 598.256
 },
 {
  "i": 186,
  "start": 598.256,
  "speechStart": 598.406,
  "speechEnd": 603.634,
  "text": "That night, your phone rings again. Unknown number. You pick up. Silence.",
  "end": 603.862
 },
 {
  "i": 187,
  "start": 603.862,
  "speechStart": 604.012,
  "speechEnd": 606.544,
  "text": "Then a calm voice says your name. Sam.",
  "end": 606.762
 },
 {
  "i": 188,
  "start": 606.762,
  "speechStart": 606.912,
  "speechEnd": 611.544,
  "text": "You cost my team a lot of money. It's Mr. Black. What do you think?",
  "end": 611.87
 },
 {
  "i": 189,
  "start": 611.87,
  "speechStart": 612.02,
  "speechEnd": 616.129,
  "text": "Tell us in the comments, and tell us which money What If we should do next.",
  "end": 616.324
 },
 {
  "i": 190,
  "start": 616.324,
  "speechStart": 616.474,
  "speechEnd": 618.443,
  "text": "And if that note on the jar got you...",
  "end": 618.87
 },
 {
  "i": 191,
  "start": 618.87,
  "speechStart": 619.02,
  "speechEnd": 621.143,
  "text": "hit like, and subscribe for Part Two.",
  "end": 622.643
 }
]