[
 {
  "i": 0,
  "start": 0.2,
  "end": 1.44,
  "text": "A busy street at dusk."
 },
 {
  "i": 1,
  "start": 1.76,
  "end": 2.38,
  "text": "Headlights."
 },
 {
  "i": 2,
  "start": 2.6,
  "end": 3.14,
  "text": "A bus."
 },
 {
  "i": 3,
  "start": 3.53,
  "end": 6.8,
  "text": "A girl on a bicycle, front wheel already over the curb."
 },
 {
  "i": 4,
  "start": 7.19,
  "end": 7.66,
  "text": "And then..."
 },
 {
  "i": 5,
  "start": 8.02,
  "end": 9.04,
  "text": "everything stops."
 },
 {
  "i": 6,
  "start": 9.48,
  "end": 11.85,
  "text": "Raindrops hang in the air like glass beads."
 },
 {
  "i": 7,
  "start": 12.32,
  "end": 14.39,
  "text": "The bus driver’s mouth is open mid-shout."
 },
 {
  "i": 8,
  "start": 14.75,
  "end": 15.53,
  "text": "You can’t move."
 },
 {
  "i": 9,
  "start": 15.87,
  "end": 17.2,
  "text": "You’re inside the year again."
 },
 {
  "i": 10,
  "start": 17.56,
  "end": 20.21,
  "text": "But this time, a voice speaks inside your head."
 },
 {
  "i": 11,
  "start": 20.71,
  "end": 21.75,
  "text": "Don’t breathe out."
 },
 {
  "i": 12,
  "start": 22.0,
  "end": 22.56,
  "text": "Please."
 },
 {
  "i": 13,
  "start": 22.81,
  "end": 23.55,
  "text": "If you do..."
 },
 {
  "i": 14,
  "start": 23.83,
  "end": 24.64,
  "text": "I don’t make it."
 },
 {
  "i": 15,
  "start": 24.99,
  "end": 27.79,
  "text": "Two weeks earlier, everything was finally calm."
 },
 {
  "i": 16,
  "start": 28.13,
  "end": 28.87,
  "text": "You’re Leo."
 },
 {
  "i": 17,
  "start": 29.19,
  "end": 32.28,
  "text": "Hold your breath, and one second becomes a whole year."
 },
 {
  "i": 18,
  "start": 32.67,
  "end": 33.77,
  "text": "You can think anything."
 },
 {
  "i": 19,
  "start": 34.21,
  "end": 35.47,
  "text": "You can’t move a finger."
 },
 {
  "i": 20,
  "start": 35.8,
  "end": 39.07,
  "text": "Last time, that year helped you save your grandpa’s life."
 },
 {
  "i": 21,
  "start": 39.48,
  "end": 40.27,
  "text": "He’s home now."
 },
 {
  "i": 22,
  "start": 40.81,
  "end": 42.34,
  "text": "Still dancing on Sundays."
 },
 {
  "i": 23,
  "start": 42.63,
  "end": 42.96,
  "text": "Just..."
 },
 {
  "i": 24,
  "start": 43.28,
  "end": 44.11,
  "text": "a little slower."
 },
 {
  "i": 25,
  "start": 44.43,
  "end": 45.64,
  "text": "But something is changing."
 },
 {
  "i": 26,
  "start": 45.99,
  "end": 47.09,
  "text": "The power is growing."
 },
 {
  "i": 27,
  "start": 47.44,
  "end": 48.53,
  "text": "It used to wait for you."
 },
 {
  "i": 28,
  "start": 48.86,
  "end": 49.64,
  "text": "Now it doesn’t."
 },
 {
  "i": 29,
  "start": 50.0,
  "end": 51.0,
  "text": "A slammed door."
 },
 {
  "i": 30,
  "start": 51.33,
  "end": 52.14,
  "text": "A dropped plate."
 },
 {
  "i": 31,
  "start": 52.43,
  "end": 53.22,
  "text": "A car horn."
 },
 {
  "i": 32,
  "start": 53.56,
  "end": 54.58,
  "text": "Your breath catches..."
 },
 {
  "i": 33,
  "start": 54.84,
  "end": 55.58,
  "text": "and you’re gone."
 },
 {
  "i": 34,
  "start": 55.93,
  "end": 56.66,
  "text": "Another year."
 },
 {
  "i": 35,
  "start": 56.96,
  "end": 57.76,
  "text": "You’re fifteen."
 },
 {
  "i": 36,
  "start": 58.09,
  "end": 60.82,
  "text": "But inside, you’ve now lived fifty-two years."
 },
 {
  "i": 37,
  "start": 61.27,
  "end": 64.02,
  "text": "So what happens when one second feels like a year..."
 },
 {
  "i": 38,
  "start": 64.39,
  "end": 66.04,
  "text": "and you’re not the only one who knows?"
 },
 {
  "i": 39,
  "start": 66.45,
  "end": 70.41,
  "text": "Then, in the middle of a frozen year, you hear something new."
 },
 {
  "i": 40,
  "start": 70.79,
  "end": 71.46,
  "text": "A voice."
 },
 {
  "i": 41,
  "start": 72.04,
  "end": 72.46,
  "text": "Hello?"
 },
 {
  "i": 42,
  "start": 72.9,
  "end": 73.54,
  "text": "Is someone..."
 },
 {
  "i": 43,
  "start": 73.94,
  "end": 74.85,
  "text": "actually there?"
 },
 {
  "i": 44,
  "start": 75.37,
  "end": 76.58,
  "text": "You can’t turn your head."
 },
 {
  "i": 45,
  "start": 77.06,
  "end": 77.96,
  "text": "Neither can she."
 },
 {
  "i": 46,
  "start": 78.37,
  "end": 80.88,
  "text": "But somehow, you can think to each other."
 },
 {
  "i": 47,
  "start": 81.27,
  "end": 82.33,
  "text": "Her name is Nova."
 },
 {
  "i": 48,
  "start": 82.88,
  "end": 83.77,
  "text": "She’s sixteen."
 },
 {
  "i": 49,
  "start": 84.02,
  "end": 85.44,
  "text": "She lives three streets away."
 },
 {
  "i": 50,
  "start": 85.87,
  "end": 87.2,
  "text": "And she’s had the same power..."
 },
 {
  "i": 51,
  "start": 87.45,
  "end": 88.44,
  "text": "for six years."
 },
 {
  "i": 52,
  "start": 88.95,
  "end": 90.56,
  "text": "How many years have you lived in here?"
 },
 {
  "i": 53,
  "start": 91.02,
  "end": 92.6,
  "text": "I stopped counting at two hundred."
 },
 {
  "i": 54,
  "start": 93.04,
  "end": 93.73,
  "text": "Two hundred."
 },
 {
  "i": 55,
  "start": 94.13,
  "end": 95.5,
  "text": "You thought fifty was a lot."
 },
 {
  "i": 56,
  "start": 95.94,
  "end": 99.27,
  "text": "Plus: for the first time, the year isn’t silent."
 },
 {
  "i": 57,
  "start": 99.8,
  "end": 101.18,
  "text": "You talk about everything."
 },
 {
  "i": 58,
  "start": 101.62,
  "end": 102.18,
  "text": "Music."
 },
 {
  "i": 59,
  "start": 102.48,
  "end": 103.0,
  "text": "Books."
 },
 {
  "i": 60,
  "start": 103.57,
  "end": 105.53,
  "text": "Why cats knock things off tables."
 },
 {
  "i": 61,
  "start": 105.75,
  "end": 108.42,
  "text": "You play chess with no board, just in your heads."
 },
 {
  "i": 62,
  "start": 108.78,
  "end": 109.59,
  "text": "She wins."
 },
 {
  "i": 63,
  "start": 109.9,
  "end": 110.65,
  "text": "Every time."
 },
 {
  "i": 64,
  "start": 111.09,
  "end": 112.28,
  "text": "I’ve had practice, Leo."
 },
 {
  "i": 65,
  "start": 112.61,
  "end": 113.74,
  "text": "About a century of it."
 },
 {
  "i": 66,
  "start": 114.06,
  "end": 116.37,
  "text": "Minus: she knows where this is going."
 },
 {
  "i": 67,
  "start": 116.73,
  "end": 118.16,
  "text": "The years get longer, Leo."
 },
 {
  "i": 68,
  "start": 118.51,
  "end": 119.63,
  "text": "Mine used to be one."
 },
 {
  "i": 69,
  "start": 120.09,
  "end": 121.98,
  "text": "Now one second feels like two."
 },
 {
  "i": 70,
  "start": 122.37,
  "end": 123.15,
  "text": "Two years?"
 },
 {
  "i": 71,
  "start": 123.56,
  "end": 124.4,
  "text": "Two years."
 },
 {
  "i": 72,
  "start": 124.98,
  "end": 128.04,
  "text": "In the real world, you finally meet on a park bench."
 },
 {
  "i": 73,
  "start": 128.38,
  "end": 129.62,
  "text": "Jake walks past."
 },
 {
  "i": 74,
  "start": 130.15,
  "end": 130.54,
  "text": "Dude."
 },
 {
  "i": 75,
  "start": 131.0,
  "end": 131.62,
  "text": "Who’s that?"
 },
 {
  "i": 76,
  "start": 132.05,
  "end": 132.68,
  "text": "A friend."
 },
 {
  "i": 77,
  "start": 133.02,
  "end": 133.57,
  "text": "A really..."
 },
 {
  "i": 78,
  "start": 134.06,
  "end": 134.93,
  "text": "old friend."
 },
 {
  "i": 79,
  "start": 135.3,
  "end": 136.97,
  "text": "But where it gets really strange..."
 },
 {
  "i": 80,
  "start": 137.37,
  "end": 138.26,
  "text": "is the sky."
 },
 {
  "i": 81,
  "start": 138.72,
  "end": 142.75,
  "text": "In her years, Nova stares upward, so she counts stars."
 },
 {
  "i": 82,
  "start": 143.14,
  "end": 147.21,
  "text": "The light from some of those stars left them hundreds of years ago, she tells you."
 },
 {
  "i": 83,
  "start": 147.66,
  "end": 149.17,
  "text": "We’re both looking at the past."
 },
 {
  "i": 84,
  "start": 149.5,
  "end": 150.63,
  "text": "How many have you counted?"
 },
 {
  "i": 85,
  "start": 151.07,
  "end": 153.19,
  "text": "Four thousand, one hundred and twelve."
 },
 {
  "i": 86,
  "start": 153.63,
  "end": 154.18,
  "text": "The price?"
 },
 {
  "i": 87,
  "start": 154.56,
  "end": 155.93,
  "text": "Nova is tired."
 },
 {
  "i": 88,
  "start": 156.35,
  "end": 157.24,
  "text": "Really tired."
 },
 {
  "i": 89,
  "start": 157.63,
  "end": 160.95,
  "text": "Every time she breathes out, the real world feels too fast."
 },
 {
  "i": 90,
  "start": 161.27,
  "end": 161.95,
  "text": "Too loud."
 },
 {
  "i": 91,
  "start": 162.25,
  "end": 163.08,
  "text": "Too scary."
 },
 {
  "i": 92,
  "start": 163.47,
  "end": 164.82,
  "text": "So she stays in longer."
 },
 {
  "i": 93,
  "start": 165.27,
  "end": 165.96,
  "text": "And longer."
 },
 {
  "i": 94,
  "start": 166.38,
  "end": 167.23,
  "text": "Who could blame her?"
 },
 {
  "i": 95,
  "start": 167.63,
  "end": 168.64,
  "text": "The year is quiet."
 },
 {
  "i": 96,
  "start": 168.97,
  "end": 169.47,
  "text": "Safe."
 },
 {
  "i": 97,
  "start": 169.82,
  "end": 170.53,
  "text": "And empty."
 },
 {
  "i": 98,
  "start": 170.99,
  "end": 177.34,
  "text": "People returning from long isolation often struggle to adjust, even to ordinary noise and crowds."
 },
 {
  "i": 99,
  "start": 177.71,
  "end": 179.35,
  "text": "Sometimes I think I should just..."
 },
 {
  "i": 100,
  "start": 179.62,
  "end": 180.24,
  "text": "stay."
 },
 {
  "i": 101,
  "start": 180.73,
  "end": 182.25,
  "text": "Your old fear comes back."
 },
 {
  "i": 102,
  "start": 182.67,
  "end": 183.58,
  "text": "What if one day..."
 },
 {
  "i": 103,
  "start": 184.01,
  "end": 185.1,
  "text": "you can’t breathe out?"
 },
 {
  "i": 104,
  "start": 185.54,
  "end": 187.08,
  "text": "Now someone else is living it."
 },
 {
  "i": 105,
  "start": 187.61,
  "end": 189.11,
  "text": "And she’s starting to like it."
 },
 {
  "i": 106,
  "start": 189.39,
  "end": 191.05,
  "text": "So you bring her to Sunday dinner."
 },
 {
  "i": 107,
  "start": 191.48,
  "end": 192.98,
  "text": "Grandpa puts on his song."
 },
 {
  "i": 108,
  "start": 193.41,
  "end": 193.97,
  "text": "Boom."
 },
 {
  "i": 109,
  "start": 194.23,
  "end": 194.83,
  "text": "Boom."
 },
 {
  "i": 110,
  "start": 195.18,
  "end": 195.71,
  "text": "Boom."
 },
 {
  "i": 111,
  "start": 196.06,
  "end": 197.45,
  "text": "About a hundred beats a minute."
 },
 {
  "i": 112,
  "start": 197.84,
  "end": 199.21,
  "text": "Nova raises an eyebrow."
 },
 {
  "i": 113,
  "start": 199.6,
  "end": 200.64,
  "text": "You dance to this?"
 },
 {
  "i": 114,
  "start": 200.99,
  "end": 202.65,
  "text": "It kept me alive, young lady."
 },
 {
  "i": 115,
  "start": 203.02,
  "end": 204.22,
  "text": "Then he gives her the line."
 },
 {
  "i": 116,
  "start": 204.59,
  "end": 206.05,
  "text": "A second is plenty, Nova..."
 },
 {
  "i": 117,
  "start": 206.4,
  "end": 207.25,
  "text": "if you use it."
 },
 {
  "i": 118,
  "start": 207.58,
  "end": 209.44,
  "text": "You notice one thing about her that night."
 },
 {
  "i": 119,
  "start": 209.77,
  "end": 212.31,
  "text": "Before anything scary, Nova counts down."
 },
 {
  "i": 120,
  "start": 212.63,
  "end": 213.17,
  "text": "Three."
 },
 {
  "i": 121,
  "start": 213.41,
  "end": 213.91,
  "text": "Two."
 },
 {
  "i": 122,
  "start": 214.18,
  "end": 214.64,
  "text": "One."
 },
 {
  "i": 123,
  "start": 215.07,
  "end": 216.05,
  "text": "Before a test."
 },
 {
  "i": 124,
  "start": 216.34,
  "end": 217.83,
  "text": "Before a cold swimming pool."
 },
 {
  "i": 125,
  "start": 218.15,
  "end": 219.92,
  "text": "Before tasting Grandpa’s soup."
 },
 {
  "i": 126,
  "start": 220.21,
  "end": 220.78,
  "text": "Three..."
 },
 {
  "i": 127,
  "start": 221.1,
  "end": 221.59,
  "text": "two..."
 },
 {
  "i": 128,
  "start": 221.93,
  "end": 222.42,
  "text": "one."
 },
 {
  "i": 129,
  "start": 222.78,
  "end": 224.2,
  "text": "Nova, it’s soup."
 },
 {
  "i": 130,
  "start": 224.49,
  "end": 226.05,
  "text": "It’s very suspicious soup."
 },
 {
  "i": 131,
  "start": 226.36,
  "end": 227.35,
  "text": "Friday evening."
 },
 {
  "i": 132,
  "start": 227.68,
  "end": 228.22,
  "text": "Rain."
 },
 {
  "i": 133,
  "start": 228.58,
  "end": 229.66,
  "text": "You’re walking home."
 },
 {
  "i": 134,
  "start": 230.06,
  "end": 232.58,
  "text": "Across the street, Nova waits on her bike."
 },
 {
  "i": 135,
  "start": 232.92,
  "end": 233.92,
  "text": "The light changes."
 },
 {
  "i": 136,
  "start": 234.24,
  "end": 235.13,
  "text": "She pushes off."
 },
 {
  "i": 137,
  "start": 235.48,
  "end": 237.15,
  "text": "And a bus swings round the corner."
 },
 {
  "i": 138,
  "start": 237.76,
  "end": 238.78,
  "text": "Your breath catches."
 },
 {
  "i": 139,
  "start": 239.17,
  "end": 240.2,
  "text": "The year begins."
 },
 {
  "i": 140,
  "start": 240.56,
  "end": 241.12,
  "text": "And in it..."
 },
 {
  "i": 141,
  "start": 241.52,
  "end": 242.19,
  "text": "her voice."
 },
 {
  "i": 142,
  "start": 242.64,
  "end": 243.49,
  "text": "Don’t breathe out."
 },
 {
  "i": 143,
  "start": 243.85,
  "end": 244.39,
  "text": "Please."
 },
 {
  "i": 144,
  "start": 244.81,
  "end": 245.5,
  "text": "If you do..."
 },
 {
  "i": 145,
  "start": 246.05,
  "end": 246.86,
  "text": "I don’t make it."
 },
 {
  "i": 146,
  "start": 247.32,
  "end": 248.78,
  "text": "You study the frozen picture."
 },
 {
  "i": 147,
  "start": 249.24,
  "end": 251.67,
  "text": "The bus is about ten meters from her front wheel."
 },
 {
  "i": 148,
  "start": 252.05,
  "end": 255.55,
  "text": "At fifty kilometers per hour, it covers that in under a second."
 },
 {
  "i": 149,
  "start": 255.96,
  "end": 258.01,
  "text": "And it needs more than twenty meters to stop."
 },
 {
  "i": 150,
  "start": 258.58,
  "end": 259.79,
  "text": "Braking won’t save her."
 },
 {
  "i": 151,
  "start": 260.21,
  "end": 261.46,
  "text": "You’re three steps away."
 },
 {
  "i": 152,
  "start": 261.85,
  "end": 265.39,
  "text": "Your body still needs about a quarter of a second just to start moving."
 },
 {
  "i": 153,
  "start": 265.81,
  "end": 266.85,
  "text": "Then three steps."
 },
 {
  "i": 154,
  "start": 267.27,
  "end": 268.22,
  "text": "Then one grab."
 },
 {
  "i": 155,
  "start": 268.62,
  "end": 269.37,
  "text": "Can you make it?"
 },
 {
  "i": 156,
  "start": 269.75,
  "end": 270.28,
  "text": "Maybe."
 },
 {
  "i": 157,
  "start": 270.68,
  "end": 272.1,
  "text": "Nova’s voice gets quiet."
 },
 {
  "i": 158,
  "start": 272.47,
  "end": 273.54,
  "text": "We could just stay."
 },
 {
  "i": 159,
  "start": 273.92,
  "end": 275.33,
  "text": "Here, nothing hits me."
 },
 {
  "i": 160,
  "start": 275.72,
  "end": 277.56,
  "text": "Here, you’re not alone either."
 },
 {
  "i": 161,
  "start": 277.97,
  "end": 279.3,
  "text": "A thousand years together..."
 },
 {
  "i": 162,
  "start": 279.63,
  "end": 280.94,
  "text": "inside one second."
 },
 {
  "i": 163,
  "start": 281.53,
  "end": 282.7,
  "text": "And part of you wants it."
 },
 {
  "i": 164,
  "start": 283.08,
  "end": 284.47,
  "text": "No more empty years."
 },
 {
  "i": 165,
  "start": 284.79,
  "end": 286.11,
  "text": "What’s one second worth?"
 },
 {
  "i": 166,
  "start": 286.45,
  "end": 287.72,
  "text": "Stay together forever..."
 },
 {
  "i": 167,
  "start": 288.1,
  "end": 289.86,
  "text": "or step out together, now."
 },
 {
  "i": 168,
  "start": 290.32,
  "end": 292.31,
  "text": "Then you hear Grandpa’s beat in your head."
 },
 {
  "i": 169,
  "start": 292.73,
  "end": 293.2,
  "text": "Boom."
 },
 {
  "i": 170,
  "start": 293.61,
  "end": 294.08,
  "text": "Boom."
 },
 {
  "i": 171,
  "start": 294.48,
  "end": 294.91,
  "text": "Boom."
 },
 {
  "i": 172,
  "start": 295.29,
  "end": 296.45,
  "text": "A second is plenty..."
 },
 {
  "i": 173,
  "start": 296.83,
  "end": 297.62,
  "text": "if you use it."
 },
 {
  "i": 174,
  "start": 298.0,
  "end": 298.5,
  "text": "Nova."
 },
 {
  "i": 175,
  "start": 298.88,
  "end": 299.87,
  "text": "We’ve had our years."
 },
 {
  "i": 176,
  "start": 300.21,
  "end": 301.32,
  "text": "Let’s use the second."
 },
 {
  "i": 177,
  "start": 301.72,
  "end": 302.14,
  "text": "Ready?"
 },
 {
  "i": 178,
  "start": 302.55,
  "end": 303.23,
  "text": "Silence."
 },
 {
  "i": 179,
  "start": 303.23,
  "end": 304.06,
  "text": "Then..."
 },
 {
  "i": 180,
  "start": 304.48,
  "end": 305.1,
  "text": "a whisper."
 },
 {
  "i": 181,
  "start": 305.5,
  "end": 305.94,
  "text": "Three."
 },
 {
  "i": 182,
  "start": 306.29,
  "end": 306.69,
  "text": "Two."
 },
 {
  "i": 183,
  "start": 307.17,
  "end": 307.67,
  "text": "One."
 },
 {
  "i": 184,
  "start": 308.01,
  "end": 309.11,
  "text": "You both breathe out."
 },
 {
  "i": 185,
  "start": 309.31,
  "end": 310.14,
  "text": "Same instant."
 },
 {
  "i": 186,
  "start": 310.6,
  "end": 311.79,
  "text": "The rain falls again."
 },
 {
  "i": 187,
  "start": 312.17,
  "end": 313.3,
  "text": "The horn screams."
 },
 {
  "i": 188,
  "start": 313.68,
  "end": 314.87,
  "text": "You take three steps."
 },
 {
  "i": 189,
  "start": 315.32,
  "end": 316.43,
  "text": "You grab her backpack."
 },
 {
  "i": 190,
  "start": 316.7,
  "end": 317.26,
  "text": "You pull."
 },
 {
  "i": 191,
  "start": 317.65,
  "end": 319.02,
  "text": "She brakes and leans back."
 },
 {
  "i": 192,
  "start": 319.42,
  "end": 320.69,
  "text": "The bus thunders past..."
 },
 {
  "i": 193,
  "start": 321.0,
  "end": 322.43,
  "text": "close enough to lift her hair."
 },
 {
  "i": 194,
  "start": 322.88,
  "end": 324.83,
  "text": "Her front wheel stops right on the curb."
 },
 {
  "i": 195,
  "start": 325.25,
  "end": 326.3,
  "text": "The driver leans out."
 },
 {
  "i": 196,
  "start": 326.75,
  "end": 327.73,
  "text": "Are you two okay?"
 },
 {
  "i": 197,
  "start": 328.06,
  "end": 328.73,
  "text": "You’re soaked."
 },
 {
  "i": 198,
  "start": 329.33,
  "end": 329.94,
  "text": "Shaking."
 },
 {
  "i": 199,
  "start": 329.94,
  "end": 331.16,
  "text": "Then laughing."
 },
 {
  "i": 200,
  "start": 331.55,
  "end": 332.7,
  "text": "Nova stares at you."
 },
 {
  "i": 201,
  "start": 333.08,
  "end": 334.55,
  "text": "Longest second of my life."
 },
 {
  "i": 202,
  "start": 334.89,
  "end": 335.81,
  "text": "And the shortest."
 },
 {
  "i": 203,
  "start": 336.17,
  "end": 338.62,
  "text": "On Sunday, Nova comes to dinner again."
 },
 {
  "i": 204,
  "start": 339.02,
  "end": 340.33,
  "text": "Grandpa’s song plays."
 },
 {
  "i": 205,
  "start": 340.69,
  "end": 342.96,
  "text": "And this time, she doesn’t count down."
 },
 {
  "i": 206,
  "start": 343.29,
  "end": 343.87,
  "text": "She just..."
 },
 {
  "i": 207,
  "start": 344.27,
  "end": 344.95,
  "text": "dances."
 },
 {
  "i": 208,
  "start": 345.29,
  "end": 347.62,
  "text": "For the first time in two hundred years..."
 },
 {
  "i": 209,
  "start": 347.92,
  "end": 349.28,
  "text": "neither of you is alone."
 },
 {
  "i": 210,
  "start": 349.69,
  "end": 351.96,
  "text": "That night, the power takes you again."
 },
 {
  "i": 211,
  "start": 352.46,
  "end": 354.45,
  "text": "And a voice speaks inside the year."
 },
 {
  "i": 212,
  "start": 354.88,
  "end": 355.63,
  "text": "Not Nova’s."
 },
 {
  "i": 213,
  "start": 356.07,
  "end": 356.53,
  "text": "Older."
 },
 {
  "i": 214,
  "start": 356.94,
  "end": 357.45,
  "text": "Colder."
 },
 {
  "i": 215,
  "start": 357.9,
  "end": 358.31,
  "text": "So."
 },
 {
  "i": 216,
  "start": 358.71,
  "end": 359.75,
  "text": "There are two of you now."
 },
 {
  "i": 217,
  "start": 360.18,
  "end": 361.88,
  "text": "I’ve been waiting a very long time."
 },
 {
  "i": 218,
  "start": 362.23,
  "end": 364.93,
  "text": "So what would you do with a year inside one second?"
 },
 {
  "i": 219,
  "start": 365.34,
  "end": 367.29,
  "text": "Tell us who you’d share it with in the comments."
 },
 {
  "i": 220,
  "start": 367.71,
  "end": 370.02,
  "text": "And if you held your breath when Nova counted down..."
 },
 {
  "i": 221,
  "start": 370.44,
  "end": 372.76,
  "text": "hit like, and subscribe for Part Three."
 }
]