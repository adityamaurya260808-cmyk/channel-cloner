[
 {
  "i": 0,
  "start": 0.4,
  "end": 2.587,
  "text": "Your phone buzzes at three in the morning."
 },
 {
  "i": 1,
  "start": 2.942,
  "end": 3.864,
  "text": "It's your mom."
 },
 {
  "i": 2,
  "start": 4.209,
  "end": 5.408,
  "text": "Her voice is shaking."
 },
 {
  "i": 3,
  "start": 5.766,
  "end": 6.353,
  "text": "Sam..."
 },
 {
  "i": 4,
  "start": 6.954,
  "end": 7.717,
  "text": "they took it."
 },
 {
  "i": 5,
  "start": 8.056,
  "end": 8.738,
  "text": "All of it."
 },
 {
  "i": 6,
  "start": 9.078,
  "end": 10.777,
  "text": "You open your investing app."
 },
 {
  "i": 7,
  "start": 11.121,
  "end": 12.877,
  "text": "One number glows on the screen."
 },
 {
  "i": 8,
  "start": 13.231,
  "end": 14.917,
  "text": "Thirty-three years of your life..."
 },
 {
  "i": 9,
  "start": 15.498,
  "end": 16.378,
  "text": "in one number."
 },
 {
  "i": 10,
  "start": 16.734,
  "end": 18.657,
  "text": "Your thumb hovers over one word."
 },
 {
  "i": 11,
  "start": 19.005,
  "end": 19.536,
  "text": "'Withdraw.'"
 },
 {
  "i": 12,
  "start": 19.582,
  "end": 20.179,
  "text": "Press it..."
 },
 {
  "i": 13,
  "start": 20.754,
  "end": 22.715,
  "text": "and that money stops growing forever."
 },
 {
  "i": 14,
  "start": 23.071,
  "end": 23.916,
  "text": "Don't press it..."
 },
 {
  "i": 15,
  "start": 24.489,
  "end": 26.042,
  "text": "and your mom loses her home."
 },
 {
  "i": 16,
  "start": 26.387,
  "end": 27.578,
  "text": "How did one dollar..."
 },
 {
  "i": 17,
  "start": 28.17,
  "end": 29.081,
  "text": "lead to this?"
 },
 {
  "i": 18,
  "start": 29.562,
  "end": 31.011,
  "text": "Thirty-three years earlier..."
 },
 {
  "i": 19,
  "start": 31.605,
  "end": 33.231,
  "text": "it started with a glass jar."
 },
 {
  "i": 20,
  "start": 33.574,
  "end": 34.696,
  "text": "Your name is Sam."
 },
 {
  "i": 21,
  "start": 35.041,
  "end": 36.067,
  "text": "You're twenty-five."
 },
 {
  "i": 22,
  "start": 36.441,
  "end": 38.833,
  "text": "And your mom just handed you a glass jar."
 },
 {
  "i": 23,
  "start": 39.175,
  "end": 39.882,
  "text": "Inside?"
 },
 {
  "i": 24,
  "start": 40.393,
  "end": 41.125,
  "text": "One dollar."
 },
 {
  "i": 25,
  "start": 41.485,
  "end": 42.894,
  "text": "One dollar a day, kid."
 },
 {
  "i": 26,
  "start": 43.239,
  "end": 44.493,
  "text": "Into the stock market."
 },
 {
  "i": 27,
  "start": 44.847,
  "end": 45.985,
  "text": "Every single day."
 },
 {
  "i": 28,
  "start": 46.332,
  "end": 47.909,
  "text": "Your best friend Max laughs."
 },
 {
  "i": 29,
  "start": 48.263,
  "end": 48.846,
  "text": "Dude."
 },
 {
  "i": 30,
  "start": 49.216,
  "end": 50.374,
  "text": "That's not investing."
 },
 {
  "i": 31,
  "start": 50.74,
  "end": 51.886,
  "text": "That's a tip jar."
 },
 {
  "i": 32,
  "start": 52.232,
  "end": 52.76,
  "text": "Fair."
 },
 {
  "i": 33,
  "start": 53.126,
  "end": 54.791,
  "text": "A dollar is less than a coffee."
 },
 {
  "i": 34,
  "start": 55.142,
  "end": 56.521,
  "text": "A whole year of dollars?"
 },
 {
  "i": 35,
  "start": 57.008,
  "end": 58.459,
  "text": "Three hundred sixty-five."
 },
 {
  "i": 36,
  "start": 58.833,
  "end": 59.685,
  "text": "Forty years?"
 },
 {
  "i": 37,
  "start": 60.173,
  "end": 61.855,
  "text": "Fourteen thousand six hundred."
 },
 {
  "i": 38,
  "start": 62.214,
  "end": 62.908,
  "text": "That's it."
 },
 {
  "i": 39,
  "start": 63.25,
  "end": 65.049,
  "text": "That's everything you'll ever put in."
 },
 {
  "i": 40,
  "start": 65.385,
  "end": 66.558,
  "text": "But there's one rule."
 },
 {
  "i": 41,
  "start": 66.904,
  "end": 69.243,
  "text": "The money only grows if you leave it alone."
 },
 {
  "i": 42,
  "start": 69.592,
  "end": 71.059,
  "text": "Every dollar you pull out..."
 },
 {
  "i": 43,
  "start": 71.637,
  "end": 72.613,
  "text": "stops growing."
 },
 {
  "i": 44,
  "start": 72.981,
  "end": 73.594,
  "text": "Forever."
 },
 {
  "i": 45,
  "start": 73.967,
  "end": 75.881,
  "text": "You can buy almost anything back."
 },
 {
  "i": 46,
  "start": 76.228,
  "end": 77.162,
  "text": "Except time."
 },
 {
  "i": 47,
  "start": 77.519,
  "end": 80.346,
  "text": "So what if you invested one dollar every day..."
 },
 {
  "i": 48,
  "start": 80.928,
  "end": 81.949,
  "text": "for forty years?"
 },
 {
  "i": 49,
  "start": 82.432,
  "end": 83.103,
  "text": "Year one."
 },
 {
  "i": 50,
  "start": 83.451,
  "end": 84.601,
  "text": "You check the account."
 },
 {
  "i": 51,
  "start": 84.956,
  "end": 86.706,
  "text": "About three hundred eighty dollars."
 },
 {
  "i": 52,
  "start": 87.061,
  "end": 88.28,
  "text": "Your money earned you..."
 },
 {
  "i": 53,
  "start": 88.858,
  "end": 90.208,
  "text": "roughly fifteen bucks."
 },
 {
  "i": 54,
  "start": 90.562,
  "end": 91.935,
  "text": "Max holds up a pizza."
 },
 {
  "i": 55,
  "start": 92.288,
  "end": 93.401,
  "text": "I earned this today."
 },
 {
  "i": 56,
  "start": 93.75,
  "end": 94.627,
  "text": "Also fair."
 },
 {
  "i": 57,
  "start": 94.986,
  "end": 97.28,
  "text": "Plus: you don't have to pick stocks."
 },
 {
  "i": 58,
  "start": 97.63,
  "end": 99.008,
  "text": "You buy an index fund."
 },
 {
  "i": 59,
  "start": 99.356,
  "end": 100.604,
  "text": "One tiny slice..."
 },
 {
  "i": 60,
  "start": 101.203,
  "end": 104.156,
  "text": "of five hundred of America's biggest companies."
 },
 {
  "i": 61,
  "start": 104.528,
  "end": 105.372,
  "text": "All at once."
 },
 {
  "i": 62,
  "start": 105.723,
  "end": 107.095,
  "text": "You set it to automatic."
 },
 {
  "i": 63,
  "start": 107.46,
  "end": 108.781,
  "text": "And then you forget about it."
 },
 {
  "i": 64,
  "start": 109.116,
  "end": 109.908,
  "text": "Year three."
 },
 {
  "i": 65,
  "start": 110.266,
  "end": 111.139,
  "text": "Still boring."
 },
 {
  "i": 66,
  "start": 111.5,
  "end": 113.134,
  "text": "This is where most people quit."
 },
 {
  "i": 67,
  "start": 113.478,
  "end": 113.953,
  "text": "Why?"
 },
 {
  "i": 68,
  "start": 114.444,
  "end": 116.538,
  "text": "Because the growth is too small to feel."
 },
 {
  "i": 69,
  "start": 116.882,
  "end": 118.663,
  "text": "Your brain wants rewards now."
 },
 {
  "i": 70,
  "start": 119.008,
  "end": 120.377,
  "text": "Not in four decades."
 },
 {
  "i": 71,
  "start": 120.742,
  "end": 121.569,
  "text": "Year five."
 },
 {
  "i": 72,
  "start": 121.926,
  "end": 123.248,
  "text": "Max buys a new car."
 },
 {
  "i": 73,
  "start": 123.594,
  "end": 124.166,
  "text": "Shiny."
 },
 {
  "i": 74,
  "start": 124.536,
  "end": 125.113,
  "text": "Loud."
 },
 {
  "i": 75,
  "start": 125.483,
  "end": 126.178,
  "text": "You buy..."
 },
 {
  "i": 76,
  "start": 126.764,
  "end": 127.713,
  "text": "one more dollar."
 },
 {
  "i": 77,
  "start": 128.069,
  "end": 128.876,
  "text": "He grins."
 },
 {
  "i": 78,
  "start": 129.241,
  "end": 131.049,
  "text": "You're gonna be rich at ninety, bro."
 },
 {
  "i": 79,
  "start": 131.389,
  "end": 131.978,
  "text": "Maybe."
 },
 {
  "i": 80,
  "start": 132.349,
  "end": 133.546,
  "text": "But you notice something."
 },
 {
  "i": 81,
  "start": 133.906,
  "end": 135.598,
  "text": "Your account isn't just growing."
 },
 {
  "i": 82,
  "start": 135.954,
  "end": 137.622,
  "text": "It's growing faster each year."
 },
 {
  "i": 83,
  "start": 137.968,
  "end": 138.955,
  "text": "Here's the secret."
 },
 {
  "i": 84,
  "start": 139.308,
  "end": 144.321,
  "text": "Over the long run, the US stock market has averaged around ten percent a year."
 },
 {
  "i": 85,
  "start": 144.67,
  "end": 147.293,
  "text": "And there's a shortcut called the rule of seventy-two."
 },
 {
  "i": 86,
  "start": 147.66,
  "end": 149.716,
  "text": "Divide seventy-two by your return."
 },
 {
  "i": 87,
  "start": 150.073,
  "end": 151.955,
  "text": "Seventy-two divided by ten?"
 },
 {
  "i": 88,
  "start": 152.434,
  "end": 153.298,
  "text": "About seven."
 },
 {
  "i": 89,
  "start": 153.657,
  "end": 156.795,
  "text": "That's roughly how many years it takes your money to double."
 },
 {
  "i": 90,
  "start": 157.147,
  "end": 158.161,
  "text": "Then double again."
 },
 {
  "i": 91,
  "start": 158.511,
  "end": 159.272,
  "text": "Then again."
 },
 {
  "i": 92,
  "start": 159.628,
  "end": 160.354,
  "text": "Year ten."
 },
 {
  "i": 93,
  "start": 160.704,
  "end": 163.739,
  "text": "You've put in three thousand six hundred fifty dollars."
 },
 {
  "i": 94,
  "start": 164.097,
  "end": 166.064,
  "text": "The account says almost six thousand."
 },
 {
  "i": 95,
  "start": 166.424,
  "end": 167.845,
  "text": "The extra two thousand?"
 },
 {
  "i": 96,
  "start": 168.341,
  "end": 169.317,
  "text": "You didn't earn it."
 },
 {
  "i": 97,
  "start": 169.653,
  "end": 170.583,
  "text": "Your money did."
 },
 {
  "i": 98,
  "start": 170.927,
  "end": 171.81,
  "text": "While you slept."
 },
 {
  "i": 99,
  "start": 172.159,
  "end": 173.985,
  "text": "That's when Max finally starts."
 },
 {
  "i": 100,
  "start": 174.341,
  "end": 175.372,
  "text": "He's thirty-five."
 },
 {
  "i": 101,
  "start": 175.753,
  "end": 176.562,
  "text": "Same dollar."
 },
 {
  "i": 102,
  "start": 176.923,
  "end": 177.747,
  "text": "Same market."
 },
 {
  "i": 103,
  "start": 178.109,
  "end": 179.222,
  "text": "Just ten years late."
 },
 {
  "i": 104,
  "start": 179.567,
  "end": 180.922,
  "text": "Here's the brutal part."
 },
 {
  "i": 105,
  "start": 181.269,
  "end": 182.439,
  "text": "If he never stops..."
 },
 {
  "i": 106,
  "start": 183.028,
  "end": 185.622,
  "text": "he'll reach sixty-five with about sixty thousand."
 },
 {
  "i": 107,
  "start": 185.982,
  "end": 186.457,
  "text": "You?"
 },
 {
  "i": 108,
  "start": 186.948,
  "end": 188.826,
  "text": "About one hundred sixty thousand."
 },
 {
  "i": 109,
  "start": 189.19,
  "end": 190.205,
  "text": "Ten years late..."
 },
 {
  "i": 110,
  "start": 190.791,
  "end": 193.128,
  "text": "could cost him a hundred thousand dollars."
 },
 {
  "i": 111,
  "start": 193.486,
  "end": 194.05,
  "text": "Wait..."
 },
 {
  "i": 112,
  "start": 194.649,
  "end": 195.66,
  "text": "just ten years?"
 },
 {
  "i": 113,
  "start": 196.146,
  "end": 197.655,
  "text": "Why does that hurt so much?"
 },
 {
  "i": 114,
  "start": 198.13,
  "end": 199.593,
  "text": "Because the biggest growth..."
 },
 {
  "i": 115,
  "start": 200.182,
  "end": 201.647,
  "text": "happens at the very end."
 },
 {
  "i": 116,
  "start": 201.991,
  "end": 203.781,
  "text": "Minus: year twelve."
 },
 {
  "i": 117,
  "start": 204.145,
  "end": 205.32,
  "text": "The market crashes."
 },
 {
  "i": 118,
  "start": 205.683,
  "end": 208.15,
  "text": "Your account drops by a third in a few weeks."
 },
 {
  "i": 119,
  "start": 208.498,
  "end": 209.896,
  "text": "Max calls you, panicking."
 },
 {
  "i": 120,
  "start": 210.262,
  "end": 210.763,
  "text": "Sell!"
 },
 {
  "i": 121,
  "start": 211.126,
  "end": 212.077,
  "text": "Sell everything!"
 },
 {
  "i": 122,
  "start": 212.452,
  "end": 212.927,
  "text": "You?"
 },
 {
  "i": 123,
  "start": 213.418,
  "end": 214.818,
  "text": "You keep feeding the jar."
 },
 {
  "i": 124,
  "start": 215.16,
  "end": 216.633,
  "text": "Because when prices fall..."
 },
 {
  "i": 125,
  "start": 217.217,
  "end": 218.499,
  "text": "your dollar buys more."
 },
 {
  "i": 126,
  "start": 218.847,
  "end": 219.721,
  "text": "Months later..."
 },
 {
  "i": 127,
  "start": 220.312,
  "end": 222.009,
  "text": "the market starts climbing back."
 },
 {
  "i": 128,
  "start": 222.354,
  "end": 223.712,
  "text": "Max sold near the bottom."
 },
 {
  "i": 129,
  "start": 224.065,
  "end": 225.518,
  "text": "He missed the whole recovery."
 },
 {
  "i": 130,
  "start": 225.875,
  "end": 226.564,
  "text": "The catch?"
 },
 {
  "i": 131,
  "start": 227.049,
  "end": 228.306,
  "text": "Crashes bring sharks."
 },
 {
  "i": 132,
  "start": 228.663,
  "end": 230.658,
  "text": "A stranger online named Mr."
 },
 {
  "i": 133,
  "start": 230.694,
  "end": 232.788,
  "text": "Black slides into your messages."
 },
 {
  "i": 134,
  "start": 233.158,
  "end": 234.75,
  "text": "Guaranteed twenty percent."
 },
 {
  "i": 135,
  "start": 235.113,
  "end": 235.928,
  "text": "Every month."
 },
 {
  "i": 136,
  "start": 236.284,
  "end": 237.164,
  "text": "Zero risk."
 },
 {
  "i": 137,
  "start": 237.524,
  "end": 238.443,
  "text": "You do the math."
 },
 {
  "i": 138,
  "start": 238.788,
  "end": 243.27,
  "text": "Twenty percent a month turns one dollar into almost nine in a single year."
 },
 {
  "i": 139,
  "start": 243.618,
  "end": 244.663,
  "text": "Nobody does that."
 },
 {
  "i": 140,
  "start": 245.011,
  "end": 246.138,
  "text": "Nobody honest."
 },
 {
  "i": 141,
  "start": 246.508,
  "end": 247.363,
  "text": "You block him."
 },
 {
  "i": 142,
  "start": 247.706,
  "end": 252.082,
  "text": "Real rule: if someone guarantees huge returns with no risk..."
 },
 {
  "i": 143,
  "start": 252.672,
  "end": 254.225,
  "text": "it's almost always a scam."
 },
 {
  "i": 144,
  "start": 254.573,
  "end": 255.446,
  "text": "Year twenty."
 },
 {
  "i": 145,
  "start": 255.81,
  "end": 257.411,
  "text": "Twenty-one thousand dollars."
 },
 {
  "i": 146,
  "start": 257.772,
  "end": 260.395,
  "text": "You've only put in seven thousand three hundred."
 },
 {
  "i": 147,
  "start": 260.752,
  "end": 261.445,
  "text": "The rest?"
 },
 {
  "i": 148,
  "start": 261.929,
  "end": 262.761,
  "text": "Pure growth."
 },
 {
  "i": 149,
  "start": 263.123,
  "end": 264.164,
  "text": "Year twenty-five."
 },
 {
  "i": 150,
  "start": 264.546,
  "end": 266.048,
  "text": "About thirty-six thousand."
 },
 {
  "i": 151,
  "start": 266.414,
  "end": 271.008,
  "text": "Now, in one good year, your money can earn around three thousand six hundred."
 },
 {
  "i": 152,
  "start": 271.368,
  "end": 272.992,
  "text": "That's ten years of your dollars..."
 },
 {
  "i": 153,
  "start": 273.58,
  "end": 274.615,
  "text": "in twelve months."
 },
 {
  "i": 154,
  "start": 274.972,
  "end": 276.421,
  "text": "Max squints at your screen."
 },
 {
  "i": 155,
  "start": 276.773,
  "end": 277.282,
  "text": "Wait."
 },
 {
  "i": 156,
  "start": 277.646,
  "end": 279.034,
  "text": "It's doing your job now?"
 },
 {
  "i": 157,
  "start": 279.506,
  "end": 280.0,
  "text": "Yeah."
 },
 {
  "i": 158,
  "start": 280.363,
  "end": 281.325,
  "text": "It kind of is."
 },
 {
  "i": 159,
  "start": 281.666,
  "end": 283.391,
  "text": "But where it gets really crazy..."
 },
 {
  "i": 160,
  "start": 283.976,
  "end": 285.288,
  "text": "is the end of the plan."
 },
 {
  "i": 161,
  "start": 285.633,
  "end": 286.505,
  "text": "Year thirty."
 },
 {
  "i": 162,
  "start": 286.869,
  "end": 288.296,
  "text": "About sixty thousand."
 },
 {
  "i": 163,
  "start": 288.668,
  "end": 289.521,
  "text": "Year forty?"
 },
 {
  "i": 164,
  "start": 290.011,
  "end": 291.89,
  "text": "About one hundred sixty thousand."
 },
 {
  "i": 165,
  "start": 292.253,
  "end": 294.122,
  "text": "The last ten years make more money..."
 },
 {
  "i": 166,
  "start": 294.706,
  "end": 296.356,
  "text": "than the first thirty combined."
 },
 {
  "i": 167,
  "start": 296.716,
  "end": 297.764,
  "text": "That's compounding."
 },
 {
  "i": 168,
  "start": 298.14,
  "end": 298.723,
  "text": "Slow."
 },
 {
  "i": 169,
  "start": 299.094,
  "end": 299.828,
  "text": "And slow."
 },
 {
  "i": 170,
  "start": 300.184,
  "end": 300.918,
  "text": "And slow."
 },
 {
  "i": 171,
  "start": 301.274,
  "end": 301.964,
  "text": "And then..."
 },
 {
  "i": 172,
  "start": 302.551,
  "end": 303.421,
  "text": "suddenly not."
 },
 {
  "i": 173,
  "start": 303.768,
  "end": 306.338,
  "text": "And if it were ten dollars a day instead of one?"
 },
 {
  "i": 174,
  "start": 306.809,
  "end": 308.348,
  "text": "Over one point six million."
 },
 {
  "i": 175,
  "start": 308.707,
  "end": 310.722,
  "text": "And there's a price nobody mentions."
 },
 {
  "i": 176,
  "start": 311.084,
  "end": 311.863,
  "text": "It's boring."
 },
 {
  "i": 177,
  "start": 312.222,
  "end": 313.131,
  "text": "For decades."
 },
 {
  "i": 178,
  "start": 313.503,
  "end": 315.447,
  "text": "Friends buy a new phone every year."
 },
 {
  "i": 179,
  "start": 315.792,
  "end": 317.039,
  "text": "You keep the old one..."
 },
 {
  "i": 180,
  "start": 317.617,
  "end": 318.212,
  "text": "again."
 },
 {
  "i": 181,
  "start": 318.584,
  "end": 319.883,
  "text": "People call you cheap."
 },
 {
  "i": 182,
  "start": 320.235,
  "end": 322.028,
  "text": "And your brain fights you every day."
 },
 {
  "i": 183,
  "start": 322.367,
  "end": 324.78,
  "text": "Humans are wired to grab rewards now."
 },
 {
  "i": 184,
  "start": 325.126,
  "end": 326.698,
  "text": "A dollar today feels real."
 },
 {
  "i": 185,
  "start": 327.046,
  "end": 329.686,
  "text": "A dollar in forty years feels like a rumor."
 },
 {
  "i": 186,
  "start": 330.039,
  "end": 331.319,
  "text": "And there's another catch."
 },
 {
  "i": 187,
  "start": 331.666,
  "end": 332.475,
  "text": "Inflation."
 },
 {
  "i": 188,
  "start": 332.865,
  "end": 338.3,
  "text": "US prices have risen around three percent a year on average over the long run."
 },
 {
  "i": 189,
  "start": 338.648,
  "end": 341.81,
  "text": "At that pace, prices roughly triple in forty years."
 },
 {
  "i": 190,
  "start": 342.163,
  "end": 344.042,
  "text": "So your one hundred sixty thousand?"
 },
 {
  "i": 191,
  "start": 344.532,
  "end": 345.623,
  "text": "In today's money..."
 },
 {
  "i": 192,
  "start": 346.212,
  "end": 348.14,
  "text": "it buys closer to fifty thousand."
 },
 {
  "i": 193,
  "start": 348.504,
  "end": 349.3,
  "text": "Still big."
 },
 {
  "i": 194,
  "start": 349.65,
  "end": 350.253,
  "text": "Just..."
 },
 {
  "i": 195,
  "start": 350.856,
  "end": 352.045,
  "text": "smaller than it looks."
 },
 {
  "i": 196,
  "start": 352.394,
  "end": 353.398,
  "text": "Through all of it..."
 },
 {
  "i": 197,
  "start": 353.971,
  "end": 354.972,
  "text": "there's your mom."
 },
 {
  "i": 198,
  "start": 355.315,
  "end": 356.65,
  "text": "Every Sunday, you visit."
 },
 {
  "i": 199,
  "start": 357.0,
  "end": 359.449,
  "text": "Every Sunday, she asks the same question."
 },
 {
  "i": 200,
  "start": 359.813,
  "end": 361.123,
  "text": "Still feeding the jar?"
 },
 {
  "i": 201,
  "start": 361.597,
  "end": 362.935,
  "text": "Still feeding the jar."
 },
 {
  "i": 202,
  "start": 363.279,
  "end": 365.713,
  "text": "The old glass jar sits on your shelf now."
 },
 {
  "i": 203,
  "start": 366.056,
  "end": 367.31,
  "text": "Taped to it is her note."
 },
 {
  "i": 204,
  "start": 367.653,
  "end": 368.407,
  "text": "'One a day."
 },
 {
  "i": 205,
  "start": 368.752,
  "end": 369.407,
  "text": "Don't touch.'"
 },
 {
  "i": 206,
  "start": 369.438,
  "end": 371.09,
  "text": "There's writing on the back too."
 },
 {
  "i": 207,
  "start": 371.431,
  "end": 372.617,
  "text": "You've never read it."
 },
 {
  "i": 208,
  "start": 372.955,
  "end": 374.526,
  "text": "Her handwriting is terrible."
 },
 {
  "i": 209,
  "start": 374.889,
  "end": 375.859,
  "text": "And honestly..."
 },
 {
  "i": 210,
  "start": 376.468,
  "end": 378.185,
  "text": "you're scared it says something sad."
 },
 {
  "i": 211,
  "start": 378.524,
  "end": 380.783,
  "text": "Your mom worked thirty years in a factory."
 },
 {
  "i": 212,
  "start": 381.139,
  "end": 383.302,
  "text": "She never invested a single dollar."
 },
 {
  "i": 213,
  "start": 383.66,
  "end": 385.488,
  "text": "That's why I'm telling you, she says."
 },
 {
  "i": 214,
  "start": 385.831,
  "end": 387.245,
  "text": "So you don't end up like me."
 },
 {
  "i": 215,
  "start": 387.581,
  "end": 388.835,
  "text": "Max still teases you."
 },
 {
  "i": 216,
  "start": 389.179,
  "end": 389.761,
  "text": "Dude."
 },
 {
  "i": 217,
  "start": 390.132,
  "end": 391.989,
  "text": "You're the richest broke guy I know."
 },
 {
  "i": 218,
  "start": 392.333,
  "end": 393.363,
  "text": "Year thirty-three."
 },
 {
  "i": 219,
  "start": 393.746,
  "end": 394.751,
  "text": "Three in the morning."
 },
 {
  "i": 220,
  "start": 395.103,
  "end": 396.273,
  "text": "Your phone buzzes."
 },
 {
  "i": 221,
  "start": 396.632,
  "end": 397.219,
  "text": "Sam..."
 },
 {
  "i": 222,
  "start": 397.82,
  "end": 398.583,
  "text": "they took it."
 },
 {
  "i": 223,
  "start": 398.922,
  "end": 400.155,
  "text": "A man called your mom."
 },
 {
  "i": 224,
  "start": 400.496,
  "end": 402.153,
  "text": "He said he was from her bank."
 },
 {
  "i": 225,
  "start": 402.499,
  "end": 404.028,
  "text": "He said her account was hacked."
 },
 {
  "i": 226,
  "start": 404.378,
  "end": 406.816,
  "text": "He said to move everything into a 'safe account'."
 },
 {
  "i": 227,
  "start": 407.173,
  "end": 407.926,
  "text": "Right now."
 },
 {
  "i": 228,
  "start": 408.275,
  "end": 409.556,
  "text": "Before the hackers did."
 },
 {
  "i": 229,
  "start": 409.899,
  "end": 410.794,
  "text": "So she did."
 },
 {
  "i": 230,
  "start": 411.144,
  "end": 412.669,
  "text": "Fifteen thousand dollars."
 },
 {
  "i": 231,
  "start": 413.032,
  "end": 414.376,
  "text": "Her whole life savings."
 },
 {
  "i": 232,
  "start": 414.736,
  "end": 416.013,
  "text": "Gone in one phone call."
 },
 {
  "i": 233,
  "start": 416.358,
  "end": 417.718,
  "text": "I'm so stupid, Sam."
 },
 {
  "i": 234,
  "start": 418.066,
  "end": 419.383,
  "text": "You're not stupid, Mom."
 },
 {
  "i": 235,
  "start": 419.726,
  "end": 420.997,
  "text": "They do this for a living."
 },
 {
  "i": 236,
  "start": 421.345,
  "end": 423.959,
  "text": "Scammers make everything urgent on purpose..."
 },
 {
  "i": 237,
  "start": 424.558,
  "end": 425.929,
  "text": "so you don't stop to think."
 },
 {
  "i": 238,
  "start": 426.276,
  "end": 429.593,
  "text": "And the payment on her little house is due in nine days."
 },
 {
  "i": 239,
  "start": 429.94,
  "end": 430.655,
  "text": "Miss it..."
 },
 {
  "i": 240,
  "start": 431.237,
  "end": 434.342,
  "text": "and she could lose the place she's lived in for forty years."
 },
 {
  "i": 241,
  "start": 434.69,
  "end": 435.76,
  "text": "You open the app."
 },
 {
  "i": 242,
  "start": 436.104,
  "end": 437.678,
  "text": "Eighty-one thousand dollars."
 },
 {
  "i": 243,
  "start": 438.039,
  "end": 439.701,
  "text": "The rule echoes in your head."
 },
 {
  "i": 244,
  "start": 440.048,
  "end": 441.514,
  "text": "Every dollar you pull out..."
 },
 {
  "i": 245,
  "start": 442.093,
  "end": 443.069,
  "text": "stops growing."
 },
 {
  "i": 246,
  "start": 443.437,
  "end": 444.05,
  "text": "Forever."
 },
 {
  "i": 247,
  "start": 444.423,
  "end": 445.342,
  "text": "You do the math."
 },
 {
  "i": 248,
  "start": 445.687,
  "end": 447.282,
  "text": "Pull fifteen thousand now..."
 },
 {
  "i": 249,
  "start": 447.864,
  "end": 450.967,
  "text": "and in seven years, that money would have nearly doubled."
 },
 {
  "i": 250,
  "start": 451.324,
  "end": 453.092,
  "text": "Almost thirty thousand dollars."
 },
 {
  "i": 251,
  "start": 453.452,
  "end": 454.319,
  "text": "Gone for good."
 },
 {
  "i": 252,
  "start": 454.667,
  "end": 456.063,
  "text": "Max stares at the screen."
 },
 {
  "i": 253,
  "start": 456.416,
  "end": 456.999,
  "text": "Dude."
 },
 {
  "i": 254,
  "start": 457.369,
  "end": 458.615,
  "text": "That's your retirement."
 },
 {
  "i": 255,
  "start": 458.985,
  "end": 460.115,
  "text": "You look at the jar."
 },
 {
  "i": 256,
  "start": 460.456,
  "end": 461.567,
  "text": "Thirty-three years."
 },
 {
  "i": 257,
  "start": 461.921,
  "end": 462.818,
  "text": "Never touched."
 },
 {
  "i": 258,
  "start": 463.183,
  "end": 464.253,
  "text": "Not in the crash."
 },
 {
  "i": 259,
  "start": 464.605,
  "end": 465.672,
  "text": "Not for the phone."
 },
 {
  "i": 260,
  "start": 466.022,
  "end": 467.117,
  "text": "Not for the car."
 },
 {
  "i": 261,
  "start": 467.463,
  "end": 468.251,
  "text": "Not once."
 },
 {
  "i": 262,
  "start": 468.61,
  "end": 469.351,
  "text": "Your number..."
 },
 {
  "i": 263,
  "start": 469.942,
  "end": 470.806,
  "text": "or your mom."
 },
 {
  "i": 264,
  "start": 471.152,
  "end": 472.41,
  "text": "You reach for the jar."
 },
 {
  "i": 265,
  "start": 472.752,
  "end": 474.544,
  "text": "Your hand knocks the note loose."
 },
 {
  "i": 266,
  "start": 474.894,
  "end": 475.871,
  "text": "It flips over."
 },
 {
  "i": 267,
  "start": 476.223,
  "end": 477.454,
  "text": "And for the first time..."
 },
 {
  "i": 268,
  "start": 478.033,
  "end": 479.068,
  "text": "you read the back."
 },
 {
  "i": 269,
  "start": 479.413,
  "end": 481.312,
  "text": "'Unless it's for someone you love.'"
 },
 {
  "i": 270,
  "start": 481.342,
  "end": 481.909,
  "text": "You laugh."
 },
 {
  "i": 271,
  "start": 482.259,
  "end": 483.468,
  "text": "Then you cry a little."
 },
 {
  "i": 272,
  "start": 483.82,
  "end": 485.121,
  "text": "Then you press withdraw."
 },
 {
  "i": 273,
  "start": 485.481,
  "end": 487.007,
  "text": "Fifteen thousand dollars."
 },
 {
  "i": 274,
  "start": 487.37,
  "end": 488.445,
  "text": "Out of your account."
 },
 {
  "i": 275,
  "start": 488.801,
  "end": 489.656,
  "text": "Into hers."
 },
 {
  "i": 276,
  "start": 490.014,
  "end": 491.309,
  "text": "Your mom calls back."
 },
 {
  "i": 277,
  "start": 491.659,
  "end": 493.46,
  "text": "Her voice isn't shaking anymore."
 },
 {
  "i": 278,
  "start": 493.818,
  "end": 495.239,
  "text": "Then you do the second thing."
 },
 {
  "i": 279,
  "start": 495.584,
  "end": 497.248,
  "text": "You still have the scammer's number."
 },
 {
  "i": 280,
  "start": 497.596,
  "end": 499.048,
  "text": "You call her real bank."
 },
 {
  "i": 281,
  "start": 499.396,
  "end": 500.885,
  "text": "You file a police report."
 },
 {
  "i": 282,
  "start": 501.241,
  "end": 503.367,
  "text": "You warn every neighbor on her street."
 },
 {
  "i": 283,
  "start": 503.72,
  "end": 507.384,
  "text": "Because real banks never ask you to move money to a 'safe account'."
 },
 {
  "i": 284,
  "start": 507.745,
  "end": 508.215,
  "text": "Ever."
 },
 {
  "i": 285,
  "start": 508.576,
  "end": 511.082,
  "text": "Two weeks later, the same crew calls her neighbor."
 },
 {
  "i": 286,
  "start": 511.439,
  "end": 512.319,
  "text": "She hangs up."
 },
 {
  "i": 287,
  "start": 512.66,
  "end": 514.04,
  "text": "Then she calls the police."
 },
 {
  "i": 288,
  "start": 514.392,
  "end": 515.274,
  "text": "Years pass."
 },
 {
  "i": 289,
  "start": 515.631,
  "end": 518.443,
  "text": "At sixty-five, you check the app one last time."
 },
 {
  "i": 290,
  "start": 518.791,
  "end": 520.563,
  "text": "Not one hundred sixty thousand."
 },
 {
  "i": 291,
  "start": 520.927,
  "end": 522.396,
  "text": "About one hundred thirty."
 },
 {
  "i": 292,
  "start": 522.753,
  "end": 523.816,
  "text": "Less than the plan."
 },
 {
  "i": 293,
  "start": 524.161,
  "end": 525.103,
  "text": "More than enough."
 },
 {
  "i": 294,
  "start": 525.457,
  "end": 527.044,
  "text": "Your mom is ninety now."
 },
 {
  "i": 295,
  "start": 527.391,
  "end": 528.881,
  "text": "She raises a cup of tea."
 },
 {
  "i": 296,
  "start": 529.224,
  "end": 530.487,
  "text": "One a day, she says."
 },
 {
  "i": 297,
  "start": 530.835,
  "end": 531.6,
  "text": "Don't touch."
 },
 {
  "i": 298,
  "start": 531.954,
  "end": 532.712,
  "text": "You smile."
 },
 {
  "i": 299,
  "start": 533.071,
  "end": 534.725,
  "text": "Unless it's for someone you love."
 },
 {
  "i": 300,
  "start": 535.069,
  "end": 540.299,
  "text": "Across the table, Max hands his granddaughter Mia a glass jar with one dollar inside."
 },
 {
  "i": 301,
  "start": 540.656,
  "end": 542.305,
  "text": "And all those boring years..."
 },
 {
  "i": 302,
  "start": 542.893,
  "end": 544.123,
  "text": "finally feel worth it."
 },
 {
  "i": 303,
  "start": 544.462,
  "end": 545.03,
  "text": "So..."
 },
 {
  "i": 304,
  "start": 545.629,
  "end": 546.817,
  "text": "is any of this real?"
 },
 {
  "i": 305,
  "start": 547.294,
  "end": 548.322,
  "text": "Mostly, yes."
 },
 {
  "i": 306,
  "start": 548.677,
  "end": 560.154,
  "text": "The S&P 500, a measure of five hundred big US companies, has averaged roughly ten percent a year over the long run, with dividends reinvested."
 },
 {
  "i": 307,
  "start": 560.539,
  "end": 562.527,
  "text": "But that's an average, not a promise."
 },
 {
  "i": 308,
  "start": 562.883,
  "end": 567.343,
  "text": "In 2008, it fell about thirty-seven percent in a single year."
 },
 {
  "i": 309,
  "start": 567.692,
  "end": 570.892,
  "text": "And past returns never guarantee future ones."
 },
 {
  "i": 310,
  "start": 571.246,
  "end": 577.789,
  "text": "The first index fund for everyday investors launched in 1976, started by John Bogle."
 },
 {
  "i": 311,
  "start": 578.146,
  "end": 579.288,
  "text": "Fees matter too."
 },
 {
  "i": 312,
  "start": 579.636,
  "end": 582.482,
  "text": "Lose just one extra percent a year to fees..."
 },
 {
  "i": 313,
  "start": 583.07,
  "end": 588.073,
  "text": "and your one hundred sixty thousand shrinks to about one hundred twenty-three thousand."
 },
 {
  "i": 314,
  "start": 588.437,
  "end": 590.188,
  "text": "This isn't financial advice."
 },
 {
  "i": 315,
  "start": 590.548,
  "end": 591.481,
  "text": "It's just math."
 },
 {
  "i": 316,
  "start": 591.829,
  "end": 594.871,
  "text": "So if time is the most powerful force in investing..."
 },
 {
  "i": 317,
  "start": 595.475,
  "end": 597.935,
  "text": "what does waiting one more year really cost you?"
 },
 {
  "i": 318,
  "start": 598.406,
  "end": 600.237,
  "text": "That night, your phone rings again."
 },
 {
  "i": 319,
  "start": 600.585,
  "end": 601.49,
  "text": "Unknown number."
 },
 {
  "i": 320,
  "start": 601.848,
  "end": 602.622,
  "text": "You pick up."
 },
 {
  "i": 321,
  "start": 602.962,
  "end": 603.634,
  "text": "Silence."
 },
 {
  "i": 322,
  "start": 604.012,
  "end": 605.66,
  "text": "Then a calm voice says your name."
 },
 {
  "i": 323,
  "start": 606.002,
  "end": 606.544,
  "text": "Sam."
 },
 {
  "i": 324,
  "start": 606.912,
  "end": 608.912,
  "text": "You cost my team a lot of money."
 },
 {
  "i": 325,
  "start": 609.264,
  "end": 609.904,
  "text": "It's Mr."
 },
 {
  "i": 326,
  "start": 609.934,
  "end": 610.287,
  "text": "Black."
 },
 {
  "i": 327,
  "start": 610.637,
  "end": 611.544,
  "text": "What do you think?"
 },
 {
  "i": 328,
  "start": 612.02,
  "end": 616.129,
  "text": "Tell us in the comments, and tell us which money What If we should do next."
 },
 {
  "i": 329,
  "start": 616.474,
  "end": 618.443,
  "text": "And if that note on the jar got you..."
 },
 {
  "i": 330,
  "start": 619.02,
  "end": 621.143,
  "text": "hit like, and subscribe for Part Two."
 }
]